{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fichas-tecnicas/(.*).pdf",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }]
    }
  ],
  "redirects": [
    { "source": "/catalago", "destination": "/catalogo", "permanent": true },
    { "source": "/video-laringoscopio", "destination": "/productos/videolaringoscopio", "permanent": true },
    { "source": "/bomba-de-nutricion-enteral", "destination": "/productos/bomba-nutricion-enteral", "permanent": true },
    { "source": "/trocar-retractil-de-un-solo-uso", "destination": "/productos/trocares-desechables", "permanent": true },
    { "source": "/contenedores-de-seguridad", "destination": "/catalogo/bioseguridad", "permanent": true },
    { "source": "/bolsa-de-aspiracion", "destination": "/productos/bolsas-aspiracion", "permanent": true },
    { "source": "/aplicador-esteril-desechable", "destination": "/productos/aplicador-clorhexidina-2", "permanent": true },
    { "source": "/bolsa-de-nutricion", "destination": "/productos/bolsa-nutricion-enteral", "permanent": true },
    { "source": "/pano-clinico-y-toalla-de-un-solo-uso", "destination": "/productos/pano-clinico-qmedical", "permanent": true },
    { "source": "/lapiz-marcador-de-piel-y-limpiador-de-punta", "destination": "/productos/marcador-piel-esteril", "permanent": true },
    { "source": "/guantes-de-nitrilo", "destination": "/productos/guantes-nitrilo", "permanent": true },
    { "source": "/tubuladora-de-silicona-de-un-solo-uso", "destination": "/productos/tubuladura-silicona", "permanent": true },
    { "source": "/cepillo-para-limpieza-de-instrumental-medico", "destination": "/productos/cepillos-limpieza-instrumental", "permanent": true },
    { "source": "/iluminador-de-venas", "destination": "/catalogo", "permanent": true },
    { "source": "/bomba-de-infusion", "destination": "/catalogo", "permanent": true }
  ]
}

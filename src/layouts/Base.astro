---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Preloader from '../components/Preloader.astro';
import { site } from '../data/site';
import {
  alternas as alternasDe,
  ETIQUETA_HREF,
  ETIQUETA_HTML,
  ETIQUETA_OG,
  IDIOMAS,
  type Clave,
  type Idioma,
} from '../i18n/rutas';
import { textos } from '../i18n/textos';
import { empresaEn } from '../i18n/contenido';

interface Props {
  lang?: Idioma;
  /** Qué página es. De aquí salen las alternativas hreflang y el botón de idioma. */
  clave?: Clave;
  /** Identificador de la línea o del producto, cuando la página lo lleva. */
  slug?: string;
  title: string;
  description: string;
  image?: string;
  /** El preloader completo solo se muestra en la portada. */
  preloader?: boolean;
  /** Cabecera sobre fondo oscuro: el logotipo y la navegación se invierten. */
  cabeceraClara?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  lang = 'es',
  clave = 'inicio',
  slug,
  title,
  description,
  image = '/img/fotos/almacen-p1360310-1600.webp',
  preloader = false,
  cabeceraClara = false,
  schema,
} = Astro.props;

const t = textos(lang);

/* Las dos direcciones de esta misma página: alimentan a la vez el botón de
   idioma de la cabecera y las etiquetas hreflang. Una sola fuente, de modo
   que el conmutador y lo que se le declara al buscador nunca discrepen. */
const gemelas = alternasDe(clave, slug);
const base = Astro.site ?? new URL(site.url);
const enlacesIdioma = IDIOMAS.map((i) => ({
  hreflang: ETIQUETA_HREF[i],
  href: new URL(gemelas[i], base).href.replace(/(.)\/$/, '$1'),
}));

const canonical = new URL(Astro.url.pathname, base).href.replace(/(.)\/$/, '$1');
const socialImage = new URL(image, Astro.site ?? site.url).href;
const titleFull = title.includes(site.nombreCorto) ? title : `${title} | ${site.nombre}`;

const organizacion = {
  '@context': 'https://schema.org',
  '@type': 'MedicalBusiness',
  '@id': site.url + '/#organizacion',
  name: site.nombre,
  alternateName: 'Q-MEDICAL',
  url: site.url,
  logo: site.url + '/img/logo/qmedical-azul.png',
  description: lang === 'en' ? empresaEn.descripcion : site.descripcion,
  foundingDate: String(site.fundacion),
  telephone: site.telefonos.map((t) => t.etiqueta),
  email: site.correoPrincipal,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.direccion.calle,
    // El país sí se traduce; la calle es un dato postal y no.
    addressLocality: site.direccion.distrito,
    addressRegion: site.direccion.ciudad,
    addressCountry: 'PE',
  },
  areaServed: { '@type': 'Country', name: lang === 'en' ? 'Peru' : 'Perú' },
  inLanguage: ETIQUETA_HTML[lang],
  sameAs: [
    'https://www.instagram.com/qmedicalperu/',
    'https://www.facebook.com/Drogueria.QMedicalsac',
    'https://www.linkedin.com/company/q-medical-s-a-c/',
    'https://www.youtube.com/channel/UCFh2U0cEywVbI2dtXEfIbtw',
  ],
};
const schemas = [organizacion, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
---

<!doctype html>
<html lang={ETIQUETA_HTML[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titleFull}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {enlacesIdioma.map((e) => (
      <link rel="alternate" hreflang={e.hreflang} href={e.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={enlacesIdioma[0].href} />
    <meta name="theme-color" content="#152e7f" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content={site.nombre} />
    <meta name="generator" content={Astro.generator} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.nombre} />
    <meta property="og:locale" content={ETIQUETA_OG[lang]} />
    <meta property="og:title" content={titleFull} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titleFull} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Literata:opsz,wght@7..72,400..600&display=swap"
    />

    <script is:inline define:vars={{ preloader }}>
      // Marca el documento antes del primer pintado, para evitar destellos.
      (function () {
        var h = document.documentElement;
        h.classList.add('js');
        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var visto = false;
        try { visto = sessionStorage.getItem('qm-visto') === '1'; } catch (e) {}
        if (preloader && !reduce && !visto) h.classList.add('is-loading');
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(schemas)} />
  </head>

  <body class:list={[cabeceraClara && 'cabecera-superpuesta']}>
    {preloader && <Preloader lang={lang} />}

    <a href="#contenido" class="salto">{lang === 'en' ? 'Skip to content' : 'Ir al contenido'}</a>

    <Header lang={lang} claro={cabeceraClara} alternas={gemelas} />

    <main id="contenido">
      <slot />
    </main>

    <Footer lang={lang} />

    <script>
      const raiz = document.documentElement;

      /* ── Cabecera superpuesta ────────────────────────────────────────
         Se mide con la cabecera desplegada, antes de que se compacte, y
         el valor no se vuelve a tocar: así el hero no da un salto.      */
      if (document.body.classList.contains('cabecera-superpuesta')) {
        const cab = document.getElementById('cabecera');
        if (cab) {
          const medir = () =>
            document.body.style.setProperty('--alto-cabecera', `${cab.offsetHeight}px`);
          if (window.scrollY < 4) medir();
          window.addEventListener('resize', () => {
            if (window.scrollY < 4) medir();
          }, { passive: true });
        }
      }

      /* ── Preloader ───────────────────────────────────────────────────── */
      if (raiz.classList.contains('is-loading')) {
        const cerrar = () => {
          if (!raiz.classList.contains('is-loading')) return;
          raiz.classList.remove('is-loading');
          raiz.classList.add('is-loaded');
          try { sessionStorage.setItem('qm-visto', '1'); } catch (e) {}
        };
        const minimo = new Promise((r) => setTimeout(r, 900));
        const carga = new Promise((r) =>
          document.readyState === 'complete'
            ? r(undefined)
            : window.addEventListener('load', () => r(undefined), { once: true })
        );
        Promise.all([minimo, carga]).then(cerrar);
        setTimeout(cerrar, 4000); // nunca deja la página bloqueada
      }

      const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      /* ── Trazado de iconos ──────────────────────────────────────────
         Cada forma se prepara con su propia longitud, medida en el
         navegador, y se dibuja cuando su sección entra en pantalla. Al
         terminar se retira el guionado: el icono queda sólido y limpio.  */
      type Trazo = SVGGeometryElement & { style: CSSStyleDeclaration };
      const formas = 'path, circle, rect, line, polyline, polygon';

      const prepararIcono = (svg: Element) => {
        svg.querySelectorAll<Trazo>(formas).forEach((el) => {
          if (typeof el.getTotalLength !== 'function') return;
          let largo = 0;
          try { largo = el.getTotalLength(); } catch { return; }
          if (!largo) return;
          el.dataset.largo = String(largo);
          el.style.strokeDasharray = `${largo}`;
          el.style.strokeDashoffset = `${largo}`;
        });
      };

      const dibujarIcono = (svg: Element) => {
        svg.querySelectorAll<Trazo>(formas).forEach((el, i) => {
          const largo = Number(el.dataset.largo ?? 0);
          if (!largo) return;
          el.style.transition = `stroke-dashoffset 0.85s var(--ease-editorial) ${i * 90}ms`;
          el.style.strokeDashoffset = '0';
          // Al acabar se quita el guionado, para que no queden puntos.
          window.setTimeout(() => {
            el.style.transition = '';
            el.style.strokeDasharray = '';
            el.style.strokeDashoffset = '';
          }, 900 + i * 90);
        });
      };

      const iconos = Array.from(document.querySelectorAll('.ico-trazo'));
      if (iconos.length && !quieto) iconos.forEach(prepararIcono);

      /* ── Entradas al entrar en pantalla ──────────────────────────────
         Un elemento con `data-anim-grupo` escalona a sus hijos con
         `data-anim`, así no hay que numerar retrasos a mano.            */
      const objetivos = document.querySelectorAll<HTMLElement>('[data-anim]');

      if (quieto) {
        objetivos.forEach((el) => el.classList.add('visible'));
      } else if (objetivos.length) {
        document.querySelectorAll<HTMLElement>('[data-anim-grupo]').forEach((grupo) => {
          const paso = Number(grupo.dataset.animGrupo) || 90;
          grupo.querySelectorAll<HTMLElement>('[data-anim]').forEach((hijo, i) => {
            if (!hijo.style.getPropertyValue('--retraso')) {
              hijo.style.setProperty('--retraso', `${i * paso}ms`);
            }
          });
        });

        const io = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('visible');
              e.target.querySelectorAll('.ico-trazo').forEach(dibujarIcono);
              if (e.target.classList.contains('ico-trazo')) dibujarIcono(e.target);
              io.unobserve(e.target);
            }
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.05 }
        );
        objetivos.forEach((el) => io.observe(el));
      }

      /* ── Conteo de cifras ────────────────────────────────────────────
         Un elemento con `data-conteo="2003"` cuenta hasta ese valor al
         entrar en pantalla. Respeta el formato original (separadores,
         sufijos) y se salta si se ha pedido menos movimiento.            */
      const cifras = document.querySelectorAll<HTMLElement>('[data-conteo]');

      if (cifras.length) {
        const pintarCifra = (el: HTMLElement, valor: number) => {
          const dec = Number(el.dataset.decimales ?? 0);
          el.textContent =
            (el.dataset.prefijo ?? '') +
            valor.toLocaleString('es-PE', {
              minimumFractionDigits: dec,
              maximumFractionDigits: dec,
              useGrouping: el.dataset.agrupar !== 'no',
            }) +
            (el.dataset.sufijo ?? '');
        };

        if (quieto) {
          cifras.forEach((el) => pintarCifra(el, Number(el.dataset.conteo)));
        } else {
          cifras.forEach((el) => pintarCifra(el, 0));
          const ioC = new IntersectionObserver(
            (entradas) => {
              for (const e of entradas) {
                if (!e.isIntersecting) continue;
                const el = e.target as HTMLElement;
                ioC.unobserve(el);
                const meta = Number(el.dataset.conteo);
                const dur = Number(el.dataset.duracion ?? 1600);
                const t0 = performance.now();
                const paso = (ahora: number) => {
                  const p = Math.min(1, (ahora - t0) / dur);
                  // Desaceleración: la cifra frena al acercarse al valor
                  const e2 = 1 - Math.pow(1 - p, 3);
                  pintarCifra(el, meta * e2);
                  if (p < 1) requestAnimationFrame(paso);
                  else pintarCifra(el, meta);
                };
                requestAnimationFrame(paso);
              }
            },
            { threshold: 0.4 }
          );
          cifras.forEach((el) => ioC.observe(el));
        }
      }

      /* ── Parallax ────────────────────────────────────────────────────
         `data-parallax="0.18"` desplaza el elemento esa fracción de su
         recorrido por la pantalla. Todo va en `--py`, que solo alimenta
         un `translate3d`: nunca toca el layout.                          */
      const capas = Array.from(document.querySelectorAll<HTMLElement>('[data-parallax]'));

      if (capas.length && !quieto) {
        let visibles: HTMLElement[] = [];
        const ioP = new IntersectionObserver(
          (entradas) => {
            for (const e of entradas) {
              const el = e.target as HTMLElement;
              if (e.isIntersecting) {
                if (!visibles.includes(el)) visibles.push(el);
              } else {
                visibles = visibles.filter((x) => x !== el);
              }
            }
          },
          { rootMargin: '20% 0px' }
        );
        capas.forEach((el) => ioP.observe(el));

        let pendiente = false;
        const pintar = () => {
          const alto = window.innerHeight;
          for (const el of visibles) {
            const r = el.getBoundingClientRect();
            const factor = Number(el.dataset.parallax) || 0.15;
            // -1 arriba del todo, +1 abajo del todo
            const centro = (r.top + r.height / 2 - alto / 2) / (alto / 2 + r.height / 2);
            el.style.setProperty('--py', `${(centro * factor * alto) / 2}px`);
          }
          pendiente = false;
        };
        const alScroll = () => {
          if (pendiente) return;
          pendiente = true;
          requestAnimationFrame(pintar);
        };
        window.addEventListener('scroll', alScroll, { passive: true });
        window.addEventListener('resize', alScroll, { passive: true });
        pintar();
      }
    </script>

    <style is:global>
      .salto {
        position: absolute;
        left: -9999px;
        top: 0;
        z-index: 300;
        padding: 0.85rem 1.4rem;
        background: var(--color-brand-700);
        color: #fff;
        font-size: 0.85rem;
        border-radius: 0 0 var(--r-sm) 0;
      }
      .salto:focus { left: 0; }
    </style>
  </body>
</html>

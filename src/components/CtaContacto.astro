---
import Icon from './Icon.astro';
import { site } from '../data/site';

interface Props {
  titulo?: string;
  texto?: string;
}
const {
  titulo = '¿Necesita una cotización para su institución?',
  texto = 'Atendemos requerimientos de hospitales, clínicas, laboratorios y ' +
    'procesos de licitación pública en todo el país. Cuéntenos qué necesita y ' +
    'nuestro equipo comercial le responderá con precios, disponibilidad y fichas técnicas.',
} = Astro.props;
---

<section class="relative overflow-hidden bg-brand-700 text-white">
  <div class="grid-bg absolute inset-0 opacity-[0.35]" aria-hidden="true"></div>
  <div
    class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-white/5 blur-2xl"
    aria-hidden="true"
  >
  </div>

  <div class="container-q relative py-16 lg:py-20">
    <div class="grid items-center gap-10 lg:grid-cols-12">
      <div class="lg:col-span-7 reveal">
        <p class="eyebrow eyebrow--light">Hablemos</p>
        <h2 class="title-lg mt-4">{titulo}</h2>
        <p class="prose-q mt-5 max-w-2xl !text-white/75">{texto}</p>
      </div>

      <div class="lg:col-span-5 reveal" data-delay="120">
        <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
          <a href="/contacto#cotizar" class="btn btn-light flex-1">
            Solicitar cotización
            <Icon name="arrow" size={16} />
          </a>
          <a href={site.whatsapp.href} target="_blank" rel="noopener" class="btn btn-ghost-light flex-1">
            <Icon name="whatsapp" size={17} />
            WhatsApp {site.whatsapp.numero}
          </a>
        </div>

        <dl class="mt-8 grid grid-cols-1 gap-4 text-[0.85rem] sm:grid-cols-2 lg:grid-cols-1">
          <div class="flex gap-3">
            <Icon name="mail" size={17} class="mt-0.5 shrink-0 text-white/45" />
            <div>
              <dt class="sr-only">Correo</dt>
              <dd>
                <a href={`mailto:${site.correoPrincipal}`} class="break-all text-white/85 underline-offset-4 hover:underline">
                  {site.correoPrincipal}
                </a>
              </dd>
            </div>
          </div>
          <div class="flex gap-3">
            <Icon name="phone" size={17} class="mt-0.5 shrink-0 text-white/45" />
            <div>
              <dt class="sr-only">Teléfonos</dt>
              <dd class="text-white/85">
                {site.telefonos.map((t) => t.etiqueta).join('  /  ')}
              </dd>
            </div>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
  }
</style>

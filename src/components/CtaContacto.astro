---
import Icon from './Icon.astro';
import { site, whatsapp, waMensajes } from '../data/site';
import { ruta, type Idioma } from '../i18n/rutas';
import { textos } from '../i18n/textos';
import { waMensajesEn } from '../i18n/contenido';

/**
 * Banda de cierre de página. Es deliberadamente más contenida que el cierre
 * del pie: aquí el mensaje es específico de lo que el visitante acaba de leer,
 * y el pie se reserva la llamada general.
 */
interface Props {
  lang?: Idioma;
  titulo?: string;
  texto?: string;
  waMensaje?: string;
}
const { lang = 'es', titulo, texto, waMensaje } = Astro.props;

const t = textos(lang);
const wa = lang === 'en' ? waMensajesEn : waMensajes;
const encabezado = titulo ?? t.cierre.titulo;
const bajada = texto ?? t.cierre.texto;
const mensaje = waMensaje ?? wa.cotizacion;
---

<section class="cierre">
  <div class="caja">
    <div class="cierre__cuerpo" data-anim-grupo="90">
      <div class="cierre__texto">
        <p class="ante ante-brand" data-anim="sube">{t.cierre.ante}</p>
        <h2 class="display-md mt-4" data-anim="sube">{encabezado}</h2>
        <p class="cuerpo mt-5 max-w-xl" data-anim="sube">{bajada}</p>
      </div>

      <div class="cierre__acciones" data-anim="sube">
        <a href={ruta(lang, 'contacto', undefined, 'cotizar')} class="pill pill-tinta">
          {t.cotizar}<Icon name="flecha" size={16} />
        </a>
        <a href={whatsapp(mensaje)} target="_blank" rel="noopener" class="pill pill-linea">
          <Icon name="whatsapp" size={17} />WhatsApp
        </a>
        <p class="cierre__nota">
          {t.cierre.oEscriba}
          <a href={`mailto:${site.correoPrincipal}`} class="underline underline-offset-4">
            {site.correoPrincipal}
          </a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .cierre {
    background: var(--color-papel-2);
    border-top: 1px solid var(--color-linea);
  }
  .cierre__cuerpo {
    display: grid;
    gap: 2.5rem;
    padding-block: 4rem;
  }
  @media (min-width: 1024px) {
    .cierre__cuerpo {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 4rem;
      padding-block: 5.5rem;
    }
  }
  .cierre__acciones { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
  .cierre__nota {
    width: 100%;
    font-size: 0.82rem;
    color: var(--color-tinta-45);
  }
</style>

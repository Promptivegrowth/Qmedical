---
import Icon from './Icon.astro';
import { site, whatsapp, waMensajes } from '../data/site';

/**
 * Banda de cierre de página. Es deliberadamente más contenida que el cierre
 * del pie: aquí el mensaje es específico de lo que el visitante acaba de leer,
 * y el pie se reserva la llamada general.
 */
interface Props {
  titulo?: string;
  texto?: string;
  waMensaje?: string;
}
const {
  titulo = '¿Necesita una cotización para su institución?',
  texto = 'Indíquenos productos, cantidades y fecha requerida. Le respondemos con precio, disponibilidad y la documentación técnica que pida su expediente.',
  waMensaje = waMensajes.cotizacion,
} = Astro.props;
---

<section class="cierre">
  <div class="caja">
    <div class="cierre__cuerpo" data-anim-grupo="90">
      <div class="cierre__texto">
        <p class="ante ante-brand" data-anim="sube">Siguiente paso</p>
        <h2 class="display-md mt-4" data-anim="sube">{titulo}</h2>
        <p class="cuerpo mt-5 max-w-xl" data-anim="sube">{texto}</p>
      </div>

      <div class="cierre__acciones" data-anim="sube">
        <a href="/contacto#cotizar" class="pill pill-tinta">
          Solicitar cotización<Icon name="flecha" size={16} />
        </a>
        <a href={whatsapp(waMensaje)} target="_blank" rel="noopener" class="pill pill-linea">
          <Icon name="whatsapp" size={17} />WhatsApp
        </a>
        <p class="cierre__nota">
          o escriba a
          <a href={`mailto:${site.correoPrincipal}`} class="underline underline-offset-4">
            {site.correoPrincipal}
          </a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .cierre {
    background: var(--color-papel-2);
    border-top: 1px solid var(--color-linea);
  }
  .cierre__cuerpo {
    display: grid;
    gap: 2.5rem;
    padding-block: 4rem;
  }
  @media (min-width: 1024px) {
    .cierre__cuerpo {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 4rem;
      padding-block: 5.5rem;
    }
  }
  .cierre__acciones { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; }
  .cierre__nota {
    width: 100%;
    font-size: 0.82rem;
    color: var(--color-tinta-45);
  }
</style>

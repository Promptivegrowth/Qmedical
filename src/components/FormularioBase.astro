---
/**
 * Envoltorio de formulario que funciona sin servidor propio, de modo que el
 * sitio se comporta igual en Vercel que en el hosting compartido de cPanel.
 *
 * · Si `site.formAccessKey` tiene valor, el formulario se envía a Web3Forms
 *   (servicio gratuito que reenvía el mensaje al correo de la empresa).
 * · Si no, el formulario abre el gestor de correo del visitante con todos los
 *   campos ya redactados. Nunca queda un botón que no hace nada.
 */
import { site } from '../data/site';

interface Props {
  id: string;
  asunto: string;
  /** Correo de destino del área correspondiente. */
  destino?: string;
  class?: string;
}
const { id, asunto, destino = site.correoPrincipal, class: klass = '' } = Astro.props;
const conServicio = Boolean(site.formAccessKey);
---

<form
  id={id}
  class={klass}
  method="POST"
  action={conServicio ? site.formEndpoint : undefined}
  data-form
  data-destino={destino}
  data-asunto={asunto}
  novalidate
>
  {conServicio && <input type="hidden" name="access_key" value={site.formAccessKey} />}
  <input type="hidden" name="subject" value={asunto} />
  <input type="hidden" name="from_name" value="Formulario web — Q-MEDICAL S.A.C." />
  <input type="hidden" name="redirect" value={`${site.url}/gracias`} />

  <!-- Trampa antispam: invisible para las personas, tentadora para los bots -->
  <input
    type="checkbox"
    name="botcheck"
    class="hidden"
    style="display:none"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  <slot />

  <p
    data-form-error
    class="mt-4 hidden rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-[0.85rem] text-red-700"
    role="alert"
  >
  </p>
</form>

<script>
  // Validación accesible + envío por correo cuando no hay servicio configurado.
  document.querySelectorAll<HTMLFormElement>('form[data-form]').forEach((form) => {
    const error = form.querySelector<HTMLElement>('[data-form-error]');

    const mostrarError = (msg: string) => {
      if (!error) return;
      error.textContent = msg;
      error.classList.remove('hidden');
      error.scrollIntoView({ block: 'center', behavior: 'smooth' });
    };

    form.addEventListener('submit', (ev) => {
      error?.classList.add('hidden');

      // Validación nativa con mensaje agrupado
      if (!form.checkValidity()) {
        ev.preventDefault();
        const primero = form.querySelector<HTMLInputElement>(':invalid');
        primero?.focus();
        mostrarError('Revise los campos marcados: falta información obligatoria.');
        return;
      }

      // Sin endpoint configurado: se compone un correo con todo el contenido.
      if (!form.getAttribute('action')) {
        ev.preventDefault();
        const datos = new FormData(form);
        const lineas: string[] = [];

        for (const [clave, valor] of datos.entries()) {
          if (['access_key', 'subject', 'from_name', 'redirect', 'botcheck'].includes(clave)) continue;
          if (typeof valor !== 'string' || !valor.trim()) continue;
          const campo = form.querySelector(`[name="${CSS.escape(clave)}"]`);
          const etiqueta =
            campo?.closest('label')?.querySelector('.label')?.textContent?.trim() ||
            form.querySelector(`label[for="${CSS.escape(campo?.id ?? '')}"]`)?.textContent?.trim() ||
            clave;
          lineas.push(`${etiqueta.replace(/\s+/g, ' ')}: ${valor}`);
        }

        const asunto = encodeURIComponent(form.dataset.asunto ?? 'Consulta desde la web');
        const cuerpo = encodeURIComponent(lineas.join('\n'));
        window.location.href = `mailto:${form.dataset.destino}?subject=${asunto}&body=${cuerpo}`;

        setTimeout(() => {
          mostrarError(
            'Se abrió su gestor de correo con el mensaje redactado. Si no ocurrió nada, ' +
              `escríbanos directamente a ${form.dataset.destino}.`
          );
        }, 1200);
      }
    });

    // Limpia el estado de error al corregir
    form.addEventListener('input', () => error?.classList.add('hidden'));
  });
</script>

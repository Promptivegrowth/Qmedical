---
/**
 * Envoltorio de formulario que funciona sin servidor propio, de modo que el
 * sitio se comporta igual en Vercel que en el hosting compartido de cPanel.
 *
 * · Si `site.formAccessKey` tiene valor, se envía a Web3Forms.
 * · Si no, abre el gestor de correo del visitante con todos los campos ya
 *   redactados. Nunca queda un botón que no hace nada.
 */
import { site } from '../data/site';
import { ruta, type Idioma } from '../i18n/rutas';

interface Props {
  lang?: Idioma;
  id: string;
  asunto: string;
  destino?: string;
  class?: string;
}
const { lang = 'es', id, asunto, destino = site.correoPrincipal, class: klass = '' } = Astro.props;
const conServicio = Boolean(site.formAccessKey);
---

<form
  id={id}
  class={klass}
  method="POST"
  action={conServicio ? site.formEndpoint : undefined}
  data-form
  data-destino={destino}
  data-asunto={asunto}
  data-lang={lang}
  novalidate
>
  {conServicio && <input type="hidden" name="access_key" value={site.formAccessKey} />}
  <input type="hidden" name="subject" value={asunto} />
  <input type="hidden" name="from_name" value="Formulario web — Q-MEDICAL S.A.C." />
  <input type="hidden" name="redirect" value={site.url + ruta(lang, 'gracias')} />
  <!-- El idioma viaja con el envio: quien responde sabe en que lengua escribir -->
  <input type="hidden" name="idioma" value={lang === 'en' ? 'English' : 'Espanol'} />

  <!-- Trampa antispam: invisible para las personas, tentadora para los bots -->
  <input type="checkbox" name="botcheck" class="hidden" style="display:none"
    tabindex="-1" autocomplete="off" aria-hidden="true" />

  <slot />

  <p data-form-error class="aviso-error hidden" role="alert"></p>
</form>

<style>
  .aviso-error {
    margin-top: 1rem;
    padding: 0.85rem 1.1rem;
    border: 1px solid #e4c4c4;
    border-radius: var(--r-sm);
    background: #fbf1f1;
    font-size: 0.86rem;
    color: #8c2f2f;
  }
</style>

<script>
  const AVISOS = {
    es: {
      faltan: 'Revise los campos marcados: falta información obligatoria.',
      asunto: 'Consulta desde la web',
      correoAbierto: (d: string) =>
        'Se abrió su gestor de correo con el mensaje redactado. Si no ocurrió ' +
        `nada, escríbanos directamente a ${d}.`,
      idioma: 'Idioma',
    },
    en: {
      faltan: 'Please check the highlighted fields: required information is missing.',
      asunto: 'Enquiry from the website',
      correoAbierto: (d: string) =>
        'Your email client should have opened with the message ready. If nothing ' +
        `happened, write to us directly at ${d}.`,
      idioma: 'Language',
    },
  };

  document.querySelectorAll<HTMLFormElement>('form[data-form]').forEach((form) => {
    const error = form.querySelector<HTMLElement>('[data-form-error]');
    const idioma = form.dataset.lang === 'en' ? 'en' : 'es';

    const mostrarError = (msg: string) => {
      if (!error) return;
      error.textContent = msg;
      error.classList.remove('hidden');
      error.scrollIntoView({ block: 'center', behavior: 'smooth' });
    };

    form.addEventListener('submit', (ev) => {
      error?.classList.add('hidden');

      if (!form.checkValidity()) {
        ev.preventDefault();
        form.querySelector<HTMLInputElement>(':invalid')?.focus();
        mostrarError(AVISOS[idioma].faltan);
        return;
      }

      // Sin endpoint configurado: se compone un correo con todo el contenido.
      if (!form.getAttribute('action')) {
        ev.preventDefault();
        const datos = new FormData(form);
        const lineas: string[] = [];

        for (const [clave, valor] of datos.entries()) {
          if (['access_key', 'subject', 'from_name', 'redirect', 'botcheck', 'idioma'].includes(clave)) continue;
          if (typeof valor !== 'string' || !valor.trim()) continue;
          const campo = form.querySelector(`[name="${CSS.escape(clave)}"]`);
          const etiqueta =
            campo?.closest('label')?.querySelector('.rotulo')?.textContent?.trim() ||
            form.querySelector(`label[for="${CSS.escape(campo?.id ?? '')}"]`)?.textContent?.trim() ||
            clave;
          lineas.push(`${etiqueta.replace(/\s+/g, ' ')}: ${valor}`);
        }

        const asunto = encodeURIComponent(form.dataset.asunto ?? 'Consulta desde la web');
        const cuerpo = encodeURIComponent(lineas.join('\n'));
        window.location.href = `mailto:${form.dataset.destino}?subject=${asunto}&body=${cuerpo}`;

        setTimeout(() => {
          mostrarError(AVISOS[idioma].correoAbierto(form.dataset.destino ?? ''));
        }, 1200);
      }
    });

    form.addEventListener('input', () => error?.classList.add('hidden'));
  });
</script>

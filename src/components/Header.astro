---
import Icon from './Icon.astro';
import { navegacion, site, whatsapp, waMensajes } from '../data/site';
import { categorias, productos, conteoProductos, imagenPrincipal } from '../data/catalogo';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const activo = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');

// Producto que se muestra como pieza destacada dentro del mega-menú.
const destacado = productos.find((p) => p.slug === 'videolaringoscopio') ?? productos[0];
---

<header id="site-header" class="site-header">
  <!-- ─────────────────────────── Barra superior: confianza y contacto directo -->
  <div class="topbar">
    <div class="container-q flex h-9 items-center justify-between gap-4 text-[0.76rem]">
      <p class="flex min-w-0 items-center gap-2 text-white/65">
        <Icon name="award" size={14} class="shrink-0 text-white/40" />
        <span class="hidden sm:inline truncate">
          <span class="hidden md:inline">Droguería certificada en </span>Buenas Prácticas de
          Almacenamiento — DIGEMID
        </span>
        <span class="sm:hidden truncate">Certificación BPA</span>
      </p>

      <div class="flex shrink-0 items-center gap-1">
        <a href={site.telefonos[0].href} class="topbar-link hidden lg:inline-flex">
          <Icon name="phone" size={13} />
          {site.telefonos[0].etiqueta}
        </a>
        <span class="hidden lg:block h-3 w-px bg-white/15" aria-hidden="true"></span>
        <a
          href={whatsapp(waMensajes.general)}
          target="_blank"
          rel="noopener"
          class="topbar-link inline-flex"
        >
          <Icon name="whatsapp" size={13} />
          <span class="hidden sm:inline">{site.whatsapp.numero}</span>
          <span class="sm:hidden">WhatsApp</span>
        </a>
      </div>
    </div>
  </div>

  <!-- ─────────────────────────────────────────────── Navegación principal -->
  <div class="navbar">
    <div class="container-q flex items-center justify-between gap-4">
      <a href="/" class="logo-link shrink-0" aria-label="Q-MEDICAL S.A.C. — Inicio">
        <img
          src="/img/logo/qmedical-azul.webp"
          srcset="/img/logo/qmedical-azul-1x.webp 1x, /img/logo/qmedical-azul.webp 2x"
          width="130"
          height="74"
          alt="Q-MEDICAL S.A.C."
          class="logo-img"
          fetchpriority="high"
        />
      </a>

      <nav class="hidden lg:flex items-center gap-0.5" aria-label="Navegación principal">
        {
          navegacion.map((item) =>
            item.href === '/catalogo' ? (
              <div class="nav-drop">
                <a
                  href={item.href}
                  class:list={['nav-link', activo(item.href) && 'is-active']}
                  aria-haspopup="true"
                >
                  {item.nombre}
                  <Icon name="chevron" size={12} class="nav-caret" />
                </a>

                <div class="nav-panel" role="menu">
                  <div class="nav-panel__grid">
                    <div class="nav-panel__cols">
                      <p class="nav-panel__title">
                        Líneas de producto
                        <span>{categorias.length}</span>
                      </p>
                      <ul class="nav-panel__list">
                        {categorias.map((c) => (
                          <li>
                            <a href={`/catalogo/${c.slug}`} class="nav-panel__item" role="menuitem">
                              <span class="nav-panel__icon">
                                <Icon name={c.icono} size={16} />
                              </span>
                              <span class="min-w-0">
                                <span class="block truncate font-medium">{c.corto}</span>
                                <span class="block text-[0.7rem] text-muted">
                                  {conteoProductos(c.slug)}
                                </span>
                              </span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <!-- Pieza destacada + accesos de apoyo -->
                    <div class="nav-panel__aside">
                      <a href={`/productos/${destacado.slug}`} class="nav-feature" role="menuitem">
                        <img
                          src={imagenPrincipal(destacado.slug, 480)}
                          width="480"
                          height="480"
                          alt=""
                          loading="lazy"
                          decoding="async"
                          class="nav-feature__img"
                        />
                        <span class="nav-feature__tag">Destacado</span>
                        <span class="nav-feature__name">{destacado.nombre}</span>
                        <span class="nav-feature__cta">
                          Ver ficha
                          <Icon name="arrow" size={13} />
                        </span>
                      </a>

                      <a href="/catalogo" class="nav-panel__link" role="menuitem">
                        <Icon name="search" size={15} />
                        Buscar en el catálogo
                        <span class="ml-auto text-muted">{productos.length}</span>
                      </a>
                      <a href="/fichas-tecnicas" class="nav-panel__link" role="menuitem">
                        <Icon name="pdf" size={15} />
                        Fichas técnicas en PDF
                        <span class="ml-auto text-muted">49</span>
                      </a>
                    </div>
                  </div>
                </div>
              </div>
            ) : (
              <a href={item.href} class:list={['nav-link', activo(item.href) && 'is-active']}>
                {item.nombre}
              </a>
            )
          )
        }
      </nav>

      <div class="flex shrink-0 items-center gap-2">
        <a
          href={whatsapp(waMensajes.cotizacion)}
          target="_blank"
          rel="noopener"
          class="hidden xl:grid h-10 w-10 place-items-center rounded-full border border-line text-[#128c7e] transition hover:border-[#128c7e]/40 hover:bg-[#128c7e]/8"
          aria-label="Escribir por WhatsApp"
        >
          <Icon name="whatsapp" size={18} />
        </a>
        <a href="/contacto#cotizar" class="btn btn-primary cta-nav hidden sm:inline-flex">
          <span class="hidden md:inline">Solicitar cotización</span>
          <span class="md:hidden">Cotizar</span>
        </a>
        <button
          id="menu-toggle"
          type="button"
          class="lg:hidden grid h-10 w-10 place-items-center rounded-lg border border-line text-ink transition hover:border-brand-300"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="menu-movil"
        >
          <Icon name="menu" size={20} class="icon-open" />
          <Icon name="close" size={20} class="icon-close hidden" />
        </button>
      </div>
    </div>

    <!-- Progreso de lectura de la página -->
    <div class="scroll-progress" aria-hidden="true"><span id="scroll-bar"></span></div>
  </div>

  <!-- ─────────────────────────────────────────────────────── Menú móvil -->
  <div id="menu-movil" class="menu-movil lg:hidden" hidden>
    <nav class="container-q py-5" aria-label="Navegación móvil">
      <ul class="space-y-0.5">
        {
          navegacion.map((item) => (
            <li>
              <a href={item.href} class:list={['menu-movil__link', activo(item.href) && 'is-active']}>
                {item.nombre}
                <Icon name="arrow" size={16} class="opacity-30" />
              </a>
            </li>
          ))
        }
      </ul>

      <p class="mt-6 mb-2.5 px-1 text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-muted">
        Líneas de producto
      </p>
      <ul class="grid grid-cols-2 gap-1.5">
        {
          categorias.map((c) => (
            <li>
              <a href={`/catalogo/${c.slug}`} class="menu-movil__cat">
                <Icon name={c.icono} size={15} class="shrink-0 text-brand-700" />
                <span class="min-w-0 truncate">{c.corto}</span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="mt-6 space-y-2.5">
        <a href="/contacto#cotizar" class="btn btn-primary w-full">Solicitar cotización</a>
        <a
          href={whatsapp(waMensajes.general)}
          target="_blank"
          rel="noopener"
          class="btn btn-outline w-full !text-[#0e7a6d] !border-[#0e7a6d]/25"
        >
          <Icon name="whatsapp" size={16} />
          Escribir por WhatsApp
        </a>
        <a href={site.telefonos[0].href} class="btn btn-outline w-full">
          <Icon name="phone" size={15} />
          {site.telefonos[0].etiqueta}
        </a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 60;
  }

  /* ── Barra superior ─────────────────────────────────────────────────── */
  .topbar {
    background: var(--color-brand-950);
    color: #fff;
    transition: margin-top 0.4s var(--ease-out-quint);
  }
  /* Al desplazarse se repliega y deja solo la navegación. */
  :global(html.scrolled) .topbar {
    margin-top: -2.25rem;
  }
  .topbar-link {
    /* Sin `display` a propósito: lo controlan las utilidades del elemento
       (`hidden` / `lg:inline-flex`), que tienen menor especificidad. */
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.55rem;
    border-radius: 0.4rem;
    color: rgba(255, 255, 255, 0.72);
    transition: color 0.2s, background 0.2s;
  }
  .topbar-link:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.08);
  }

  /* ── Navegación ─────────────────────────────────────────────────────── */
  .navbar {
    position: relative;
    background: rgba(255, 255, 255, 0.86);
    backdrop-filter: saturate(180%) blur(14px);
    -webkit-backdrop-filter: saturate(180%) blur(14px);
    border-bottom: 1px solid var(--color-line);
    transition: box-shadow 0.35s var(--ease-out-quint),
      background 0.35s var(--ease-out-quint);
  }
  .navbar > .container-q {
    padding-block: 0.9rem;
    transition: padding-block 0.35s var(--ease-out-quint);
  }
  :global(html.scrolled) .navbar {
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 12px 34px -26px rgba(12, 26, 72, 0.55);
  }
  :global(html.scrolled) .navbar > .container-q {
    padding-block: 0.55rem;
  }

  /* El logotipo acompaña el repliegue reduciéndose, sin deformarse. */
  .logo-img {
    height: 2.5rem;
    width: auto;
    transform-origin: left center;
    transition: height 0.35s var(--ease-out-quint), opacity 0.25s;
  }
  :global(html.scrolled) .logo-img {
    height: 2rem;
  }
  .logo-link:hover .logo-img { opacity: 0.78; }
  @media (max-width: 480px) {
    .logo-img { height: 2.1rem; }
    :global(html.scrolled) .logo-img { height: 1.85rem; }
  }

  /* Barra de progreso de lectura */
  .scroll-progress {
    position: absolute;
    inset: auto 0 -1px 0;
    height: 2px;
    pointer-events: none;
  }
  .scroll-progress span {
    display: block;
    height: 100%;
    width: 0;
    background: linear-gradient(90deg, var(--color-brand-700), #1bb5db);
    transition: width 0.1s linear, opacity 0.3s;
    opacity: 0;
  }
  :global(html.scrolled) .scroll-progress span { opacity: 1; }

  /* ── Enlaces ────────────────────────────────────────────────────────── */
  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.55rem 0.8rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: #3c4453;
    transition: color 0.25s;
  }
  /* Subrayado que crece desde el centro */
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.8rem;
    right: 0.8rem;
    bottom: 0.25rem;
    height: 1.5px;
    background: var(--color-brand-700);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.32s var(--ease-out-quint);
  }
  .nav-link:hover { color: var(--color-brand-700); }
  .nav-link:hover::after { transform: scaleX(1); }
  .nav-link.is-active {
    color: var(--color-brand-700);
    font-weight: 600;
  }
  .nav-link.is-active::after { transform: scaleX(1); }

  .nav-caret {
    opacity: 0.45;
    transform: rotate(90deg);
    transition: transform 0.3s var(--ease-out-quint), opacity 0.3s;
  }
  .nav-drop:hover .nav-caret,
  .nav-drop:focus-within .nav-caret {
    opacity: 0.9;
    transform: rotate(270deg);
  }

  /* ── Mega-menú ──────────────────────────────────────────────────────── */
  .nav-drop { position: relative; }
  .nav-panel {
    position: absolute;
    top: calc(100% + 0.35rem);
    left: 50%;
    width: min(46rem, calc(100vw - 3rem));
    padding-top: 0.55rem;
    transform: translate(-50%, -8px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.26s var(--ease-out-quint),
      transform 0.26s var(--ease-out-quint), visibility 0.26s;
  }
  .nav-drop:hover .nav-panel,
  .nav-drop:focus-within .nav-panel {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }
  .nav-panel__grid {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: 1rem;
    padding: 1.1rem;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    box-shadow: 0 30px 60px -30px rgba(12, 26, 72, 0.45);
  }
  .nav-panel__title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 0.55rem 0.7rem;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-muted);
  }
  .nav-panel__title span {
    display: grid;
    place-items: center;
    min-width: 1.2rem;
    height: 1.2rem;
    padding-inline: 0.3rem;
    border-radius: 999px;
    background: var(--color-brand-50);
    color: var(--color-brand-700);
    font-size: 0.62rem;
    letter-spacing: 0;
  }
  .nav-panel__list {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.15rem;
  }
  .nav-panel__item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.5rem 0.55rem;
    border-radius: 0.6rem;
    font-size: 0.83rem;
    color: #3c4453;
    transition: background 0.2s, color 0.2s;
  }
  .nav-panel__item:hover { background: var(--color-brand-50); color: var(--color-brand-700); }
  .nav-panel__icon {
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    flex: none;
    border-radius: 0.5rem;
    background: var(--color-surface);
    color: var(--color-brand-700);
    transition: background 0.2s, color 0.2s;
  }
  .nav-panel__item:hover .nav-panel__icon {
    background: var(--color-brand-700);
    color: #fff;
  }

  .nav-panel__aside {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding-left: 1rem;
    border-left: 1px solid var(--color-line);
  }
  .nav-feature {
    position: relative;
    display: block;
    padding: 0.9rem;
    margin-bottom: 0.3rem;
    border-radius: 0.8rem;
    background:
      radial-gradient(120% 80% at 50% 0%, #eef1fa 0%, var(--color-surface) 70%);
    overflow: hidden;
  }
  .nav-feature__img {
    display: block;
    width: 100%;
    height: 6.5rem;
    object-fit: contain;
    transition: transform 0.45s var(--ease-out-quint);
  }
  .nav-feature:hover .nav-feature__img { transform: scale(1.07); }
  .nav-feature__tag {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    background: #fff;
    font-size: 0.6rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-brand-700);
  }
  .nav-feature__name {
    display: block;
    margin-top: 0.6rem;
    font-size: 0.8rem;
    font-weight: 600;
    line-height: 1.3;
    color: var(--color-ink);
  }
  .nav-feature__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.4rem;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--color-brand-700);
  }
  .nav-panel__link {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.55rem 0.6rem;
    border-radius: 0.55rem;
    font-size: 0.8rem;
    color: #3c4453;
    transition: background 0.2s, color 0.2s;
  }
  .nav-panel__link:hover { background: var(--color-brand-50); color: var(--color-brand-700); }

  .cta-nav {
    padding: 0.65rem 1.15rem;
    font-size: 0.82rem;
    transition: padding 0.35s var(--ease-out-quint), background 0.25s,
      transform 0.25s, box-shadow 0.25s;
  }

  /* ── Menú móvil ─────────────────────────────────────────────────────── */
  .menu-movil {
    background: #fff;
    border-bottom: 1px solid var(--color-line);
    box-shadow: 0 24px 44px -30px rgba(12, 26, 72, 0.5);
    max-height: calc(100dvh - 6.5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    animation: menu-in 0.28s var(--ease-out-quint);
  }
  @keyframes menu-in {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: none; }
  }
  .menu-movil__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.8rem 0.65rem;
    border-radius: 0.6rem;
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-ink);
  }
  .menu-movil__link.is-active {
    color: var(--color-brand-700);
    background: var(--color-brand-50);
    font-weight: 600;
  }
  .menu-movil__cat {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 0.7rem;
    border: 1px solid var(--color-line);
    border-radius: 0.6rem;
    font-size: 0.8rem;
    color: #3c4453;
  }
  .menu-movil__cat:active { background: var(--color-brand-50); }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu-movil');

  const cerrarMenu = () => {
    if (!toggle || !menu || menu.hidden) return;
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Abrir menú');
    menu.hidden = true;
    toggle.querySelector('.icon-open')?.classList.remove('hidden');
    toggle.querySelector('.icon-close')?.classList.add('hidden');
  };

  toggle?.addEventListener('click', () => {
    const abierto = toggle.getAttribute('aria-expanded') === 'true';
    if (abierto) {
      cerrarMenu();
      return;
    }
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'Cerrar menú');
    if (menu) menu.hidden = false;
    toggle.querySelector('.icon-open')?.classList.add('hidden');
    toggle.querySelector('.icon-close')?.classList.remove('hidden');
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') cerrarMenu();
  });

  // Al pasar a escritorio el menú móvil no debe quedar abierto.
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
    if (e.matches) cerrarMenu();
  });

  // Estado de desplazamiento + progreso de lectura, en un solo rAF.
  const barra = document.getElementById('scroll-bar');
  let pendiente = false;

  const alDesplazar = () => {
    if (pendiente) return;
    pendiente = true;
    requestAnimationFrame(() => {
      const y = window.scrollY;
      document.documentElement.classList.toggle('scrolled', y > 32);

      if (barra) {
        const alto = document.documentElement.scrollHeight - window.innerHeight;
        barra.style.width = alto > 0 ? `${Math.min(100, (y / alto) * 100)}%` : '0%';
      }
      pendiente = false;
    });
  };

  alDesplazar();
  window.addEventListener('scroll', alDesplazar, { passive: true });
  window.addEventListener('resize', alDesplazar, { passive: true });
</script>

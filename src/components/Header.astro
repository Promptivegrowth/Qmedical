---
import Icon from './Icon.astro';
import { site, whatsapp, waMensajes } from '../data/site';
import { categorias, productos, conteoProductos, imagenPrincipal, productoPorSlug } from '../data/catalogo';
import { marcas } from '../data/marcas';

interface Props {
  /** Sobre fondo oscuro la cabecera se invierte hasta que se hace scroll. */
  claro?: boolean;
}
const { claro = false } = Astro.props;

const ruta = Astro.url.pathname.replace(/\/$/, '') || '/';
const activo = (href: string) =>
  href === '/' ? ruta === '/' : ruta === href || ruta.startsWith(href + '/');

const destCatalogo = productoPorSlug.get('videolaringoscopio')!;

const empresa = [
  { nombre: 'Marcas asociadas', href: '/marcas', nota: `${marcas.length} fabricantes representados`, icono: 'reticula' },
  { nombre: 'Infraestructura', href: '/nosotros#infraestructura', nota: 'Almacén certificado BPA', icono: 'almacen' },
  { nombre: 'Certificaciones', href: '/nosotros#certificaciones', nota: 'BPA · ISO 37001 · ISO 14001', icono: 'certificado' },
  { nombre: 'Entregas', href: '/nosotros#infraestructura', nota: 'Cobertura en todas las regiones', icono: 'entrega' },
];
---

<header id="cabecera" class:list={['cabecera', claro && 'es-clara']}>
  <div class="cabecera__lamina">
    <!-- Cintillo -->
    <div class="cintillo">
      <div class="caja flex h-9 items-center justify-between gap-4 text-[0.74rem]">
        <p class="flex min-w-0 items-center gap-2">
          <Icon name="certificado" size={13} class="shrink-0 opacity-55" />
          <span class="hidden sm:inline truncate">
            <span class="hidden lg:inline">Droguería certificada en </span>Buenas Prácticas de
            Almacenamiento — DIGEMID
          </span>
          <span class="sm:hidden truncate">Certificación BPA</span>
        </p>
        <div class="flex shrink-0 items-center gap-3">
          <a href={site.telefonos[0].href} class="cintillo__enlace hidden lg:inline-flex">
            <Icon name="telefono" size={12} />{site.telefonos[0].etiqueta}
          </a>
          <span class="hidden lg:block h-3 w-px bg-current opacity-20" aria-hidden="true"></span>
          <a href={whatsapp(waMensajes.general)} target="_blank" rel="noopener" class="cintillo__enlace inline-flex">
            <Icon name="whatsapp" size={12} />
            <span class="hidden sm:inline">{site.whatsapp.numero}</span>
            <span class="sm:hidden">WhatsApp</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Barra principal -->
    <div class="barra">
      <div class="caja flex items-center justify-between gap-6">
        <a href="/" class="marca" aria-label="Q-MEDICAL S.A.C. — Inicio">
          <img
            src="/img/logo/qmedical-azul.webp"
            srcset="/img/logo/qmedical-azul-1x.webp 1x, /img/logo/qmedical-azul.webp 2x"
            width="130" height="74" alt="Q-MEDICAL S.A.C."
            class="marca__img marca__img--tinta" fetchpriority="high"
          />
          <img
            src="/img/logo/qmedical-blanco.webp"
            srcset="/img/logo/qmedical-blanco-1x.webp 1x, /img/logo/qmedical-blanco.webp 2x"
            width="130" height="74" alt="" aria-hidden="true" class="marca__img marca__img--claro"
          />
        </a>

        <nav class="nav" aria-label="Navegación principal">
          <a href="/nosotros" class:list={['nav__enlace', activo('/nosotros') && 'es-activo']}>Nosotros</a>
          <div class="nav__item" data-menu="catalogo">
            <button type="button" class:list={['nav__enlace', activo('/catalogo') && 'es-activo']}
              aria-expanded="false" aria-controls="lamina-catalogo">
              Catálogo<span class="nav__punta"><Icon name="chevron" size={11} /></span>
            </button>
          </div>
          <div class="nav__item" data-menu="empresa">
            <button type="button" class:list={['nav__enlace', activo('/marcas') && 'es-activo']}
              aria-expanded="false" aria-controls="lamina-empresa">
              Empresa<span class="nav__punta"><Icon name="chevron" size={11} /></span>
            </button>
          </div>
          <a href="/contacto" class:list={['nav__enlace', activo('/contacto') && 'es-activo']}>Contacto</a>
        </nav>

        <div class="flex shrink-0 items-center gap-2">
          <a href="/contacto#cotizar" class="pill pill-tinta cta-barra">
            <span class="hidden md:inline">Solicitar cotización</span>
            <span class="md:hidden">Cotizar</span>
          </a>
          <button id="hamburguesa" type="button" class="hamburguesa"
            aria-label="Abrir menú" aria-expanded="false" aria-controls="menu-movil">
            <Icon name="menu" size={20} class="ic-abrir" />
            <Icon name="cerrar" size={20} class="ic-cerrar" />
          </button>
        </div>
      </div>
    </div>

    <!-- ── Láminas del mega-menú ─────────────────────────────────────── -->
    <div class="lamina-menu" id="lamina-catalogo" data-lamina="catalogo" hidden>
      <div class="caja lamina-menu__cuerpo">
        <a href={`/productos/${destCatalogo.slug}`} class="lamina destacado">
          <img src={imagenPrincipal(destCatalogo.slug, 900)} width="900" height="900" alt=""
            loading="lazy" class="destacado__img" />
          <span class="lamina__pie">
            <span>
              <span class="ante ante-claro">Destacado</span>
              <span class="mt-1 block display-sm text-white">{destCatalogo.nombre}</span>
            </span>
            <span class="disco-flecha"><Icon name="flecha" size={17} /></span>
          </span>
        </a>

        <div class="lamina-menu__lista">
          <p class="ante mb-5">Líneas de producto · {categorias.length}</p>
          <ul class="rejilla-lineas">
            {categorias.map((c) => (
              <li>
                <a href={`/catalogo/${c.slug}`} class="linea">
                  <span class="linea__ic"><Icon name={c.icono} size={19} /></span>
                  <span class="min-w-0">
                    <span class="block truncate font-medium">{c.corto}</span>
                    <span class="block text-[0.75rem] text-[var(--color-tinta-45)]">{conteoProductos(c.slug)}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <div class="lamina-menu__pie">
            <a href="/catalogo" class="enlace">Todo el catálogo · {productos.length} productos<Icon name="flecha" size={15} /></a>
            <a href="/contacto#cotizar" class="enlace">Solicitar una cotización<Icon name="flecha" size={15} /></a>
          </div>
        </div>
      </div>
    </div>

    <div class="lamina-menu" id="lamina-empresa" data-lamina="empresa" hidden>
      <div class="caja lamina-menu__cuerpo">
        <a href="/nosotros" class="lamina destacado destacado--foto">
          <img src="/img/fotos/equipo-almacen-1000.webp" width="1000" height="563" alt=""
            loading="lazy" class="destacado__img destacado__img--cubre" />
          <span class="lamina__pie">
            <span>
              <span class="ante ante-claro">Desde {site.fundacion}</span>
              <span class="mt-1 block display-sm text-white">Nuestro almacén</span>
            </span>
            <span class="disco-flecha"><Icon name="flecha" size={17} /></span>
          </span>
        </a>

        <div class="lamina-menu__lista">
          <p class="ante mb-5">La empresa</p>
          <ul class="rejilla-lineas rejilla-lineas--anchas">
            {empresa.map((e) => (
              <li>
                <a href={e.href} class="linea">
                  <span class="linea__ic"><Icon name={e.icono} size={19} /></span>
                  <span class="min-w-0">
                    <span class="block truncate font-medium">{e.nombre}</span>
                    <span class="block text-[0.75rem] text-[var(--color-tinta-45)]">{e.nota}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
          <div class="lamina-menu__pie">
            <a href="/libro-de-reclamaciones" class="enlace">Libro de Reclamaciones<Icon name="libro" size={15} /></a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ── Menú móvil ──────────────────────────────────────────────────── -->
  <div id="menu-movil" class="movil" hidden>
    <nav class="caja movil__cuerpo" aria-label="Navegación móvil">
      <p class="ante">Líneas de producto</p>
      <ul class="mt-4 grid grid-cols-2 gap-2">
        {categorias.map((c) => (
          <li>
            <a href={`/catalogo/${c.slug}`} class="movil__linea">
              <Icon name={c.icono} size={17} class="shrink-0 text-[var(--color-brand-700)]" />
              <span class="min-w-0 truncate">{c.corto}</span>
            </a>
          </li>
        ))}
      </ul>

      <ul class="mt-8 divide-y divide-[var(--color-linea)] border-y border-[var(--color-linea)]">
        {[
          { n: 'Nosotros', h: '/nosotros' },
          { n: 'Catálogo', h: '/catalogo' },
          { n: 'Marcas asociadas', h: '/marcas' },
          { n: 'Contacto', h: '/contacto' },
        ].map((i) => (
          <li>
            <a href={i.h} class:list={['movil__enlace', activo(i.h) && 'es-activo']}>
              {i.n}<Icon name="flecha" size={16} class="opacity-30" />
            </a>
          </li>
        ))}
      </ul>

      <div class="mt-7 grid gap-2.5">
        <a href="/contacto#cotizar" class="pill pill-tinta w-full">Solicitar cotización</a>
        <a href={whatsapp(waMensajes.general)} target="_blank" rel="noopener" class="pill pill-linea w-full">
          <Icon name="whatsapp" size={16} />Escribir por WhatsApp
        </a>
        <a href={site.telefonos[0].href} class="pill pill-linea w-full">
          <Icon name="telefono" size={15} />{site.telefonos[0].etiqueta}
        </a>
      </div>
    </nav>
  </div>

  <div class="velo" data-velo aria-hidden="true"></div>
</header>

<style>
  .cabecera { position: sticky; top: 0; z-index: 60; }

  /* Una sola superficie continua: cintillo, barra y lámina del menú.
     Al desplegarse, sus esquinas inferiores se redondean. */
  .cabecera__lamina {
    position: relative;
    z-index: 2;
    background: var(--color-papel);
    color: var(--color-tinta);
    transition: background-color 0.45s var(--ease-editorial),
      color 0.45s var(--ease-editorial), border-radius 0.7s var(--ease-salida),
      box-shadow 0.6s var(--ease-editorial);
  }
  :global(.cabecera.abierta) .cabecera__lamina {
    border-bottom-left-radius: var(--r-lamina);
    border-bottom-right-radius: var(--r-lamina);
    box-shadow: 0 30px 60px -40px rgba(20, 22, 28, 0.4);
  }
  :global(.cabecera.compacta) .cabecera__lamina { box-shadow: 0 1px 0 var(--color-linea); }

  /* Sobre un hero oscuro la cabecera es transparente y clara; recupera el
     papel al hacer scroll o al abrir una lámina. */
  .cabecera.es-clara:not(.compacta):not(.abierta):not(.movil-abierto) .cabecera__lamina {
    background: transparent;
    color: #fff;
  }

  .cintillo {
    border-bottom: 1px solid;
    border-color: color-mix(in srgb, currentColor 12%, transparent);
    transition: margin-top 0.45s var(--ease-editorial), opacity 0.3s;
  }
  :global(.cabecera.compacta:not(.abierta)) .cintillo { margin-top: -2.25rem; opacity: 0; }
  .cintillo__enlace {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    opacity: 0.75;
    transition: opacity 0.25s;
  }
  .cintillo__enlace:hover { opacity: 1; }

  .barra > .caja { padding-block: 1.1rem; transition: padding-block 0.4s var(--ease-editorial); }
  :global(.cabecera.compacta) .barra > .caja { padding-block: 0.7rem; }

  /* ── Logotipo ─────────────────────────────────────────────────────── */
  .marca { position: relative; display: block; flex: none; }
  .marca__img {
    height: 2.4rem;
    width: auto;
    transition: height 0.4s var(--ease-editorial), opacity 0.4s var(--ease-editorial);
  }
  :global(.cabecera.compacta) .marca__img { height: 1.95rem; }
  .marca__img--claro { position: absolute; inset: 0; opacity: 0; }
  .cabecera.es-clara:not(.compacta):not(.abierta):not(.movil-abierto) .marca__img--tinta { opacity: 0; }
  .cabecera.es-clara:not(.compacta):not(.abierta):not(.movil-abierto) .marca__img--claro { opacity: 1; }
  @media (max-width: 480px) { .marca__img { height: 2rem; } }

  /* ── Navegación ───────────────────────────────────────────────────── */
  .nav { display: none; align-items: center; gap: 0.35rem; }
  @media (min-width: 1024px) { .nav { display: flex; } }

  .nav__enlace {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.55rem 0.9rem;
    font-size: 0.95rem;
    color: inherit;
    cursor: pointer;
    background: none;
    border: 0;
  }
  .nav__enlace::after {
    content: '';
    position: absolute;
    left: 0.9rem;
    right: 0.9rem;
    bottom: 0.3rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transition: transform 0.4s var(--ease-salida);
  }
  .nav__enlace:hover::after,
  .nav__enlace.es-activo::after { transform: scaleX(1); }
  .nav__item.es-abierto .nav__enlace::after { transform: scaleX(1); }
  .nav__punta {
    display: inline-flex;
    opacity: 0.4;
    transform: rotate(90deg);
    transition: transform 0.4s var(--ease-salida);
  }
  .nav__item.es-abierto .nav__punta { transform: rotate(270deg); }

  .cta-barra { display: none; min-height: 2.6rem; padding: 0.6rem 1.25rem; font-size: 0.88rem; }
  .cabecera.es-clara:not(.compacta):not(.abierta):not(.movil-abierto) .cta-barra {
    background: var(--color-papel);
    color: var(--color-tinta);
  }
  @media (min-width: 640px) { .cta-barra { display: inline-flex; } }

  .hamburguesa {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid color-mix(in srgb, currentColor 22%, transparent);
    border-radius: 999px;
    color: inherit;
    background: none;
  }
  @media (min-width: 1024px) { .hamburguesa { display: none; } }
  .ic-cerrar { display: none; }
  :global(.cabecera.movil-abierto) .ic-abrir { display: none; }
  :global(.cabecera.movil-abierto) .ic-cerrar { display: block; }

  /* ── Lámina del mega-menú ─────────────────────────────────────────── */
  /* La lámina abre despacio: primero cede la altura y luego asoma el
     contenido, escalonado. Nada de saltos. */
  .lamina-menu { overflow: hidden; animation: abre-lamina 0.72s var(--ease-salida); }
  @keyframes abre-lamina {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: none; }
  }
  .lamina-menu .destacado,
  .lamina-menu .lamina-menu__lista > *,
  .lamina-menu .rejilla-lineas > li {
    animation: asoma-menu 0.6s var(--ease-salida) both;
  }
  .lamina-menu .destacado { animation-delay: 0.08s; }
  .lamina-menu .lamina-menu__lista > :nth-child(1) { animation-delay: 0.1s; }
  .lamina-menu .rejilla-lineas > li:nth-child(1) { animation-delay: 0.14s; }
  .lamina-menu .rejilla-lineas > li:nth-child(2) { animation-delay: 0.17s; }
  .lamina-menu .rejilla-lineas > li:nth-child(3) { animation-delay: 0.2s; }
  .lamina-menu .rejilla-lineas > li:nth-child(4) { animation-delay: 0.23s; }
  .lamina-menu .rejilla-lineas > li:nth-child(5) { animation-delay: 0.26s; }
  .lamina-menu .rejilla-lineas > li:nth-child(6) { animation-delay: 0.29s; }
  .lamina-menu .rejilla-lineas > li:nth-child(7) { animation-delay: 0.32s; }
  .lamina-menu .rejilla-lineas > li:nth-child(8) { animation-delay: 0.35s; }
  .lamina-menu .rejilla-lineas > li:nth-child(9) { animation-delay: 0.38s; }
  .lamina-menu .rejilla-lineas > li:nth-child(10) { animation-delay: 0.41s; }
  .lamina-menu .lamina-menu__pie { animation-delay: 0.44s; }
  @keyframes asoma-menu {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lamina-menu,
    .lamina-menu .destacado,
    .lamina-menu .lamina-menu__lista > *,
    .lamina-menu .rejilla-lineas > li { animation: none; }
  }
  .lamina-menu__cuerpo {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    gap: 3rem;
    padding-block: 0.5rem 2.75rem;
  }
  @media (max-width: 1180px) {
    .lamina-menu__cuerpo { grid-template-columns: minmax(0, 16rem) minmax(0, 1fr); gap: 2rem; }
  }

  .destacado { aspect-ratio: 16 / 11; border-radius: var(--r-md); }
  /* El producto va sobre fondo claro: el degradado del pie debe ser más
     denso que el de una fotografía para que la etiqueta se lea. */
  .destacado::after {
    background: linear-gradient(to top, rgba(10, 12, 18, 0.82) 0%, rgba(10, 12, 18, 0.35) 38%, transparent 62%);
  }
  .destacado .display-sm {
    font-size: 1.05rem;
    line-height: 1.2;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .destacado .lamina__pie { padding: 1.15rem; }
  .destacado__img { object-fit: contain; padding: 1.5rem; background: var(--color-papel-2); }
  .destacado__img--cubre { object-fit: cover; padding: 0; }
  .lamina-menu__lista { display: flex; flex-direction: column; }

  .rejilla-lineas {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.15rem 1rem;
  }
  .rejilla-lineas--anchas { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (max-width: 1180px) { .rejilla-lineas { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  .linea {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.65rem;
    border-radius: var(--r-sm);
    font-size: 0.93rem;
    color: var(--color-tinta);
    transition: background-color 0.25s var(--ease-editorial);
  }
  .linea:hover { background: rgba(20, 22, 28, 0.045); }
  .linea__ic {
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    flex: none;
    border-radius: 999px;
    border: 1px solid var(--color-linea);
    color: var(--color-brand-700);
    transition: background-color 0.25s, color 0.25s, border-color 0.25s;
  }
  .linea:hover .linea__ic {
    background: var(--color-brand-700);
    border-color: var(--color-brand-700);
    color: #fff;
  }

  .lamina-menu__pie {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    margin-top: auto;
    padding-top: 1.75rem;
  }

  /* ── Velo ─────────────────────────────────────────────────────────── */
  .velo {
    position: fixed;
    inset: 0;
    z-index: 1;
    background: rgba(20, 22, 28, 0.32);
    backdrop-filter: blur(2px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s var(--ease-editorial), visibility 0.6s;
  }
  :global(.cabecera.abierta) .velo { opacity: 1; visibility: visible; }

  /* ── Menú móvil ───────────────────────────────────────────────────── */
  .movil {
    position: relative;
    z-index: 2;
    background: var(--color-papel);
    border-bottom-left-radius: var(--r-lamina);
    border-bottom-right-radius: var(--r-lamina);
    box-shadow: 0 30px 60px -40px rgba(20, 22, 28, 0.4);
    max-height: calc(100dvh - 6rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    animation: baja-lamina 0.42s var(--ease-salida);
  }
  .movil__cuerpo { padding-block: 1.75rem 2.25rem; }
  .movil__linea {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--color-linea);
    border-radius: var(--r-sm);
    font-size: 0.85rem;
  }
  .movil__enlace {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.95rem 0.2rem;
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 400;
  }
  .movil__enlace.es-activo { color: var(--color-brand-700); }
</style>

<script>
  const cabecera = document.getElementById('cabecera');
  if (cabecera) {
    const items = Array.from(cabecera.querySelectorAll<HTMLElement>('.nav__item'));
    const laminas = new Map<string, HTMLElement>();
    cabecera.querySelectorAll<HTMLElement>('[data-lamina]').forEach((l) => laminas.set(l.dataset.lamina!, l));
    const velo = cabecera.querySelector<HTMLElement>('[data-velo]');
    const hamburguesa = document.getElementById('hamburguesa');
    const movil = document.getElementById('menu-movil');
    let abierta: string | null = null;
    let cierre = 0;

    const cerrarLamina = () => {
      abierta = null;
      laminas.forEach((l) => (l.hidden = true));
      items.forEach((i) => {
        i.classList.remove('es-abierto');
        i.querySelector('button')?.setAttribute('aria-expanded', 'false');
      });
      cabecera.classList.remove('abierta');
    };

    const abrirLamina = (clave: string) => {
      if (abierta === clave) return;
      laminas.forEach((l, k) => (l.hidden = k !== clave));
      items.forEach((i) => {
        const suya = i.dataset.menu === clave;
        i.classList.toggle('es-abierto', suya);
        i.querySelector('button')?.setAttribute('aria-expanded', String(suya));
      });
      abierta = clave;
      cabecera.classList.add('abierta');
    };

    const cerrarMovil = () => {
      if (!movil || movil.hidden) return;
      movil.hidden = true;
      cabecera.classList.remove('movil-abierto');
      hamburguesa?.setAttribute('aria-expanded', 'false');
      hamburguesa?.setAttribute('aria-label', 'Abrir menú');
    };

    items.forEach((item) => {
      const clave = item.dataset.menu!;
      const boton = item.querySelector('button')!;
      // En escritorio basta con apuntar; en táctil hace falta pulsar.
      item.addEventListener('pointerenter', (e) => {
        if ((e as PointerEvent).pointerType === 'touch') return;
        clearTimeout(cierre);
        abrirLamina(clave);
      });
      boton.addEventListener('click', () => (abierta === clave ? cerrarLamina() : abrirLamina(clave)));
      boton.addEventListener('focus', () => abrirLamina(clave));
    });

    // Se cierra al salir de la cabecera, con una pausa para poder bajar el ratón.
    cabecera.addEventListener('pointerleave', () => {
      clearTimeout(cierre);
      cierre = window.setTimeout(cerrarLamina, 320);
    });
    cabecera.addEventListener('pointerenter', () => clearTimeout(cierre));
    velo?.addEventListener('click', cerrarLamina);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { cerrarLamina(); cerrarMovil(); }
    });

    hamburguesa?.addEventListener('click', () => {
      if (!movil) return;
      if (!movil.hidden) { cerrarMovil(); return; }
      cerrarLamina();
      movil.hidden = false;
      cabecera.classList.add('movil-abierto');
      hamburguesa.setAttribute('aria-expanded', 'true');
      hamburguesa.setAttribute('aria-label', 'Cerrar menú');
    });
    window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
      if (e.matches) cerrarMovil();
    });

    let pendiente = false;
    const alScroll = () => {
      if (pendiente) return;
      pendiente = true;
      requestAnimationFrame(() => {
        cabecera.classList.toggle('compacta', window.scrollY > 24);
        pendiente = false;
      });
    };
    alScroll();
    window.addEventListener('scroll', alScroll, { passive: true });
  }
</script>

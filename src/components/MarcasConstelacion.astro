---
import Icon from './Icon.astro';
import { marcas } from '../data/marcas';

/**
 * Constelación de marcas asociadas.
 *
 * La sección se fija en pantalla mientras se recorre y las burbujas se
 * desplazan a distinta velocidad según su profundidad, de modo que el
 * conjunto se lee como un espacio con volumen y no como una lista.
 *
 * El desplazamiento se resuelve con una sola variable CSS (`--p`, de 0 a 1)
 * que actualiza un único requestAnimationFrame; todo el movimiento lo calcula
 * el compositor a partir de ella, sin tocar el layout en ningún momento.
 */

// x / y en % del lienzo · s = diámetro en rem · d = profundidad (0 lejos, 1 cerca)
const posiciones: Record<string, { x: number; y: number; s: number; d: number }> = {
  'q-medical':             { x: 9,  y: 40, s: 8.0, d: 0.92 },
  medcaptain:              { x: 24, y: 14, s: 6.6, d: 0.55 },
  maxcon:                  { x: 39, y: 18, s: 5.4, d: 0.28 },
  'nex-medical':           { x: 63, y: 20, s: 7.0, d: 0.70 },
  'alleva-medical':        { x: 79, y: 15, s: 5.8, d: 0.38 },
  geyi:                    { x: 91, y: 34, s: 7.4, d: 0.86 },
  'bano-facil':            { x: 11, y: 62, s: 8.6, d: 0.98 },
  'comfort-rubber-gloves': { x: 87, y: 56, s: 6.4, d: 0.48 },
  silpak:                  { x: 6,  y: 78, s: 6.0, d: 0.34 },
  xodus:                   { x: 25, y: 92, s: 7.2, d: 0.78 },
  jiehong:                 { x: 45, y: 99, s: 5.6, d: 0.44 },
  longood:                 { x: 63, y: 96, s: 6.6, d: 0.62 },
  telijie:                 { x: 81, y: 84, s: 7.6, d: 0.90 },
  medispo:                 { x: 95, y: 70, s: 5.0, d: 0.22 },
  kangbao:                 { x: 51, y: 6,  s: 5.2, d: 0.18 },
};

const nivel = (d: number) => (d >= 0.7 ? 'cerca' : d >= 0.4 ? 'medio' : 'lejos');

const burbujas = marcas.map((m) => {
  const p = posiciones[m.slug] ?? { x: 50, y: 50, s: 6, d: 0.5 };
  return { ...m, ...p, nivel: nivel(p.d) };
});
---

<section class="constelacion" data-constelacion>
  <div class="constelacion__pin">
    <!-- Capa de burbujas: decorativa, el listado accesible va más abajo -->
    <div class="constelacion__lienzo" aria-hidden="true">
      {
        burbujas.map((m) => (
          <span
            class="burbuja"
            data-nivel={m.nivel}
            style={`--x:${m.x};--y:${m.y};--s:${m.s};--d:${m.d}`}
          >
            <span class="burbuja__disco">
              <img
                src={`/img/marcas/${m.slug}.webp`}
                srcset={`/img/marcas/${m.slug}-1x.webp 1x, /img/marcas/${m.slug}.webp 2x`}
                width="240"
                height="120"
                alt=""
                loading="lazy"
                decoding="async"
                class="burbuja__logo"
              />
            </span>
          </span>
        ))
      }
    </div>

    <div class="constelacion__contenido">
      <p class="eyebrow eyebrow--light justify-center">Marcas asociadas</p>

      <h2 class="constelacion__titulo">
        Las marcas que elegimos para instituciones que no pueden fallar
      </h2>

      <p class="constelacion__bajada">
        Representamos y distribuimos a {marcas.length} fabricantes. Los
        seleccionamos por la consistencia de su documentación técnica y la
        estabilidad de su suministro, las dos condiciones sin las cuales una
        institución de salud no puede planificar.
      </p>

      <a href="/marcas" class="btn btn-light constelacion__cta">
        Conocer cada marca
        <Icon name="arrow" size={16} />
      </a>
    </div>
  </div>

  <!-- Equivalente accesible de la capa decorativa -->
  <h3 class="sr-only">Marcas asociadas a Q-MEDICAL</h3>
  <ul class="sr-only">
    {marcas.map((m) => <li><a href={`/marcas#${m.slug}`}>{m.nombre}</a></li>)}
  </ul>
</section>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .constelacion {
    --p: 0.5; /* progreso de recorrido, lo actualiza el script */
    --k: 1; /* factor de escala de las burbujas */
    position: relative;
    height: 250vh; /* recorrido disponible para la animación */
    background: var(--color-brand-950);
    color: #fff;
  }

  .constelacion__pin {
    position: sticky;
    top: 0;
    display: grid;
    place-items: center;
    height: 100svh;
    overflow: hidden;
  }

  /* Halo que da profundidad al fondo */
  .constelacion__pin::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      58% 48% at 50% 50%,
      rgba(7, 15, 43, 0.86) 0%,
      rgba(7, 15, 43, 0.35) 55%,
      transparent 100%
    );
    pointer-events: none;
  }

  /* ── Burbujas ───────────────────────────────────────────────────────── */
  .constelacion__lienzo {
    position: absolute;
    inset: 0;
  }

  .burbuja {
    position: absolute;
    left: calc(var(--x) * 1%);
    top: calc(var(--y) * 1%);
    width: calc(var(--s) * var(--k) * 1rem);
    aspect-ratio: 1;
    /* Las más cercanas recorren más distancia: eso construye la profundidad. */
    transform: translate(-50%, -50%)
      translate3d(0, calc((var(--p) - 0.5) * var(--d) * -30vh), 0)
      scale(calc(0.88 + var(--d) * var(--p) * 0.26));
    will-change: transform;
  }

  .burbuja__disco {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 14%;
    border-radius: 50%;
    /* Animación de flotación, independiente del parallax del contenedor */
    animation: flotar var(--dur, 9s) ease-in-out infinite alternate;
    animation-delay: calc(var(--d) * -6s);
  }
  .burbuja__logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Tres planos de profundidad, como en una fotografía con poca profundidad
     de campo: al fondo apenas se insinúan, al frente se leen por completo. */
  .burbuja[data-nivel='lejos'] .burbuja__disco {
    background: rgba(255, 255, 255, 0.055);
  }
  .burbuja[data-nivel='lejos'] .burbuja__logo {
    filter: brightness(0) invert(1);
    opacity: 0.26;
  }

  .burbuja[data-nivel='medio'] .burbuja__disco {
    background: rgba(255, 255, 255, 0.58);
  }
  .burbuja[data-nivel='medio'] .burbuja__logo { opacity: 0.9; }

  .burbuja[data-nivel='cerca'] .burbuja__disco {
    background: #fff;
    box-shadow: 0 24px 50px -22px rgba(0, 0, 0, 0.55);
  }

  @keyframes flotar {
    from { transform: translateY(-3%); }
    to { transform: translateY(3%); }
  }

  /* ── Contenido ──────────────────────────────────────────────────────── */
  .constelacion__contenido {
    position: relative;
    z-index: 2;
    max-width: 62rem;
    padding-inline: 1.25rem;
    text-align: center;
    pointer-events: none;
  }

  /* Velo bajo el texto: en pantallas estrechas las burbujas quedan tan cerca
     del bloque de texto que comprometen su lectura. */
  .constelacion__contenido::before {
    content: '';
    position: absolute;
    /* El recuadro es holgado y el degradado se apaga antes de alcanzarlo:
       de lo contrario se ve el corte recto del velo sobre una burbuja. */
    inset: -18% -16%;
    z-index: -1;
    background: radial-gradient(
      44% 42% at 50% 50%,
      rgba(7, 15, 43, 0.93) 0%,
      rgba(7, 15, 43, 0.62) 55%,
      transparent 100%
    );
    pointer-events: none;
  }
  .constelacion__contenido :global(a) { pointer-events: auto; }

  .constelacion__titulo {
    margin-top: 1.4rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.15rem, 7.4vw, 5.6rem);
    line-height: 0.98;
    letter-spacing: -0.022em;
    text-wrap: balance;
    /* Acompaña el recorrido con un acercamiento muy leve */
    transform: scale(calc(0.965 + var(--p) * 0.05));
    text-shadow: 0 6px 40px rgba(7, 15, 43, 0.75);
  }

  .constelacion__bajada {
    max-width: 40rem;
    margin: 1.6rem auto 0;
    font-size: 0.98rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.7);
    text-shadow: 0 2px 18px rgba(7, 15, 43, 0.85);
    /* Aparece cuando el bloque ya está centrado en pantalla */
    opacity: clamp(0, calc((var(--p) - 0.12) * 5), 1);
    transition: opacity 0.2s linear;
  }

  .constelacion__cta {
    margin-top: 2rem;
    opacity: clamp(0, calc((var(--p) - 0.2) * 5), 1);
  }

  /* ── Adaptaciones ───────────────────────────────────────────────────── */
  @media (max-width: 1023px) {
    .constelacion { height: 220vh; }
    .constelacion__lienzo { --k: 0.72; }
  }
  @media (max-width: 767px) {
    .constelacion { height: 200vh; }
    .constelacion__lienzo { --k: 0.54; }
    .constelacion__bajada { font-size: 0.9rem; }
  }
  @media (max-width: 419px) {
    .constelacion__lienzo { --k: 0.46; }
  }

  /* Sin animación: la sección se convierte en un panel estático legible. */
  @media (prefers-reduced-motion: reduce) {
    .constelacion { height: auto; }
    .constelacion__pin {
      position: static;
      height: auto;
      min-height: 34rem;
      padding-block: 6rem;
    }
    .burbuja {
      transform: translate(-50%, -50%);
    }
    .burbuja__disco { animation: none; }
    .constelacion__titulo { transform: none; }
    .constelacion__bajada,
    .constelacion__cta { opacity: 1; }
  }
</style>

<script>
  const seccion = document.querySelector<HTMLElement>('[data-constelacion]');

  if (seccion && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let pendiente = false;
    let visible = false;

    const actualizar = () => {
      const caja = seccion.getBoundingClientRect();
      const recorrido = caja.height - window.innerHeight;
      // 0 cuando la sección acaba de fijarse, 1 cuando está por soltarse.
      const p = recorrido > 0 ? Math.min(1, Math.max(0, -caja.top / recorrido)) : 0.5;
      seccion.style.setProperty('--p', p.toFixed(4));
      pendiente = false;
    };

    const alDesplazar = () => {
      if (pendiente || !visible) return;
      pendiente = true;
      requestAnimationFrame(actualizar);
    };

    // Solo se calcula mientras la sección está en pantalla.
    const io = new IntersectionObserver(
      ([entrada]) => {
        visible = entrada.isIntersecting;
        if (visible) actualizar();
      },
      { rootMargin: '120px 0px' }
    );
    io.observe(seccion);

    window.addEventListener('scroll', alDesplazar, { passive: true });
    window.addEventListener('resize', alDesplazar, { passive: true });
    actualizar();
  }
</script>

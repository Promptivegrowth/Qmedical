---
import Icon from './Icon.astro';
import { marcas } from '../data/marcas';

/**
 * Constelación de marcas asociadas.
 *
 * Las quince marcas se reparten sobre una órbita elíptica alrededor del
 * titular, que ocupa la pantalla y pasa por delante. Al recorrer la sección
 * toda la constelación gira: cada disco avanza por la órbita y, según su
 * radio, se acerca o se aleja del centro.
 *
 * La posición se calcula en `transform` con las funciones trigonométricas de
 * CSS a partir de una única variable `--p` (0 a 1) que actualiza un solo
 * requestAnimationFrame. No hay ni un cálculo de layout por fotograma.
 */

interface Orbe {
  a: number; // ángulo de partida en grados (-90 = arriba)
  r: number; // factor de radio sobre la órbita base
  s: number; // diámetro en rem
  t: 'fondo' | 'medio' | 'frente'; // tono del disco
}

// Dos anillos. En el exterior van los discos claros, que nunca llegan a cruzar
// el titular, más dos oscuros justo arriba y abajo para cerrar el encuadre; en
// el interior, los oscuros que sí lo cruzan sin comprometer la lectura. Los
// radios llevan variación para que no se lea como dos aros concéntricos.
const orbita: Record<string, Orbe> = {
  // Anillo exterior
  kangbao:                 { a: -90, r: 1.34, s: 6.0, t: 'fondo' },
  medcaptain:              { a: -70, r: 1.14, s: 7.8, t: 'medio' },
  geyi:                    { a: -25, r: 1.24, s: 8.6, t: 'frente' },
  'comfort-rubber-gloves': { a: 20,  r: 1.12, s: 7.6, t: 'medio' },
  xodus:                   { a: 65,  r: 1.21, s: 8.8, t: 'frente' },
  medispo:                 { a: 90,  r: 1.36, s: 5.8, t: 'fondo' },
  telijie:                 { a: 112, r: 1.11, s: 8.0, t: 'medio' },
  'nex-medical':           { a: 155, r: 1.26, s: 8.2, t: 'frente' },
  'bano-facil':            { a: 200, r: 1.17, s: 9.8, t: 'frente' },
  'q-medical':             { a: 245, r: 1.28, s: 9.4, t: 'frente' },

  // Anillo interior, por detrás del titular
  maxcon:                  { a: -46, r: 0.82, s: 6.6, t: 'fondo' },
  'alleva-medical':        { a: 18,  r: 0.62, s: 6.0, t: 'fondo' },
  longood:                 { a: 124, r: 0.88, s: 7.0, t: 'fondo' },
  silpak:                  { a: 172, r: 0.66, s: 6.4, t: 'fondo' },
  jiehong:                 { a: 226, r: 0.79, s: 6.6, t: 'fondo' },
};

const RX = 40; // debe coincidir con --rx del bloque de estilos
const RY = 39; // idem con --ry

const orbes = marcas.map((m) => {
  const o = orbita[m.slug] ?? { a: 0, r: 1, s: 7, t: 'fondo' as const };
  const rad = (o.a * Math.PI) / 180;
  return {
    ...m,
    ...o,
    // Coordenadas de partida, en % del lienzo, para el respaldo sin trigonometría.
    fx: +(50 + Math.cos(rad) * o.r * RX).toFixed(2),
    fy: +(50 + Math.sin(rad) * o.r * RY).toFixed(2),
  };
});
---

<section class="constelacion" data-constelacion>
  <div class="constelacion__pin">
    <!-- Capa decorativa: el listado accesible va al final de la sección -->
    <div class="constelacion__orbita" aria-hidden="true">
      {
        orbes.map((m) => (
          <span class="orbe" data-tono={m.t} style={`--a:${m.a}deg;--r:${m.r};--s:${m.s};--fx:${m.fx};--fy:${m.fy}`}>
            <span class="orbe__disco">
              <img
                src={`/img/marcas/${m.slug}.webp`}
                srcset={`/img/marcas/${m.slug}-1x.webp 1x, /img/marcas/${m.slug}.webp 2x`}
                width="240"
                height="120"
                alt=""
                loading="lazy"
                decoding="async"
                class="orbe__logo"
              />
            </span>
          </span>
        ))
      }
    </div>

    <div class="constelacion__contenido">
      <p class="constelacion__eyebrow">Marcas asociadas</p>

      <h2 class="constelacion__titulo">
        Las marcas que elegimos para las instituciones que no pueden fallar
      </h2>

      <a href="/marcas" class="constelacion__cta">
        Conocer las {marcas.length} marcas
        <Icon name="arrow" size={15} />
      </a>
    </div>
  </div>

  <!-- Equivalente accesible de la capa decorativa -->
  <h3 class="sr-only">Marcas asociadas a Q-MEDICAL</h3>
  <ul class="sr-only">
    {marcas.map((m) => <li><a href={`/marcas#${m.slug}`}>{m.nombre}</a></li>)}
  </ul>
</section>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .constelacion {
    --p: 0; /* avance del recorrido, lo actualiza el script */
    --giro: 62deg; /* cuánto gira la constelación de principio a fin */
    --rx: 40vw; /* semieje horizontal de la órbita */
    --ry: 39vh; /* semieje vertical */
    --k: 1; /* factor de escala de los discos */

    position: relative;
    height: 280vh; /* recorrido disponible para el giro */
    background: #000; /* negro corporativo del manual */
    color: #fff;
  }

  .constelacion__pin {
    position: sticky;
    top: 0;
    display: grid;
    place-items: center;
    height: 100svh;
    overflow: hidden;
  }

  /* ── Órbita ─────────────────────────────────────────────────────────── */
  .constelacion__orbita {
    position: absolute;
    inset: 0;
  }

  .orbe {
    /* Ángulo propio + el giro común de toda la constelación */
    --ang: calc(var(--a) + var(--p) * var(--giro));
    /* La órbita se abre ligeramente conforme avanza: da sensación de acercarse */
    --radio: calc(var(--r) * (0.94 + var(--p) * 0.1));

    position: absolute;
    left: 50%;
    top: 50%;
    width: calc(var(--s) * var(--k) * 1rem);
    aspect-ratio: 1;
    /* Todo el movimiento vive en transform: lo resuelve el compositor. */
    transform: translate(-50%, -50%)
      translate(
        calc(cos(var(--ang)) * var(--rx) * var(--radio)),
        calc(sin(var(--ang)) * var(--ry) * var(--radio))
      )
      scale(calc(0.92 + var(--p) * 0.12));
    will-change: transform;
  }

  .orbe__disco {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 15%;
    border-radius: 50%;
    /* Respiración propia, para que la órbita no se lea mecánica */
    animation: flotar 12s ease-in-out infinite alternate;
    animation-delay: calc(var(--s) * -0.9s);
  }
  .orbe__logo {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Tres tonos, como los planos de profundidad de la referencia: la mayoría
     casi se funde con el negro y unos pocos se leen por completo. */
  .orbe[data-tono='fondo'] .orbe__disco { background: #15171d; }
  .orbe[data-tono='fondo'] .orbe__logo {
    filter: brightness(0) invert(1);
    opacity: 0.3;
  }

  .orbe[data-tono='medio'] .orbe__disco { background: #6f7481; }
  .orbe[data-tono='medio'] .orbe__logo { opacity: 0.92; }

  .orbe[data-tono='frente'] .orbe__disco { background: #fff; }

  @keyframes flotar {
    from { transform: translateY(-2.5%); }
    to { transform: translateY(2.5%); }
  }

  /* Navegadores sin funciones trigonométricas en CSS: la constelación se
     muestra quieta en su posición de partida en lugar de apilarse al centro. */
  @supports not (width: calc(cos(45deg) * 1px)) {
    .orbe {
      left: calc(var(--fx) * 1%);
      top: calc(var(--fy) * 1%);
      transform: translate(-50%, -50%);
    }
  }

  /* ── Titular ────────────────────────────────────────────────────────── */
  .constelacion__contenido {
    position: relative;
    z-index: 2; /* el texto pasa por delante de la constelación */
    width: 100%;
    padding-inline: 1.5rem;
    text-align: center;
    pointer-events: none;
  }
  .constelacion__contenido a { pointer-events: auto; }

  .constelacion__eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }
  .constelacion__eyebrow::before,
  .constelacion__eyebrow::after {
    content: '';
    width: 1.6rem;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }

  /* Domina la pantalla: la constelación gira a su alrededor. */
  .constelacion__titulo {
    max-width: 14ch;
    margin: 0.9rem auto 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.5rem, 9.1vw, 9rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    text-wrap: balance;
    /* Muy leve: solo despega el texto de los discos claros que llega a cruzar */
    text-shadow: 0 2px 26px rgba(0, 0, 0, 0.55);
  }

  .constelacion__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2.8rem;
    padding-bottom: 0.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.35);
    font-size: 0.86rem;
    font-weight: 600;
    color: #fff;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.9), 0 0 6px rgba(0, 0, 0, 0.8);
    transition: border-color 0.25s, gap 0.25s;
  }
  .constelacion__cta:hover { border-color: #fff; gap: 0.8rem; }

  /* ── Adaptaciones ───────────────────────────────────────────────────── */
  @media (max-width: 1023px) {
    .constelacion { height: 250vh; --rx: 40vw; --ry: 35vh; --k: 0.76; }
    .constelacion__titulo { max-width: 13ch; }
  }
  @media (max-width: 767px) {
    .constelacion { height: 220vh; --rx: 47vw; --ry: 34vh; --k: 0.54; --giro: 52deg; }
    .constelacion__titulo {
      max-width: 10ch;
      font-size: clamp(2.2rem, 11.2vw, 4.2rem);
    }
  }
  @media (max-width: 419px) {
    .constelacion { --k: 0.48; }
  }

  /* Sin animación: la constelación queda quieta en su posición inicial. */
  @media (prefers-reduced-motion: reduce) {
    .constelacion { height: auto; }
    .constelacion__pin {
      position: static;
      height: auto;
      min-height: 40rem;
      padding-block: 6rem;
    }
    .orbe__disco { animation: none; }
  }
</style>

<script>
  const seccion = document.querySelector<HTMLElement>('[data-constelacion]');

  if (seccion && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let pendiente = false;
    let visible = false;

    const actualizar = () => {
      const caja = seccion.getBoundingClientRect();
      const recorrido = caja.height - window.innerHeight;
      // 0 al fijarse la sección, 1 justo antes de soltarse.
      const p = recorrido > 0 ? Math.min(1, Math.max(0, -caja.top / recorrido)) : 0;
      seccion.style.setProperty('--p', p.toFixed(4));
      pendiente = false;
    };

    const alDesplazar = () => {
      if (pendiente || !visible) return;
      pendiente = true;
      requestAnimationFrame(actualizar);
    };

    // Solo se calcula mientras la sección está en pantalla.
    const io = new IntersectionObserver(
      ([entrada]) => {
        visible = entrada.isIntersecting;
        if (visible) actualizar();
      },
      { rootMargin: '150px 0px' }
    );
    io.observe(seccion);

    window.addEventListener('scroll', alDesplazar, { passive: true });
    window.addEventListener('resize', alDesplazar, { passive: true });
    actualizar();
  }
</script>

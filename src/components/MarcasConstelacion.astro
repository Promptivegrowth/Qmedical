---
import Icon from './Icon.astro';
import { marcas } from '../data/marcas';

/**
 * Constelación de marcas asociadas.
 *
 * Un único anillo tridimensional que envuelve al titular y gira solo, de forma
 * continua. Cada marca ocupa un puesto fijo de la cadena, separada 360°/n de
 * la siguiente, y su aspecto depende únicamente de dónde esté en ese momento:
 *
 *   · Delante (mitad inferior): disco blanco, logotipo a todo color, grande y
 *     por encima del texto, al que llega a tapar.
 *   · Detrás (mitad superior): disco casi negro, logotipo apenas insinuado en
 *     blanco, pequeño y por debajo del texto.
 *
 * El movimiento se resuelve por completo en CSS: una propiedad registrada
 * `--t` (0 a 1) se anima linealmente y de ella salen posición, escala, tono y
 * plano. Cada disco arranca con un desfase negativo, de modo que no hay ni un
 * cálculo en JavaScript por fotograma.
 */

const N = marcas.length;
const RX = 42; // vw — semieje horizontal del anillo
const RY = 34; // vh — semieje vertical (aro inclinado, no circunferencia)

// Ligera variación de tamaño para que la cadena no se lea mecánica.
const tallas = [7.8, 7.2, 8.2, 7.4, 8.0, 7.0, 8.4, 7.6, 7.9, 7.1, 8.3, 7.5, 8.1, 7.3, 7.7];

const orbes = marcas.map((m, i) => {
  // Posición de partida; es también el respaldo si no hay animación.
  const ang = ((i / N) * 360 - 90) * (Math.PI / 180);
  return {
    ...m,
    i,
    s: tallas[i % tallas.length],
    fx: +(Math.cos(ang) * RX).toFixed(2),
    fy: +(Math.sin(ang) * RY).toFixed(2),
    fp: +((Math.sin(ang) + 1) / 2).toFixed(3),
  };
});
---

<section class="constelacion" data-constelacion>
  <div class="constelacion__pin">
    <!-- Capa decorativa: el listado accesible va al final de la sección -->
    <div class="anillo" aria-hidden="true">
      {
        orbes.map((m) => (
          <span
            class="orbe"
            style={`--i:${m.i};--s:${m.s};--fx:${m.fx};--fy:${m.fy};--fp:${m.fp}`}
          >
            <span class="orbe__disco">
              <img
                class="orbe__logo orbe__logo--color"
                src={`/img/marcas/${m.slug}.webp`}
                srcset={`/img/marcas/${m.slug}-1x.webp 1x, /img/marcas/${m.slug}.webp 2x`}
                width="240"
                height="120"
                alt=""
                loading="lazy"
                decoding="async"
              />
              <img
                class="orbe__logo orbe__logo--fantasma"
                src={`/img/marcas/${m.slug}-1x.webp`}
                width="240"
                height="120"
                alt=""
                loading="lazy"
                decoding="async"
              />
            </span>
          </span>
        ))
      }
    </div>

    <div class="constelacion__contenido">
      <p class="constelacion__eyebrow">Marcas asociadas</p>
      <h2 class="constelacion__titulo">
        Las marcas que elegimos para las instituciones que no pueden fallar
      </h2>
    </div>

    <!-- Por encima de todo el anillo: nunca queda tapado ni deja de ser pulsable -->
    <a href="/marcas" class="constelacion__cta">
      Conocer las {marcas.length} marcas
      <Icon name="flecha" size={15} />
    </a>
  </div>

  <!-- Equivalente accesible de la capa decorativa -->
  <h3 class="sr-only">Marcas asociadas a Q-MEDICAL</h3>
  <ul class="sr-only">
    {marcas.map((m) => <li><a href={`/marcas#${m.slug}`}>{m.nombre}</a></li>)}
  </ul>
</section>

<style>
  /* Propiedades registradas: sin declararlas, `--t` no sería animable y
     `--prof` no transmitiría su valor calculado a los hijos. */
  @property --t {
    syntax: '<number>';
    inherits: false;
    initial-value: 0;
  }
  @property --prof {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .constelacion {
    --n: 15; /* marcas en la cadena */
    --dur: 46s; /* una vuelta completa */
    --rx: 42vw;
    --ry: 34vh;
    --cy: 54%; /* centro del aro, algo por debajo del titular */
    --k: 1; /* factor de escala de los discos */

    position: relative;
    background: #000; /* negro corporativo del manual */
    color: #fff;
  }

  .constelacion__pin {
    position: relative;
    display: grid;
    place-items: center;
    height: 100svh;
    min-height: 38rem;
    overflow: hidden;
  }

  /* Sin transform ni filtro: no debe crear contexto de apilamiento, o los
     discos no podrían situarse por delante del titular. */
  .anillo {
    position: absolute;
    inset: 0;
  }

  /* ── Un puesto de la cadena ─────────────────────────────────────────── */
  .orbe {
    position: absolute;
    left: 50%;
    top: var(--cy);
    width: calc(var(--s) * var(--k) * 1rem);
    aspect-ratio: 1;

    /* Reparto estático de partida (respaldo sin animación) */
    --prof: var(--fp);
    transform: translate(-50%, -50%)
      translate(calc(var(--fx) * 1vw), calc(var(--fy) * 1vh))
      scale(calc(0.52 + var(--fp) * 0.6));
    z-index: 0;
  }

  .orbe__disco {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    /* Del negro del fondo al blanco pleno, según se acerca */
    background: color-mix(in srgb, #ffffff calc(var(--prof) * 100%), #101319);
  }

  .orbe__logo {
    position: absolute;
    inset: 15%;
    width: 70%;
    height: 70%;
    object-fit: contain;
  }
  /* Delante, el logotipo original. Detrás, una silueta blanca muy tenue:
     es como se leen los discos del fondo en la referencia. */
  .orbe__logo--color { opacity: var(--prof); }
  .orbe__logo--fantasma {
    filter: brightness(0) invert(1);
    opacity: calc((1 - var(--prof)) * 0.4);
  }

  /* ── Giro continuo ──────────────────────────────────────────────────── */
  /* Se activa solo si el navegador admite propiedades registradas,
     trigonometría y color-mix; lo comprueba el script. */
  :global(html.orbita-viva) .orbe {
    --ang: calc(var(--t) * 360deg - 90deg);
    --prof: calc((sin(var(--ang)) + 1) / 2);

    transform: translate(-50%, -50%)
      translate(calc(cos(var(--ang)) * var(--rx)), calc(sin(var(--ang)) * var(--ry)))
      scale(calc(0.52 + var(--prof) * 0.6));

    animation:
      girar var(--dur) linear infinite,
      plano var(--dur) step-end infinite;
    /* Cada disco entra con su desfase: la cadena queda repartida por igual. */
    animation-delay: calc(var(--dur) / var(--n) * var(--i) * -1);
  }

  @keyframes girar {
    from { --t: 0; }
    to { --t: 1; }
  }

  /* La mitad delantera del anillo (t de 0.25 a 0.75) pasa por encima del
     titular; la trasera, por debajo. */
  @keyframes plano {
    0% { z-index: 0; }
    25% { z-index: 3; }
    75% { z-index: 0; }
  }

  /* Al desplazarse el anillo se detiene, y retoma al soltar. */
  :global(html.desplazando) .orbe {
    animation-play-state: paused;
  }

  /* ── Titular ────────────────────────────────────────────────────────── */
  .constelacion__contenido {
    position: relative;
    z-index: 2; /* entre la mitad trasera (0) y la delantera (3) */
    width: 100%;
    padding-inline: 1.5rem;
    text-align: center;
    pointer-events: none;
  }

  .constelacion__eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.7rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }
  .constelacion__eyebrow::before,
  .constelacion__eyebrow::after {
    content: '';
    width: 1.6rem;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }

  .constelacion__titulo {
    max-width: 13ch;
    margin: 1rem auto 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.4rem, 8.6vw, 8.6rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
    text-wrap: balance;
    /* El `overflow-wrap: break-word` global partiría «instituciones» a la
       mitad en pantallas estrechas. */
    overflow-wrap: normal;
    hyphens: none;
  }

  .constelacion__cta {
    position: absolute;
    left: 50%;
    bottom: clamp(1.75rem, 5vh, 3.25rem);
    z-index: 5; /* por encima incluso de la mitad delantera */
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.4rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.58);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    font-size: 0.84rem;
    font-weight: 600;
    color: #fff;
    white-space: nowrap;
    transform: translateX(-50%);
    transition: background 0.25s, border-color 0.25s, gap 0.25s;
  }
  .constelacion__cta:hover {
    background: rgba(0, 0, 0, 0.82);
    border-color: rgba(255, 255, 255, 0.55);
    gap: 0.8rem;
  }

  /* ── Adaptaciones ───────────────────────────────────────────────────── */
  @media (max-width: 1023px) {
    .constelacion { --rx: 44vw; --ry: 32vh; --cy: 55%; --k: 0.74; }
    .constelacion__titulo { max-width: 12ch; }
  }
  @media (max-width: 767px) {
    .constelacion { --rx: 46vw; --ry: 29vh; --cy: 56%; --k: 0.54; --dur: 40s; }
    .constelacion__titulo {
      max-width: 13ch;
      font-size: clamp(1.95rem, 10.2vw, 4.2rem);
    }
  }
  @media (max-width: 419px) {
    .constelacion { --k: 0.46; }
  }

  /* Quien pide menos movimiento ve el anillo quieto en su reparto inicial. */
  @media (prefers-reduced-motion: reduce) {
    .orbe { animation: none !important; }
  }
</style>

<script>
  // El giro solo se activa si el navegador admite las tres piezas que necesita.
  const soportado =
    typeof CSS !== 'undefined' &&
    'registerProperty' in CSS &&
    CSS.supports('width', 'calc(cos(45deg) * 1px)') &&
    CSS.supports('color', 'color-mix(in srgb, #fff 50%, #000)');

  const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (soportado && !quieto) {
    document.documentElement.classList.add('orbita-viva');
  }

  // El anillo se detiene mientras se hace scroll y retoma al soltar.
  let temporizador: number;
  window.addEventListener(
    'scroll',
    () => {
      const raiz = document.documentElement;
      if (!raiz.classList.contains('desplazando')) raiz.classList.add('desplazando');
      clearTimeout(temporizador);
      temporizador = window.setTimeout(() => raiz.classList.remove('desplazando'), 160);
    },
    { passive: true }
  );
</script>

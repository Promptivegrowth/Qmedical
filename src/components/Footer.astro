---
import Icon from './Icon.astro';
import { site, redes, contactos, whatsapp, waMensajes } from '../data/site';
import { categorias } from '../data/catalogo';
import { ruta as via, type Idioma } from '../i18n/rutas';
import { textos } from '../i18n/textos';
import { categoriaEn, areasEn, empresaEn, waMensajesEn } from '../i18n/contenido';

interface Props {
  lang?: Idioma;
}
const { lang = 'es' } = Astro.props;

const t = textos(lang);
const wa = lang === 'en' ? waMensajesEn : waMensajes;
const anio = new Date().getFullYear();

const lineas = categorias.map((c) => ({
  ...categoriaEn(c, lang),
  href: via(lang, 'categoria', c.slug),
}));

// El nombre del área se traduce; el correo, evidentemente, no.
const directorio = contactos.map((c, i) => ({
  correo: c.correo,
  area: lang === 'en' ? (areasEn[i] ?? c.area) : c.area,
}));

const horario = lang === 'en' ? empresaEn.horario : site.horario;
const pais = lang === 'en' ? empresaEn.pais : site.direccion.pais;

const enlacesEmpresa = [
  { nombre: t.pie.nosotros, href: via(lang, 'nosotros') },
  { nombre: t.pie.marcas, href: via(lang, 'marcas') },
  { nombre: t.pie.catalogo, href: via(lang, 'catalogo') },
  { nombre: t.pie.fichas, href: via(lang, 'fichas') },
  { nombre: t.pie.contacto, href: via(lang, 'contacto') },
  { nombre: t.pie.reclamos, href: via(lang, 'reclamos') },
];
---

<footer class="pie">
  <!-- ── Cierre editorial: la última llamada, sobre el almacén ──────────
       La fotografía va a sangre y se mueve con parallax; encima, un velo
       firme que sostiene el contraste del texto en blanco. -->
  <section class="cierre-hero">
    <div class="cierre-hero__fondo" aria-hidden="true">
      <span class="cierre-hero__plano parallax" data-parallax="0.16">
      <img
        class="cierre-hero__img"
        src="/img/fotos/almacen-p1360310-1600.webp"
        srcset="/img/fotos/almacen-p1360310-1000.webp 1000w, /img/fotos/almacen-p1360310-1600.webp 1600w"
        sizes="100vw"
        width="1600"
        height="1200"
        alt=""
        loading="lazy"
        decoding="async"
      />
      </span>
      <div class="cierre-hero__velo"></div>
      <div class="cierre-hero__trama trama"></div>
    </div>

    <div class="caja cierre-hero__cuerpo" data-anim-grupo="110">
      <p class="ante ante-claro" data-anim="sube">{t.pie.ante}</p>
      <h2 class="display-lg mt-5 max-w-4xl" data-anim="sube">{t.pie.titulo}</h2>

      <div class="cierre-hero__acciones">
        <a
          href={via(lang, 'contacto', undefined, 'cotizar')}
          class="pill relleno relleno--papel"
          data-anim="sube"
        >
          {t.cotizar}<Icon name="flecha" size={16} />
        </a>
        <a
          href={whatsapp(wa.cotizacion)}
          target="_blank"
          rel="noopener"
          class="pill relleno relleno--claro"
          data-anim="sube"
        >
          <Icon name="whatsapp" size={17} />WhatsApp {site.whatsapp.numero}
        </a>
      </div>
    </div>
  </section>

  <div class="caja">
    <div class="grid gap-x-10 gap-y-12 py-16 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <img
          src="/img/logo/qmedical-blanco.webp"
          srcset="/img/logo/qmedical-blanco-1x.webp 1x, /img/logo/qmedical-blanco.webp 2x"
          width="150" height="85" alt="Q-MEDICAL S.A.C." class="h-10 w-auto" loading="lazy"
        />
        <p class="mt-6 max-w-sm text-[0.92rem] leading-relaxed text-white/55">{t.pie.sobre}</p>
        <ul class="mt-8 flex gap-2.5">
          {redes.map((r) => (
            <li>
              <a href={r.href} target="_blank" rel="noopener" aria-label={r.nombre} class="pie__red">
                <Icon name={r.icono} size={16} />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="sm:col-span-1 lg:col-span-3">
        <h3 class="ante ante-claro">{t.pie.lineas}</h3>
        <ul class="mt-5 space-y-2.5 text-[0.88rem]">
          {lineas.map((c) => (
            <li><a href={c.href} class="pie__enlace">{c.corto}</a></li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-2">
        <h3 class="ante ante-claro">{t.pie.empresa}</h3>
        <ul class="mt-5 space-y-2.5 text-[0.88rem]">
          {enlacesEmpresa.map((e) => (
            <li><a href={e.href} class="pie__enlace">{e.nombre}</a></li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-3">
        <h3 class="ante ante-claro">{t.pie.contacto}</h3>
        <ul class="mt-5 space-y-4 text-[0.88rem]">
          <li class="flex gap-3">
            <Icon name="lugar" size={16} class="mt-0.5 shrink-0 text-white/30" />
            <span class="text-white/70">
              {site.direccion.calle}<br />{site.direccion.distrito} — {site.direccion.ciudad}, {pais}
            </span>
          </li>
          <li class="flex gap-3">
            <Icon name="telefono" size={16} class="mt-0.5 shrink-0 text-white/30" />
            <span>
              {site.telefonos.map((t, i) => (
                <>{i > 0 && <br />}<a href={t.href} class="pie__enlace">{t.etiqueta}</a></>
              ))}
            </span>
          </li>
          <li class="flex gap-3">
            <Icon name="correo" size={16} class="mt-0.5 shrink-0 text-white/30" />
            <a href={`mailto:${site.correoPrincipal}`} class="pie__enlace break-all">{site.correoPrincipal}</a>
          </li>
          <li class="flex gap-3">
            <Icon name="reloj" size={16} class="mt-0.5 shrink-0 text-white/30" />
            <span class="text-white/70">{horario}</span>
          </li>
        </ul>
      </div>
    </div>

    <details class="pie__directorio">
      <summary>
        <span class="inline-flex items-center gap-2">
          <Icon name="correo" size={15} class="text-white/35" />{t.pie.correos}
        </span>
        <span class="pie__mas"><Icon name="mas" size={15} /></span>
      </summary>
      <ul class="grid gap-x-8 gap-y-3.5 px-5 pb-6 text-[0.82rem] sm:grid-cols-2 lg:grid-cols-3">
        {directorio.map((c) => (
          <li>
            <span class="block text-white/35">{c.area}</span>
            <a href={`mailto:${c.correo}`} class="pie__enlace break-all">{c.correo}</a>
          </li>
        ))}
      </ul>
    </details>
  </div>

  <div class="border-t border-white/10">
    <div class="caja pie__legal flex flex-col gap-3 py-6 text-[0.78rem] text-white/55 sm:flex-row sm:items-center sm:justify-between">
      <p>{t.pie.derechos(anio, site.nombre)} — {t.pie.ruc} {site.ruc}</p>
      <p class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href={via(lang, 'reclamos')} class="pie__enlace">{t.pie.reclamos}</a>
        <span class="hidden sm:inline text-white/15">·</span>
        <span>{t.cintilloCorto} — DIGEMID</span>
      </p>
    </div>
  </div>
</footer>

<!-- Acceso directo a WhatsApp -->
<a
  href={whatsapp(wa.general)}
  target="_blank"
  rel="noopener"
  class="wa"
  aria-label={t.escribirWa + ' — ' + site.whatsapp.numero}
>
  <Icon name="whatsapp" size={24} />
</a>

<style>
  .pie {
    background: var(--color-brand-700);
    color: #fff;
  }

  /* Deja libre la esquina inferior derecha, que ocupa el botón flotante de
     WhatsApp. */
  @media (min-width: 640px) { .pie__legal { padding-right: 4.75rem; } }

  /* ── Banda de cierre ──────────────────────────────────────────────── */
  .cierre-hero {
    position: relative;
    overflow: hidden;
    padding-block: 6rem 5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }
  @media (min-width: 1024px) { .cierre-hero { padding-block: 9rem 7.5rem; } }

  .cierre-hero__fondo { position: absolute; inset: 0; }
  /* El plano lleva el parallax y la imagen el acercamiento: cada
     transformación en su capa, para que no se pisen. */
  .cierre-hero__plano {
    position: absolute;
    top: -14%;
    left: 0;
    display: block;
    width: 100%;
    height: 128%;
  }
  .cierre-hero__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Acercamiento lento y continuo, como en las fotografías del compromiso. */
    animation: cine-cierre 40s ease-in-out infinite alternate;
  }
  @keyframes cine-cierre {
    from { transform: scale(1); }
    to { transform: scale(1.14); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cierre-hero__img { animation: none; }
  }
  /* Velo firme: la fotografía del almacén es clara y el titular va en blanco.
     Se refuerza a la izquierda, que es donde se apoya el texto. */
  /* Velo direccional, como en la portada: firme en la columna del texto y
     suelto a la derecha, donde la fotografía se ve. */
  .cierre-hero__velo {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        rgba(6, 12, 36, 0.92) 0%,
        rgba(6, 12, 36, 0.82) 38%,
        rgba(6, 12, 36, 0.5) 68%,
        rgba(6, 12, 36, 0.34) 100%
      ),
      linear-gradient(to top, rgba(6, 12, 36, 0.45) 0%, rgba(6, 12, 36, 0.1) 55%, transparent 100%);
  }
  .cierre-hero__trama { position: absolute; inset: 0; opacity: 0.35; }
  .cierre-hero__cuerpo { position: relative; }

  .cierre-hero__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2.5rem;
  }

  /* ── Botón que se rellena de izquierda a derecha ───────────────────
     El relleno entra al aparecer el botón, no al pasar el cursor: es parte
     de la entrada de la sección. El color del texto cambia con retraso, ya
     pasada la mitad del barrido, para que nunca quede ilegible. */
  .relleno {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: transparent;
    border-color: rgba(255, 255, 255, 0.45);
    color: #fff;
    transition: color 0.35s var(--ease-editorial) calc(var(--retraso, 0ms) + 620ms),
      border-color 0.4s var(--ease-editorial);
  }
  .relleno::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.85s var(--ease-salida) calc(var(--retraso, 0ms) + 260ms);
  }
  .relleno--papel::before { background: var(--color-papel); }
  .relleno--claro::before { background: rgba(255, 255, 255, 0.14); }

  .relleno.visible::before { transform: scaleX(1); }
  .relleno--papel.visible { color: var(--color-tinta); border-color: var(--color-papel); }
  .relleno--claro.visible { border-color: rgba(255, 255, 255, 0.55); }

  /* Sin JavaScript la clase `visible` no llega nunca: el botón se muestra ya
     relleno en vez de quedarse a medias. */
  html:not(.js) .relleno::before { transform: scaleX(1); }
  html:not(.js) .relleno--papel { color: var(--color-tinta); border-color: var(--color-papel); }

  .relleno--papel:hover { border-color: #fff; }
  .relleno--papel:hover::before { background: #fff; }
  .relleno--claro:hover { border-color: rgba(255, 255, 255, 0.85); }
  .relleno--claro:hover::before { background: rgba(255, 255, 255, 0.24); }

  @media (prefers-reduced-motion: reduce) {
    .relleno,
    .relleno::before { transition-delay: 0ms; }
  }


  .pie__enlace {
    color: rgba(255, 255, 255, 0.7);
    transition: color 0.25s var(--ease-editorial);
  }
  .pie__enlace:hover { color: #fff; }

  .pie__red {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.7);
    transition: border-color 0.3s, background-color 0.3s, color 0.3s;
  }
  .pie__red:hover {
    border-color: rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .pie__directorio {
    margin-bottom: 3.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--r-md);
  }
  .pie__directorio summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    font-size: 0.86rem;
    color: rgba(255, 255, 255, 0.85);
    cursor: pointer;
    list-style: none;
  }
  .pie__directorio summary::-webkit-details-marker { display: none; }
  .pie__mas { display: inline-flex; transition: transform 0.35s var(--ease-salida); }
  .pie__directorio[open] .pie__mas { transform: rotate(45deg); }

  .wa {
    position: fixed;
    right: 1.1rem;
    bottom: 1.1rem;
    z-index: 50;
    display: grid;
    place-items: center;
    width: 3.1rem;
    height: 3.1rem;
    border-radius: 999px;
    background: #128c7e;
    color: #fff;
    box-shadow: 0 16px 32px -12px rgba(0, 0, 0, 0.5);
    transition: transform 0.35s var(--ease-salida), background-color 0.3s;
  }
  .wa:hover { background: #0e7a6d; transform: translateY(-3px); }
  @media (min-width: 640px) { .wa { right: 1.6rem; bottom: 1.6rem; } }
</style>

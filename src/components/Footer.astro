---
import Icon from './Icon.astro';
import { site, redes, contactos, whatsapp, waMensajes } from '../data/site';
import { categorias } from '../data/catalogo';

const anio = new Date().getFullYear();
---

<footer class="pie">
  <div class="caja">
    <!-- Cierre editorial: la última llamada, en grande -->
    <div class="pie__cierre" data-anim="sube">
      <p class="ante ante-claro">Hablemos</p>
      <h2 class="display-lg mt-5 max-w-4xl">
        Cuéntenos qué necesita su institución y le respondemos con precio,
        disponibilidad y ficha técnica.
      </h2>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/contacto#cotizar" class="pill pill-papel">
          Solicitar cotización<Icon name="flecha" size={16} />
        </a>
        <a href={whatsapp(waMensajes.cotizacion)} target="_blank" rel="noopener" class="pill pill-claro">
          <Icon name="whatsapp" size={17} />WhatsApp {site.whatsapp.numero}
        </a>
      </div>
    </div>

    <hr class="pie__filete" />

    <div class="grid gap-x-10 gap-y-12 py-16 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <img
          src="/img/logo/qmedical-blanco.webp"
          srcset="/img/logo/qmedical-blanco-1x.webp 1x, /img/logo/qmedical-blanco.webp 2x"
          width="150" height="85" alt="Q-MEDICAL S.A.C." class="h-10 w-auto" loading="lazy"
        />
        <p class="mt-6 max-w-sm text-[0.92rem] leading-relaxed text-white/55">
          Droguería peruana comprometida con la salud del país. Abastecemos a
          instituciones de salud estatales y privadas con dispositivos médicos,
          bioseguridad y protección personal de alta calidad.
        </p>
        <ul class="mt-8 flex gap-2.5">
          {redes.map((r) => (
            <li>
              <a href={r.href} target="_blank" rel="noopener" aria-label={r.nombre} class="pie__red">
                <Icon name={r.icono} size={16} />
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="sm:col-span-1 lg:col-span-3">
        <h3 class="ante ante-claro">Líneas de producto</h3>
        <ul class="mt-5 space-y-2.5 text-[0.88rem]">
          {categorias.map((c) => (
            <li><a href={`/catalogo/${c.slug}`} class="pie__enlace">{c.corto}</a></li>
          ))}
        </ul>
      </div>

      <div class="lg:col-span-2">
        <h3 class="ante ante-claro">Empresa</h3>
        <ul class="mt-5 space-y-2.5 text-[0.88rem]">
          <li><a href="/nosotros" class="pie__enlace">Nosotros</a></li>
          <li><a href="/marcas" class="pie__enlace">Marcas asociadas</a></li>
          <li><a href="/catalogo" class="pie__enlace">Catálogo</a></li>
          <li><a href="/fichas-tecnicas" class="pie__enlace">Fichas técnicas</a></li>
          <li><a href="/contacto" class="pie__enlace">Contacto</a></li>
          <li><a href="/libro-de-reclamaciones" class="pie__enlace">Libro de reclamaciones</a></li>
        </ul>
      </div>

      <div class="lg:col-span-3">
        <h3 class="ante ante-claro">Contacto</h3>
        <ul class="mt-5 space-y-4 text-[0.88rem]">
          <li class="flex gap-3">
            <Icon name="lugar" size={16} class="mt-0.5 shrink-0 text-white/30" />
            <span class="text-white/70">
              {site.direccion.calle}<br />{site.direccion.distrito} — {site.direccion.ciudad}, {site.direccion.pais}
            </span>
          </li>
          <li class="flex gap-3">
            <Icon name="telefono" size={16} class="mt-0.5 shrink-0 text-white/30" />
            <span>
              {site.telefonos.map((t, i) => (
                <>{i > 0 && <br />}<a href={t.href} class="pie__enlace">{t.etiqueta}</a></>
              ))}
            </span>
          </li>
          <li class="flex gap-3">
            <Icon name="correo" size={16} class="mt-0.5 shrink-0 text-white/30" />
            <a href={`mailto:${site.correoPrincipal}`} class="pie__enlace break-all">{site.correoPrincipal}</a>
          </li>
          <li class="flex gap-3">
            <Icon name="reloj" size={16} class="mt-0.5 shrink-0 text-white/30" />
            <span class="text-white/70">{site.horario}</span>
          </li>
        </ul>
      </div>
    </div>

    <details class="pie__directorio">
      <summary>
        <span class="inline-flex items-center gap-2">
          <Icon name="correo" size={15} class="text-white/35" />Directorio de correos por área
        </span>
        <span class="pie__mas"><Icon name="mas" size={15} /></span>
      </summary>
      <ul class="grid gap-x-8 gap-y-3.5 px-5 pb-6 text-[0.82rem] sm:grid-cols-2 lg:grid-cols-3">
        {contactos.map((c) => (
          <li>
            <span class="block text-white/35">{c.area}</span>
            <a href={`mailto:${c.correo}`} class="pie__enlace break-all">{c.correo}</a>
          </li>
        ))}
      </ul>
    </details>
  </div>

  <div class="border-t border-white/10">
    <div class="caja flex flex-col gap-3 py-6 text-[0.78rem] text-white/40 sm:flex-row sm:items-center sm:justify-between">
      <p>© {anio} {site.nombre} — RUC {site.ruc}</p>
      <p class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href="/libro-de-reclamaciones" class="pie__enlace">Libro de reclamaciones</a>
        <span class="hidden sm:inline text-white/15">·</span>
        <span>Certificación BPA — DIGEMID</span>
      </p>
    </div>
  </div>
</footer>

<!-- Acceso directo a WhatsApp -->
<a
  href={whatsapp(waMensajes.general)}
  target="_blank"
  rel="noopener"
  class="wa"
  aria-label={`Escribir por WhatsApp al ${site.whatsapp.numero}`}
>
  <Icon name="whatsapp" size={24} />
</a>

<style>
  .pie {
    background: var(--color-brand-950);
    color: #fff;
  }

  .pie__cierre { padding-block: 5.5rem 4.5rem; }
  @media (min-width: 1024px) { .pie__cierre { padding-block: 7.5rem 6rem; } }

  .pie__filete { border: 0; border-top: 1px solid rgba(255, 255, 255, 0.12); }

  .pie__enlace {
    color: rgba(255, 255, 255, 0.7);
    transition: color 0.25s var(--ease-editorial);
  }
  .pie__enlace:hover { color: #fff; }

  .pie__red {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.7);
    transition: border-color 0.3s, background-color 0.3s, color 0.3s;
  }
  .pie__red:hover {
    border-color: rgba(255, 255, 255, 0.45);
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
  }

  .pie__directorio {
    margin-bottom: 3.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: var(--r-md);
  }
  .pie__directorio summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    font-size: 0.86rem;
    color: rgba(255, 255, 255, 0.85);
    cursor: pointer;
    list-style: none;
  }
  .pie__directorio summary::-webkit-details-marker { display: none; }
  .pie__mas { display: inline-flex; transition: transform 0.35s var(--ease-salida); }
  .pie__directorio[open] .pie__mas { transform: rotate(45deg); }

  .wa {
    position: fixed;
    right: 1.1rem;
    bottom: 1.1rem;
    z-index: 50;
    display: grid;
    place-items: center;
    width: 3.1rem;
    height: 3.1rem;
    border-radius: 999px;
    background: #128c7e;
    color: #fff;
    box-shadow: 0 16px 32px -12px rgba(0, 0, 0, 0.5);
    transition: transform 0.35s var(--ease-salida), background-color 0.3s;
  }
  .wa:hover { background: #0e7a6d; transform: translateY(-3px); }
  @media (min-width: 640px) { .wa { right: 1.6rem; bottom: 1.6rem; } }
</style>

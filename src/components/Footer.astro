---
import Icon from './Icon.astro';
import { site, redes, contactos, whatsapp, waMensajes } from '../data/site';
import { categorias } from '../data/catalogo';

const anio = new Date().getFullYear();
---

<footer class="bg-brand-950 text-white/70">
  <div class="container-q py-16 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
      <!-- Marca -->
      <div class="lg:col-span-4">
        <img
          src="/img/logo/qmedical-blanco.webp"
          srcset="/img/logo/qmedical-blanco-1x.webp 1x, /img/logo/qmedical-blanco.webp 2x"
          width="150"
          height="85"
          alt="Q-MEDICAL S.A.C."
          class="h-11 w-auto"
          loading="lazy"
        />
        <p class="mt-6 max-w-sm text-[0.92rem] leading-relaxed">
          Empresa peruana comprometida con la salud del país. Abastecemos a
          instituciones de salud estatales y privadas con dispositivos médicos,
          bioseguridad y protección personal de alta calidad.
        </p>
        <ul class="mt-7 flex gap-2.5">
          {
            redes.map((r) => (
              <li>
                <a
                  href={r.href}
                  target="_blank"
                  rel="noopener"
                  aria-label={r.nombre}
                  class="grid h-10 w-10 place-items-center rounded-full border border-white/15 text-white/70 transition hover:border-white/45 hover:bg-white/10 hover:text-white"
                >
                  <Icon name={r.icono} size={17} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Catálogo -->
      <div class="lg:col-span-3">
        <h2 class="footer-title">Líneas de producto</h2>
        <ul class="mt-5 space-y-2.5 text-[0.88rem]">
          {
            categorias.map((c) => (
              <li>
                <a href={`/catalogo/${c.slug}`} class="footer-link">
                  {c.corto}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Empresa -->
      <div class="lg:col-span-2">
        <h2 class="footer-title">Empresa</h2>
        <ul class="mt-5 space-y-2.5 text-[0.88rem]">
          <li><a href="/nosotros" class="footer-link">Nosotros</a></li>
          <li><a href="/marcas" class="footer-link">Marcas asociadas</a></li>
          <li><a href="/catalogo" class="footer-link">Catálogo</a></li>
          <li><a href="/fichas-tecnicas" class="footer-link">Fichas técnicas</a></li>
          <li><a href="/contacto" class="footer-link">Contacto</a></li>
          <li>
            <a href="/libro-de-reclamaciones" class="footer-link">Libro de reclamaciones</a>
          </li>
        </ul>
      </div>

      <!-- Contacto -->
      <div class="lg:col-span-3">
        <h2 class="footer-title">Contacto</h2>
        <ul class="mt-5 space-y-4 text-[0.88rem]">
          <li class="flex gap-3">
            <Icon name="pin" size={17} class="mt-0.5 shrink-0 text-white/40" />
            <span>
              {site.direccion.calle}<br />{site.direccion.distrito} — {site.direccion.ciudad}, {
                site.direccion.pais
              }
            </span>
          </li>
          <li class="flex gap-3">
            <Icon name="phone" size={17} class="mt-0.5 shrink-0 text-white/40" />
            <span>
              {
                site.telefonos.map((t, i) => (
                  <>
                    {i > 0 && <br />}
                    <a href={t.href} class="footer-link">
                      {t.etiqueta}
                    </a>
                  </>
                ))
              }
            </span>
          </li>
          <li class="flex gap-3">
            <Icon name="mail" size={17} class="mt-0.5 shrink-0 text-white/40" />
            <a href={`mailto:${site.correoPrincipal}`} class="footer-link break-all">
              {site.correoPrincipal}
            </a>
          </li>
          <li class="flex gap-3">
            <Icon name="clock" size={17} class="mt-0.5 shrink-0 text-white/40" />
            <span>{site.horario}</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Correos por área -->
    <details class="mt-14 rounded-xl border border-white/10 bg-white/[0.03]">
      <summary
        class="cursor-pointer list-none px-5 py-4 text-[0.85rem] font-medium text-white/85 transition hover:text-white"
      >
        <span class="inline-flex items-center gap-2">
          <Icon name="mail" size={16} class="text-white/40" />
          Directorio de correos por área
        </span>
      </summary>
      <ul class="grid gap-x-8 gap-y-3 px-5 pb-5 text-[0.82rem] sm:grid-cols-2 lg:grid-cols-3">
        {
          contactos.map((c) => (
            <li>
              <span class="block text-white/40">{c.area}</span>
              <a href={`mailto:${c.correo}`} class="footer-link break-all">
                {c.correo}
              </a>
            </li>
          ))
        }
      </ul>
    </details>
  </div>

  <div class="border-t border-white/10">
    <div
      class="container-q flex flex-col gap-3 py-6 text-[0.78rem] text-white/45 sm:flex-row sm:items-center sm:justify-between"
    >
      <p>© {anio} {site.nombre}. Todos los derechos reservados.</p>
      <p class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <a href="/libro-de-reclamaciones" class="footer-link">Libro de reclamaciones</a>
        <span class="hidden sm:inline text-white/20">·</span>
        <span>Certificación BPA — DIGEMID</span>
      </p>
    </div>
  </div>
</footer>

<!-- Acceso directo a WhatsApp -->
<a
  href={whatsapp(waMensajes.general)}
  target="_blank"
  rel="noopener"
  class="wa-fab"
  aria-label={`Escribir por WhatsApp al ${site.whatsapp.numero}`}
>
  <Icon name="whatsapp" size={26} />
</a>

<style>
  .footer-title {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }
  .footer-link {
    color: rgba(255, 255, 255, 0.72);
    transition: color 0.2s;
  }
  .footer-link:hover { color: #fff; }

  .wa-fab {
    position: fixed;
    right: 1.1rem;
    bottom: 1.1rem;
    z-index: 50;
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 999px;
    background: #128c7e;
    color: #fff;
    box-shadow: 0 14px 30px -10px rgba(0, 0, 0, 0.45);
    transition: transform 0.25s var(--ease-out-quint), background 0.25s;
  }
  .wa-fab:hover { background: #0e7a6d; transform: translateY(-3px) scale(1.04); }
  @media (min-width: 640px) {
    .wa-fab { right: 1.6rem; bottom: 1.6rem; }
  }
</style>

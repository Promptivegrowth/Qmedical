---
import Icon from './Icon.astro';
import { imagenPrincipal, categoriaPorSlug, type Producto } from '../data/catalogo';
import { marcaPorSlug } from '../data/marcas';
import { ruta, type Idioma } from '../i18n/rutas';
import { textos } from '../i18n/textos';
import { categoriaEn, productoEn } from '../i18n/contenido';

/**
 * Entrada de catálogo en registro magazine: la imagen manda, y bajo el filete
 * van el crédito de marca y el título, como el pie de una foto.
 *
 * Sin sumario a propósito. Con él, la retícula era un muro de párrafos
 * cortados a tres líneas que no se leían y le robaban sitio a lo único que
 * se mira al recorrer un catálogo: la foto y el nombre. La descripción vive
 * en la ficha, que es donde alguien ya decidió detenerse.
 */
interface Props {
  lang?: Idioma;
  producto: Producto;
  eager?: boolean;
  mostrarCategoria?: boolean;
}
const { lang = 'es', producto, eager = false, mostrarCategoria = true } = Astro.props;

const t = textos(lang);
const p = productoEn(producto, lang);

const img = imagenPrincipal(p.slug, 900);
const imgSm = imagenPrincipal(p.slug, 480);
/* La marca cuelga de cada presentacion, no del producto. Se acredita solo
   cuando todas coinciden: con dos fabricantes, nombrar uno enganaria. */
const marcasDelProducto = [...new Set(p.presentaciones.map((pr) => pr.marca).filter(Boolean))];
const unica = marcasDelProducto.length === 1 ? p.presentaciones.find((pr) => pr.marca) : undefined;
const marca = unica?.marcaSlug
  ? marcaPorSlug.get(unica.marcaSlug)
  : unica
    ? { nombre: unica.marca, slug: '' }
    : undefined;
const catBase = categoriaPorSlug.get(p.categoria);
const cat = catBase ? categoriaEn(catBase, lang) : undefined;
const href = ruta(lang, 'producto', p.slug);
---

<article class="entrada">
  <a href={href} class="entrada__marco" tabindex="-1" aria-hidden="true">
    {img && (
      <img
        src={imgSm}
        srcset={`${imgSm} 480w, ${img} 900w`}
        sizes="(min-width: 1024px) 22vw, (min-width: 640px) 44vw, 84vw"
        width="480" height="480" alt={p.nombre}
        loading={eager ? 'eager' : 'lazy'} decoding="async" class="entrada__img"
      />
    )}
  </a>

  <div class="entrada__pie">
    <p class="entrada__credito">
      {marca && <span class="text-[var(--color-brand-700)]">{marca.nombre}</span>}
      {/* El punto separa marca y categoría; sin marca no separa nada, y
          quedaba un «·» suelto al principio del renglón. Pasa en los
          productos que se venden bajo más de una marca. */}
      {mostrarCategoria && cat && (
        <span class="opacity-45">{marca ? '· ' : ''}{cat.nombre}</span>
      )}
    </p>

    <h3 class="entrada__titulo">
      <a href={href}>{p.nombre}</a>
    </h3>

    <span class="entrada__accion">
      {t.verProducto}<span class="entrada__flecha"><Icon name="flecha" size={14} /></span>
    </span>
  </div>
</article>

<style>
  .entrada {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .entrada__marco {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--r-md);
    background: #fff;
    border: 1px solid var(--color-linea);
    transition: border-color 0.4s var(--ease-editorial);
  }
  .entrada:hover .entrada__marco { border-color: var(--color-linea-2); }

  .entrada__img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 9%;
    transition: transform 0.8s var(--ease-salida);
  }
  .entrada:hover .entrada__img { transform: scale(1.06); }

  .entrada__sello {
    position: absolute;
    top: 0.85rem;
    left: 0.85rem;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    background: var(--color-papel);
    font-size: 0.63rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-tinta-70);
  }

  .entrada__pie {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding-top: 1.1rem;
  }

  /* Guarda su línea aunque esté vacía. Un producto sin marca asignada no
     imprime crédito, y sin esta altura mínima su título subía y se
     descolgaba del de las entradas vecinas de la misma fila.

     `1lh` es exactamente una línea de este texto, así que sigue al
     interlineado si alguna vez cambia; el valor en em va delante como
     reserva para los navegadores que no conocen la unidad. */
  .entrada__credito {
    min-height: 1.6em;
    min-height: 1lh;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* Mayor que antes: al quitar el sumario, el nombre es lo que queda para
     reconocer el producto, y a 1.12rem competía con el crédito de marca. */
  .entrada__titulo {
    margin-top: 0.6rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.12rem;
    line-height: 1.22;
    letter-spacing: -0.005em;
  }
  /* La tarjeta entera es pulsable, pero el foco vive en el enlace del título */
  .entrada__titulo a::after { content: ''; position: absolute; inset: 0; }

  .entrada__accion {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 1rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-tinta);
  }
  .entrada__flecha { display: inline-flex; transition: transform 0.4s var(--ease-salida); }
  .entrada:hover .entrada__flecha { transform: translateX(4px); }

</style>

---
import Icon from './Icon.astro';
import { categorias, productosDeCategoria, imagenPrincipal, productoPorSlug } from '../data/catalogo';
import { marcaPorSlug } from '../data/marcas';

/**
 * Los cuatro frentes clínicos de Q-MEDICAL, cada uno presentado con un producto
 * real del catálogo en lugar de un icono genérico.
 */
const frentes = [
  {
    slug: 'bioseguridad',
    producto: 'contenedores-punzocortantes',
    titular: 'Del carro de flebotomía al punto de acopio',
    nota: 'Nueve capacidades, de 0.95 L a 30.3 L',
  },
  {
    slug: 'antisepsia',
    producto: 'aplicador-clorhexidina-2',
    titular: 'Clorhexidina en el formato que pide cada procedimiento',
    nota: 'Aplicador, esponja, cepillo y toallita',
  },
  {
    slug: 'laparoscopia',
    producto: 'trocares-desechables',
    titular: 'Acceso seguro a la cavidad, con hoja blindada',
    nota: 'Instrumentos de 5 mm a 15 mm',
  },
  {
    slug: 'nutricion-enteral',
    producto: 'bomba-nutricion-enteral',
    titular: 'La línea completa, de la bomba a la bolsa',
    nota: 'De 1 a 1200 mL/h, con monitoreo central',
  },
].map((f, i) => {
  const categoria = categorias.find((c) => c.slug === f.slug)!;
  const producto = productoPorSlug.get(f.producto)!;
  const items = productosDeCategoria(f.slug);
  return {
    ...f,
    n: String(i + 1).padStart(2, '0'),
    categoria,
    producto,
    total: items.length,
    marcas: [...new Set(items.map((p) => marcaPorSlug.get(p.marca)?.nombre))]
      .filter(Boolean)
      .slice(0, 3) as string[],
  };
});
---

<section class="relative overflow-hidden bg-white py-20 lg:py-28">
  <div class="container-q">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-14">
      <!-- Columna fija con el encabezado -->
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-32">
          <p class="eyebrow">Especialidades</p>
          <h2 class="title-lg mt-4">
            Cuatro frentes donde el insumo correcto cambia el resultado
          </h2>
          <p class="prose-q mt-5">
            Nuestro catálogo está organizado por la realidad del servicio: lo que
            necesita sala de operaciones no es lo que necesita el punto de acopio de
            residuos ni la unidad de nutrición.
          </p>

          <div class="mt-8 hidden lg:block">
            <a href="/catalogo" class="btn btn-outline">
              Ver las {categorias.length} líneas
              <Icon name="arrow" size={15} />
            </a>
          </div>

          <dl class="mt-10 grid grid-cols-2 gap-6 border-t border-line pt-8 lg:gap-7">
            <div>
              <dt class="text-[0.74rem] uppercase tracking-[0.12em] text-muted">Líneas</dt>
              <dd class="font-display text-3xl font-semibold text-brand-700">
                {categorias.length}
              </dd>
            </div>
            <div>
              <dt class="text-[0.74rem] uppercase tracking-[0.12em] text-muted">
                Con ficha técnica
              </dt>
              <dd class="font-display text-3xl font-semibold text-brand-700">49</dd>
            </div>
          </dl>
        </div>
      </div>

      <!-- Los cuatro frentes -->
      <ul class="lg:col-span-8 space-y-4">
        {
          frentes.map((f, i) => (
            <li class="reveal" data-delay={i * 90}>
              <a href={`/catalogo/${f.slug}`} class="frente group">
                <span class="frente__n">{f.n}</span>

                <span class="frente__img-wrap">
                  <img
                    src={imagenPrincipal(f.producto.slug, 480)}
                    width="480"
                    height="480"
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="frente__img"
                  />
                </span>

                <span class="frente__body">
                  <span class="frente__eyebrow">
                    <Icon name={f.categoria.icono} size={14} />
                    {f.categoria.corto}
                    <span class="frente__count">{f.total}</span>
                  </span>

                  <span class="frente__titular">{f.titular}</span>
                  <span class="frente__nota">{f.nota}</span>

                  <span class="frente__pie">
                    <span class="frente__marcas">{f.marcas.join(' · ')}</span>
                    <span class="frente__cta">
                      Ver línea
                      <Icon name="arrow" size={14} class="frente__flecha" />
                    </span>
                  </span>
                </span>
              </a>
            </li>
          ))
        }

        <li class="pt-2 lg:hidden">
          <a href="/catalogo" class="btn btn-outline w-full">
            Ver las {categorias.length} líneas de producto
            <Icon name="arrow" size={15} />
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .frente {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.1rem;
    align-items: center;
    padding: 1.1rem;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 1rem;
    overflow: hidden;
    transition: border-color 0.35s, box-shadow 0.35s, transform 0.35s;
  }
  .frente::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, var(--color-brand-50) 0%, transparent 55%);
    opacity: 0;
    transition: opacity 0.4s var(--ease-out-quint);
  }
  .frente:hover {
    border-color: var(--color-brand-200);
    box-shadow: 0 26px 50px -34px rgba(12, 26, 72, 0.5);
    transform: translateY(-2px);
  }
  .frente:hover::before { opacity: 1; }

  /* Numeración editorial, detrás del contenido */
  .frente__n {
    position: absolute;
    top: 0.5rem;
    right: 1.1rem;
    font-family: var(--font-display);
    font-size: 2.6rem;
    font-weight: 600;
    line-height: 1;
    color: var(--color-brand-50);
    transition: color 0.4s;
    pointer-events: none;
  }
  .frente:hover .frente__n { color: var(--color-brand-100); }

  .frente__img-wrap {
    position: relative;
    display: block;
    width: 6.5rem;
    height: 6.5rem;
    flex: none;
    padding: 0.6rem;
    border-radius: 0.8rem;
    background: radial-gradient(120% 90% at 50% 15%, #eef1fa 0%, var(--color-surface) 72%);
  }
  .frente__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.5s var(--ease-out-quint);
  }
  .frente:hover .frente__img { transform: scale(1.09) rotate(-1.5deg); }

  .frente__body {
    position: relative;
    display: block;
    min-width: 0;
    padding-right: 2.5rem;
  }

  .frente__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brand-700);
  }
  .frente__count {
    display: grid;
    place-items: center;
    min-width: 1.1rem;
    height: 1.1rem;
    padding-inline: 0.28rem;
    border-radius: 999px;
    background: var(--color-brand-50);
    font-size: 0.6rem;
    letter-spacing: 0;
  }

  .frente__titular {
    display: block;
    margin-top: 0.45rem;
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--color-ink);
    text-wrap: balance;
  }
  .frente__nota {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--color-muted);
  }

  .frente__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-top: 0.9rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-line);
  }
  .frente__marcas {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 0.73rem;
    letter-spacing: 0.02em;
    color: #9aa3b2;
  }
  .frente__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    flex: none;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-brand-700);
  }
  .frente__flecha { transition: transform 0.35s var(--ease-out-quint); }
  .frente:hover .frente__flecha { transform: translateX(4px); }

  /* ── Adaptaciones ───────────────────────────────────────────────────── */
  @media (min-width: 640px) {
    .frente { gap: 1.4rem; padding: 1.35rem; }
    .frente__img-wrap { width: 8.5rem; height: 8.5rem; padding: 0.75rem; }
    .frente__titular { font-size: 1.32rem; }
    .frente__n { font-size: 3.2rem; }
  }

  /* En pantallas estrechas la imagen pasa arriba para no comprimir el texto. */
  @media (max-width: 419px) {
    .frente {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
    .frente__img-wrap { width: 100%; height: 7.5rem; padding: 0.5rem; }
    .frente__body { padding-right: 0; }
    /* La imagen pasa a ocupar todo el ancho: el número se encimaría. */
    .frente__n { display: none; }
  }
</style>

---
/**
 * Iconografía de trazo fino, dibujada sobre una retícula de 24 px con un
 * grosor constante de 1.25 px y remates rectos. El registro es el de la
 * referencia: geométrico, discreto, sin relleno; los iconos acompañan al
 * texto, no compiten con él.
 */
interface Props {
  name: string;
  class?: string;
  size?: number;
  /** Grosor del trazo; los iconos grandes piden uno algo menor. */
  stroke?: number;
  /** Dibuja el icono trazo a trazo al entrar en pantalla. */
  anim?: boolean;
}
const { name, class: klass = '', size = 24, stroke = 1.25, anim = false } = Astro.props;

const paths: Record<string, string> = {
  /* ── Líneas de producto ─────────────────────────────────────────────── */
  // Bioseguridad: contenedor con tapa y símbolo de riesgo
  bioseguridad:
    '<path d="M5 8.5h14v10.2a1.8 1.8 0 0 1-1.8 1.8H6.8A1.8 1.8 0 0 1 5 18.7Z"/><path d="M3.6 5.6h16.8v2.9H3.6z"/><circle cx="12" cy="14.2" r="1.5"/><path d="M12 12.7v-1.4M10.7 15l-1.3.7M13.3 15l1.3.7"/>',
  // Antisepsia: gota con onda
  antisepsia:
    '<path d="M12 3.2c3.1 3.4 5 6.1 5 8.6a5 5 0 0 1-10 0c0-2.5 1.9-5.2 5-8.6Z"/><path d="M8.4 13.9c1.1 1 2.1 1 3.2 0s2.1-1 3.2 0"/>',
  // Laparoscopía: trócar / cánula
  laparoscopia:
    '<rect x="9.1" y="2.9" width="5.8" height="4.2" rx="1.1"/><path d="M12 7.1v11.3"/><path d="M10.4 18.4h3.2L12 21.4Z"/><path d="M9.1 5h-3M17.9 5h3"/>',
  // Aspiración: cánister graduado
  aspiracion:
    '<path d="M7.2 7.4h9.6v11.4a2.2 2.2 0 0 1-2.2 2.2H9.4a2.2 2.2 0 0 1-2.2-2.2Z"/><path d="M6.2 4.6h11.6v2.8H6.2z"/><path d="M9.6 11h1.6M9.6 14h1.6M9.6 17h1.6"/>',
  // Nutrición enteral: bolsa con bajada
  nutricion:
    '<path d="M8 3.4h8l-.7 10.3a2.2 2.2 0 0 1-2.2 2H10.9a2.2 2.2 0 0 1-2.2-2Z"/><path d="M12 15.7v2.6a2.2 2.2 0 0 0 2.2 2.2h1.6"/><path d="M8.5 7.4h7"/>',
  // Vía aérea: pantalla con hoja de laringoscopio
  viaAerea:
    '<rect x="7.6" y="2.8" width="8.8" height="6.6" rx="1.4"/><path d="M12 9.4v4.2a4.6 4.6 0 0 1-4.6 4.6H6"/><path d="M6 18.2 7.7 20M6 18.2l1.7-1.8"/>',
  // Higiene del paciente: paño doblado
  higiene:
    '<path d="M3.4 7.6 12 4.2l8.6 3.4-8.6 3.4Z"/><path d="M3.4 12.2 12 15.6l8.6-3.4"/><path d="M3.4 16.6 12 20l8.6-3.4"/>',
  // Absorbentes: capas con gota
  absorbentes:
    '<rect x="3.2" y="9.4" width="17.6" height="4.2" rx="1.2"/><path d="M4.6 15.2h14.8M6 18.4h12"/><path d="M12 3.2c1.5 1.7 2.3 2.9 2.3 4a2.3 2.3 0 0 1-4.6 0c0-1.1.8-2.3 2.3-4Z"/>',
  // Instrumental: bisturí y regla
  instrumental:
    '<path d="M14.6 3.6 20 9l-8.3 8.3-3.9.7.7-3.9Z"/><path d="M3.6 20.4h9.2"/><path d="M5.4 20.4v-1.8M8.2 20.4v-1.8M11 20.4v-1.8"/>',
  // Protección personal: guante
  proteccion:
    '<path d="M7.6 20.6v-4.3l-1.5-2a2 2 0 0 1 3-2.6V5.1a1.5 1.5 0 0 1 3 0V4a1.5 1.5 0 0 1 3 0v1.1a1.5 1.5 0 0 1 3 0v7.4a8 8 0 0 1-1.4 4.5l-1 1.4v2.2Z"/>',

  /* ── Institucional ──────────────────────────────────────────────────── */
  certificado: '<circle cx="12" cy="9.4" r="5.6"/><path d="m9.1 14.2-1.5 6.6 4.4-2.3 4.4 2.3-1.5-6.6"/><path d="m10.2 9.4 1.3 1.3 2.5-2.6"/>',
  almacen: '<path d="M3.4 20.6V8.9l8.6-4.5 8.6 4.5v11.7"/><path d="M3.4 20.6h17.2"/><rect x="8.2" y="12.4" width="7.6" height="8.2"/><path d="M8.2 16.5h7.6"/>',
  entrega: '<path d="M2.8 6.6h11.4v9.8H2.8z"/><path d="M14.2 10h3.6l3.4 3.5v2.9h-7Z"/><circle cx="6.6" cy="18.4" r="2"/><circle cx="17.4" cy="18.4" r="2"/><path d="M8.6 18.4h6.8"/>',
  equipo: '<circle cx="9.2" cy="8" r="3.4"/><path d="M2.9 20.2a6.3 6.3 0 0 1 12.6 0"/><path d="M16.3 4.9a3.4 3.4 0 0 1 0 6.5M17.6 14.7a6.3 6.3 0 0 1 3.5 5.5"/>',
  documento:
    '<path d="M13.5 2.9H7.2a2 2 0 0 0-2 2v14.2a2 2 0 0 0 2 2h9.6a2 2 0 0 0 2-2V8.3Z"/><path d="M13.4 2.9v3.4a2 2 0 0 0 2 2h3.4"/><path d="M8.4 12.6h7.2M8.4 15.8h5"/>',
  descarga: '<path d="M12 3.6v11.2"/><path d="m7.8 10.8 4.2 4.2 4.2-4.2"/><path d="M4.4 19.6h15.2"/>',
  buscar: '<circle cx="11" cy="11" r="7.2"/><path d="m16.4 16.4 4 4"/>',
  // Guiños de la retícula
  reticula: '<rect x="3.4" y="3.4" width="7" height="7"/><rect x="13.6" y="3.4" width="7" height="7"/><rect x="3.4" y="13.6" width="7" height="7"/><rect x="13.6" y="13.6" width="7" height="7"/>',

  /* ── Contacto ───────────────────────────────────────────────────────── */
  correo: '<rect x="2.9" y="4.9" width="18.2" height="14.2" rx="2"/><path d="m3.5 6.7 8.5 5.9 8.5-5.9"/>',
  telefono:
    '<path d="M6.4 3.5h3l1.5 3.8-1.9 1.2a11 11 0 0 0 4.6 4.6l1.2-1.9 3.8 1.5v3a1.8 1.8 0 0 1-2 1.8A15.6 15.6 0 0 1 4.6 5.5a1.8 1.8 0 0 1 1.8-2Z"/>',
  lugar: '<path d="M12 21.4s7-5.6 7-11a7 7 0 1 0-14 0c0 5.4 7 11 7 11Z"/><circle cx="12" cy="10.2" r="2.6"/>',
  reloj: '<circle cx="12" cy="12" r="8.8"/><path d="M12 6.8V12l3.4 2"/>',
  whatsapp:
    '<path d="M3.4 20.6 4.8 16a8.4 8.4 0 1 1 3.3 3.2Z"/><path d="M9 9.2c-.3 1.4 1.6 4.4 3.4 5 .8.3 1.6-.2 1.9-.9l-1.7-1-.7.7c-.9-.4-1.7-1.2-2.1-2.1l.7-.7-1-1.7c-.2 0-.4.3-.5.7Z"/>',
  libro: '<path d="M4 4.6a1.8 1.8 0 0 1 1.8-1.8H19v18.4H5.8A1.8 1.8 0 0 1 4 19.4Z"/><path d="M4 17.6a1.8 1.8 0 0 1 1.8-1.8H19"/>',

  /* ── Interfaz ───────────────────────────────────────────────────────── */
  flecha: '<path d="M4.5 12h15"/><path d="m13.5 6 6 6-6 6"/>',
  flechaDiag: '<path d="M7 17 17 7"/><path d="M8.4 7H17v8.6"/>',
  chevron: '<path d="m9 5.5 6.5 6.5L9 18.5"/>',
  visto: '<path d="m4.8 12.6 4.8 4.8 9.6-10.8"/>',
  menu: '<path d="M3.6 7.4h16.8M3.6 12h16.8M3.6 16.6h16.8"/>',
  cerrar: '<path d="m6 6 12 12M18 6 6 18"/>',
  mas: '<path d="M12 5v14M5 12h14"/>',

  /* ── Redes ──────────────────────────────────────────────────────────── */
  facebook:
    '<path d="M13.5 22v-8.4h2.8l.5-3.3h-3.3V8.2c0-.9.3-1.6 1.7-1.6h1.8V3.6A24 24 0 0 0 14.4 3.4c-2.7 0-4.5 1.6-4.5 4.6v2.3H7v3.3h2.9V22Z" fill="currentColor" stroke="none"/>',
  instagram:
    '<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.1"/><circle cx="17.4" cy="6.6" r="1.15" fill="currentColor" stroke="none"/>',
  linkedin:
    '<path d="M6.9 20.4V9.3H3.4v11.1ZM5.15 7.7a2 2 0 1 0 0-4.1 2 2 0 0 0 0 4.1ZM20.6 20.4v-6.1c0-3.3-1.8-4.8-4.1-4.8a3.6 3.6 0 0 0-3.2 1.8V9.3H9.8v11.1h3.5v-6c0-1.6.8-2.4 2-2.4s1.8.8 1.8 2.4v6Z" fill="currentColor" stroke="none"/>',
  youtube:
    '<path d="M21.4 7.2a2.5 2.5 0 0 0-1.7-1.8C18.2 5 12 5 12 5s-6.2 0-7.7.4A2.5 2.5 0 0 0 2.6 7.2 26 26 0 0 0 2.2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.7 1.8C5.8 19 12 19 12 19s6.2 0 7.7-.4a2.5 2.5 0 0 0 1.7-1.8 26 26 0 0 0 .4-4.8 26 26 0 0 0-.4-4.8Z"/><path d="M10.1 14.9 15.3 12l-5.2-2.9Z" fill="currentColor" stroke="none"/>',
};

let d = paths[name] ?? '';

// Para el trazado animado, cada forma se normaliza a longitud 1: así todas
// se dibujan en el mismo tiempo, sin importar su longitud real.
if (anim) {
  d = d.replace(/<(path|circle|rect|line|polyline|polygon)/g, '<$1 pathLength="1"');
}
---

<svg
  class:list={[klass, anim && "ico-trazo"]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={d}
/>

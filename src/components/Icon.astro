---
/**
 * Iconografía del sitio.
 *
 * Los trazos provienen de Tabler Icons (MIT © Paweł Kuna, tabler.io/icons),
 * copiados a src/icons/ con nombre semántico por scripts/copiar_iconos.py.
 * Aquí solo se envuelven: el <svg> lo escribe este componente, de modo que el
 * grosor, el tamaño y el trazado animado son homogéneos en todo el sitio.
 *
 * Se dibujan a grosor 1.5 sobre la retícula de 24 de Tabler —más fino que su
 * valor por defecto— para que acompañen al texto sin competir con él.
 */
interface Props {
  name: string;
  class?: string;
  size?: number;
  /** Grosor del trazo. Los iconos grandes piden uno menor. */
  stroke?: number;
  /** Dibuja el icono trazo a trazo al entrar en pantalla. */
  anim?: boolean;
}
const { name, class: klass = '', size = 24, stroke = 1.5, anim = false } = Astro.props;

// El contenido se incrusta en la compilación: ni una petición extra.
const trazos = import.meta.glob<string>('../icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const d = trazos[`../icons/${name}.svg`] ?? '';

if (import.meta.env.DEV && !d) {
  console.warn(`[Icon] No existe «${name}». Añádalo al MAPA de scripts/copiar_iconos.py`);
}
---

<svg
  class:list={[klass, anim && 'ico-trazo']}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={d}
/>

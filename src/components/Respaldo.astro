---
import Icon from './Icon.astro';
import { certificaciones } from '../data/site';
import { ruta as via, type Idioma } from '../i18n/rutas';
import { certificacionesEn } from '../i18n/contenido';

/**
 * Certificaciones y acreditaciones.
 *
 * Es la sección que la empresa tomó como referencia de toda la paleta
 * (OBSERVACIONES 3, octubre de 2026) y pidió reproducir «tal cual»: fondo
 * marino con un degradado de eléctrico, titular en versales en dos tonos
 * —blanco y celeste—, un escudo con una frase a la derecha separado por un
 * filete, tres tarjetas de borde celeste con su sello en círculo y una
 * flecha en círculo al pie, y una franja de cierre con los tres valores.
 *
 * Cada tarjeta es un enlace de verdad al certificado en PDF: un comité de
 * compras que llega aquí está comprobando si el proveedor es homologable, y
 * el documento vale más que la declaración.
 *
 * Lo que se mueve es transform u opacity: las tarjetas suben al entrar y al
 * pasar el puntero, y el sello respira con un halo.
 */
interface Props {
  lang?: Idioma;
  /** Ancla de la sección. En /nosotros es a donde apunta el mega-menú. */
  id?: string;
  ante?: string;
  /** El titular en dos tramos: el primero en blanco, el segundo en celeste. */
  titulo?: [string, string];
  /** Párrafo bajo el titular. En nulo, no se pone. */
  texto?: string | null;
  /** La frase que acompaña al escudo. */
  nota?: string;
  /** A dónde lleva una tarjeta que no tenga certificado en PDF. */
  a?: string;
}
const { lang = 'es', id = 'respaldo', ante, titulo, texto, nota, a } = Astro.props;

const T = {
  es: {
    ante: 'Certificaciones y acreditaciones',
    titulo: ['Estándares', 'que nos respaldan'] as [string, string],
    texto:
      'Contamos con certificaciones y acreditaciones internacionales que ' +
      'garantizan la calidad, seguridad y trazabilidad de nuestros productos y ' +
      'procesos.',
    nota: 'Más que cumplimiento, es nuestro compromiso continuo con la salud.',
    emitidaPor: 'Emitida por:',
    valores: ['Calidad', 'Seguridad', 'Confianza'],
    verPdf: (s: string) => `Ver el certificado ${s} (PDF)`,
  },
  en: {
    ante: 'Certifications and accreditations',
    titulo: ['Standards', 'that back us'] as [string, string],
    texto:
      'We hold international certifications and accreditations that guarantee ' +
      'the quality, safety and traceability of our products and processes.',
    nota: 'More than compliance, it is our ongoing commitment to health.',
    emitidaPor: 'Issued by:',
    valores: ['Quality', 'Safety', 'Trust'],
    verPdf: (s: string) => `View the ${s} certificate (PDF)`,
  },
}[lang];

const avales = certificaciones.map((c, i) => ({
  ...c,
  ...(lang === 'en' ? (certificacionesEn[i] ?? {}) : {}),
  n: String(i + 1).padStart(2, '0'),
}));

const destino = a ?? via(lang, 'nosotros', undefined, 'certificaciones');
const [blanco, celeste] = titulo ?? T.titulo;
const parrafo = texto === null ? null : (texto ?? T.texto);
const frase = nota ?? T.nota;
/* Un titular largo —el de /nosotros es una frase entera— no puede ir al
   cuerpo del de la portada: en versales se iba a ocho renglones. */
const largo = (blanco + celeste).length > 34;
---

<section id={id} class="respaldo" data-respaldo>
  <div class="caja relative">
    <div class="respaldo__alto">
      <div class="respaldo__titular" data-anim-grupo="90">
        <p class="ante ante-claro" data-anim="sube">{ante ?? T.ante}</p>
        <h2 class:list={['respaldo__h', largo && 'es-largo']} data-anim="sube">
          <span class="respaldo__h-blanco">{blanco}</span>
          <span class="respaldo__h-celeste">{celeste}</span>
        </h2>
        {parrafo && <p class="respaldo__texto" data-anim="sube">{parrafo}</p>}
      </div>

      <div class="respaldo__lema" data-anim="sube">
        <span class="respaldo__escudo" aria-hidden="true">
          <svg viewBox="0 0 64 72" fill="none" stroke="currentColor" stroke-width="2.4"
            stroke-linecap="round" stroke-linejoin="round">
            <path class="escudo__borde" pathLength="1"
              d="M32 3 L59 13 V35 C59 52 47 63 32 69 C17 63 5 52 5 35 V13 Z" />
            <path class="escudo__visto" pathLength="1" d="M20 37 L29 46 L45 27" />
          </svg>
        </span>
        <p>{frase}</p>
      </div>
    </div>

    <ol class="respaldo__tarjetas" data-anim-grupo="140">
      {avales.map((c) => (
        <li data-anim="sube">
          <a
            href={c.certificado ?? destino}
            class="aval"
            aria-label={c.certificado ? T.verPdf(c.sigla) : undefined}
            {...c.certificado ? { target: '_blank', rel: 'noopener' } : {}}
          >
            <span class="aval__alto">
              <span class="aval__n">{c.n}</span>
              <span class="aval__sello">
                <span class="aval__halo" aria-hidden="true"></span>
                <Icon name={c.icono} size={26} stroke={1.4} anim />
              </span>
            </span>

            <span class="aval__sigla">{c.sigla}</span>
            <span class="aval__nombre">{c.nombre}</span>
            <span class="aval__detalle">{c.detalle}</span>

            <span class="aval__pie">
              <span class="aval__emisor">
                <span class="aval__rotulo">{T.emitidaPor}</span>
                {c.emisor}
              </span>
              <span class="aval__flecha" aria-hidden="true"><Icon name="flecha" size={17} /></span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>

  <!-- Franja de cierre: los tres valores, sobre su propio filete. -->
  <div class="respaldo__franja">
    <div class="caja">
      <p class="respaldo__valores" data-anim="sube">
        <span class="respaldo__raya" aria-hidden="true"></span>
        {T.valores.map((v, i) => (
          <>
            {i > 0 && <span class="respaldo__punto" aria-hidden="true">•</span>}
            <span>{v}</span>
          </>
        ))}
      </p>
    </div>
  </div>
</section>

<style>
  /* ── La banda ─────────────────────────────────────────────────────── */
  .respaldo {
    position: relative;
    overflow: hidden;
    padding-top: 5rem;
    background-color: var(--color-brand-900);
    background-image:
      radial-gradient(60% 55% at 92% 8%, rgb(8 59 128 / 0.95) 0%, rgb(8 59 128 / 0) 72%),
      radial-gradient(45% 40% at 8% 100%, rgb(34 189 242 / 0.08) 0%, rgb(34 189 242 / 0) 70%),
      linear-gradient(180deg, var(--color-brand-900) 0%, #05214f 100%);
    color: #fff;
  }
  @media (min-width: 1024px) { .respaldo { padding-top: 7rem; } }

  /* ── Encabezado ───────────────────────────────────────────────────── */
  .respaldo__alto { display: grid; gap: 2.5rem; }
  @media (min-width: 960px) {
    .respaldo__alto {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 3rem;
      align-items: center;
    }
  }

  /* Versales de palo seco y peso alto, en dos tonos: es lo que da a la
     referencia su aire tecnológico frente a la serifa del resto del sitio. */
  .respaldo__h {
    margin-top: 1.4rem;
    font-family: var(--font-sans);
    font-weight: 800;
    font-size: clamp(2.3rem, 4.7vw, 4.4rem);
    line-height: 0.98;
    letter-spacing: -0.012em;
    text-transform: uppercase;
    text-wrap: balance;
  }
  .respaldo__h.es-largo { font-size: clamp(1.9rem, 3.5vw, 3.2rem); line-height: 1.04; }
  .respaldo__h > span { display: block; }
  .respaldo__h-celeste { color: var(--color-celeste); }

  .respaldo__texto {
    max-width: 34rem;
    margin-top: 1.6rem;
    font-size: clamp(1rem, 1.25vw, 1.18rem);
    line-height: 1.6;
    color: rgb(255 255 255 / 0.9);
  }

  /* El lema: escudo y frase, separados del titular por un filete. */
  .respaldo__lema {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    max-width: 23rem;
    font-size: 1.05rem;
    line-height: 1.55;
    color: rgb(255 255 255 / 0.88);
  }
  @media (min-width: 960px) {
    .respaldo__lema {
      align-self: center;
      padding-left: 3rem;
      border-left: 1px solid rgb(158 219 255 / 0.35);
      min-height: 9.5rem;
    }
  }
  .respaldo__escudo {
    flex: none;
    width: 4.1rem;
    color: var(--color-celeste);
    filter: drop-shadow(0 0 18px rgb(34 189 242 / 0.35));
  }
  .respaldo__escudo svg { display: block; width: 100%; height: auto; }

  /* El escudo se dibuja al entrar: primero el contorno, luego el visto. */
  :global(html.js) .respaldo__escudo path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.3s var(--ease-salida);
  }
  :global(html.js) .respaldo__escudo .escudo__visto { transition-delay: 0.75s; transition-duration: 0.7s; }
  :global(html.js) .respaldo__lema.visible .respaldo__escudo path { stroke-dashoffset: 0; }

  /* ── Las tarjetas ─────────────────────────────────────────────────── */
  .respaldo__tarjetas {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    margin-top: 3.5rem;
  }
  @media (min-width: 760px) {
    .respaldo__tarjetas { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.25rem; }
  }
  @media (min-width: 1024px) { .respaldo__tarjetas { margin-top: 4.5rem; gap: 1.6rem; } }
  .respaldo__tarjetas > li { display: flex; }

  .aval {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 1.6rem 1.6rem 1.4rem;
    border: 1px solid rgb(34 189 242 / 0.45);
    border-radius: 1.1rem;
    background:
      linear-gradient(160deg, rgb(8 59 128 / 0.72) 0%, rgb(6 39 94 / 0.55) 100%);
    box-shadow: inset 0 1px 0 rgb(158 219 255 / 0.12), 0 20px 40px -30px rgb(0 0 0 / 0.6);
    color: #fff;
    transition: transform 0.55s var(--ease-salida), border-color 0.4s var(--ease-editorial),
      box-shadow 0.5s var(--ease-editorial), background-color 0.4s var(--ease-editorial);
  }
  @media (min-width: 1024px) { .aval { padding: 2rem 2rem 1.6rem; } }
  .aval:hover,
  .aval:focus-visible {
    transform: translateY(-6px);
    border-color: var(--color-celeste);
    box-shadow: inset 0 1px 0 rgb(158 219 255 / 0.2), 0 0 0 1px rgb(34 189 242 / 0.25),
      0 30px 60px -30px rgb(34 189 242 / 0.45);
  }

  .aval__alto { display: flex; align-items: flex-start; justify-content: space-between; }
  .aval__n {
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--color-celeste-suave);
  }

  .aval__sello {
    position: relative;
    display: grid;
    place-items: center;
    width: 3.9rem;
    height: 3.9rem;
    flex: none;
    border: 1px solid rgb(34 189 242 / 0.6);
    border-radius: 999px;
    background: rgb(6 39 94 / 0.5);
    color: #fff;
    transition: border-color 0.4s var(--ease-editorial), background-color 0.4s var(--ease-editorial);
  }
  .aval:hover .aval__sello { border-color: var(--color-celeste); background: rgb(34 189 242 / 0.12); }
  .aval__halo {
    position: absolute;
    inset: -1px;
    border: 1px solid var(--color-celeste);
    border-radius: 999px;
    opacity: 0;
  }
  .aval:hover .aval__halo { animation: aval-halo 1.5s var(--ease-salida) infinite; }
  @keyframes aval-halo {
    0% { opacity: 0.6; transform: scale(1); }
    100% { opacity: 0; transform: scale(1.5); }
  }

  .aval__sigla {
    margin-top: 1.6rem;
    font-weight: 800;
    font-size: clamp(2.1rem, 3.4vw, 2.75rem);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .aval__nombre {
    margin-top: 0.7rem;
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-celeste-suave);
  }
  .aval__detalle {
    margin-top: 0.9rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: rgb(255 255 255 / 0.84);
  }

  .aval__pie {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.4rem;
  }
  /* El filete del pie, separado del texto por aire propio: en tarjetas de
     alturas distintas el pie se alinea abajo y el filete con él. */
  .aval__pie { position: relative; }
  .aval__detalle { margin-bottom: 1.6rem; }
  .aval__pie::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1px;
    background: rgb(34 189 242 / 0.35);
  }
  .aval__emisor { font-size: 0.86rem; line-height: 1.45; color: #fff; }
  .aval__rotulo {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-celeste-suave);
  }
  .aval__flecha {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
    border: 1px solid rgb(34 189 242 / 0.6);
    border-radius: 999px;
    color: #fff;
    transition: background-color 0.4s var(--ease-editorial), color 0.4s var(--ease-editorial),
      transform 0.5s var(--ease-salida), border-color 0.4s var(--ease-editorial);
  }
  .aval:hover .aval__flecha {
    background: var(--color-celeste);
    border-color: var(--color-celeste);
    color: var(--color-brand-950);
    transform: translateX(4px);
  }

  /* ── Franja de cierre ─────────────────────────────────────────────── */
  .respaldo__franja {
    margin-top: 4.5rem;
    padding-block: 2.6rem;
    border-top: 1px solid rgb(158 219 255 / 0.16);
    background: linear-gradient(180deg, rgb(4 26 66 / 0) 0%, rgb(4 26 66 / 0.45) 100%);
  }
  @media (min-width: 1024px) { .respaldo__franja { margin-top: 6rem; padding-block: 3.2rem; } }
  .respaldo__valores {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1.4rem;
    font-size: clamp(0.95rem, 1.6vw, 1.35rem);
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--color-celeste-suave);
  }
  .respaldo__raya {
    width: 3.5rem;
    height: 3px;
    margin-right: 1.4rem;
    border-radius: 3px;
    background: var(--color-celeste);
  }
  .respaldo__punto { color: var(--color-celeste); letter-spacing: 0; }
  /* En un teléfono el espaciado de 0.28em partía la franja en dos renglones. */
  @media (max-width: 560px) {
    .respaldo__valores { gap: 0.5rem 0.7rem; letter-spacing: 0.14em; font-size: 0.86rem; }
    .respaldo__raya { width: 1.75rem; margin-right: 0.4rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .aval, .aval__flecha { transition: none; }
    .aval:hover { transform: none; }
    .aval:hover .aval__halo { animation: none; }
    :global(html.js) .respaldo__escudo path { stroke-dashoffset: 0; transition: none; }
  }
</style>

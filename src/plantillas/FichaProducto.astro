---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProductoCard from '../components/ProductoCard.astro';
import CtaContacto from '../components/CtaContacto.astro';
import { site, waMensajes } from '../data/site';
import { marcaPorSlug } from '../data/marcas';
import { fichaDe } from '../data/ficha';
import {
  productos,
  categoriaPorSlug,
  lineaPorSlug,
  imagenesDe,
  imagenDePresentacion,
  productosDeCategoria,
  resumenDe,
  type Producto,
} from '../data/catalogo';

import { ruta as via, type Idioma } from '../i18n/rutas';
import { textos } from '../i18n/textos';
import { categoriaEn, lineaEn, productoEn, waMensajesEn } from '../i18n/contenido';

/**
 * Ficha de producto. La lista de direcciones la declara cada página de
 * entrada; aquí llega el producto en castellano y esta plantilla lo traduce.
 */
interface Props {
  lang?: Idioma;
  producto: Producto;
}
const { lang = 'es', producto: origen } = Astro.props;

const t = textos(lang);
const wa = lang === 'en' ? waMensajesEn : waMensajes;
const p = productoEn(origen, lang);

const cat = categoriaEn(categoriaPorSlug.get(origen.categoria)!, lang);
const linea = lineaEn(lineaPorSlug.get(origen.linea)!, lang);
const resumen = resumenDe(p);   // solo para la metadescripción

/* La marca ya no cuelga del producto sino de cada presentación: un mismo
   producto puede venir de dos fabricantes. Se acredita el conjunto. */
const marcas = [...new Map(
  origen.presentaciones
    .filter((pr) => pr.marca)
    .map((pr) => [pr.marca, { nombre: pr.marca, slug: pr.marcaSlug }])
).values()];
const marca = marcas.length === 1 && marcas[0].slug
  ? marcaPorSlug.get(marcas[0].slug)
  : undefined;

/* Las fotos vienen alineadas con las presentaciones; se filtran los huecos
   para la galería, conservando a qué presentación pertenece cada una. */
/* Sin repetir: cuando una foto sirve a varias presentaciones —las cinco
   hojas de videolaringoscopio comparten la única que entregó la empresa— la
   tira salía con cinco miniaturas idénticas y pulsar cualquiera no cambiaba
   nada. Las medidas de cada una están abajo, en su lámina. */
const imgs = [...new Set(imagenesDe(origen.slug).filter(Boolean))];
const galeria = origen.presentaciones
  .map((pr, i) => ({ pr, src: imagenDePresentacion(origen.slug, i) }))
  .filter((x) => x.src);

/** La ruta de una categoría lleva su línea delante. */
const rutaCategoria = via(lang, 'categoria', `${origen.linea}/${origen.categoria}`);
const rutaLinea = via(lang, 'categoria', origen.linea);

/* Consulta directa por WhatsApp, que es lo que pidió la empresa: el mensaje
   llega con el producto ya escrito para que nadie tenga que explicarlo. */
const waProducto = `https://wa.me/${site.whatsapp.numero.replace(/\D/g, '')}?text=` +
  encodeURIComponent(
    lang === 'en'
      ? `Hello, Q-MEDICAL. I would like more information about ${p.nombre}.`
      : `Hola, Q-MEDICAL. Quisiera más información sobre ${p.nombre}.`
  );
const relacionados = productosDeCategoria(origen.categoria)
  .filter((o) => o.slug !== origen.slug)
  .slice(0, 4);

const enlaceFicha = site.url + via(lang, 'producto', origen.slug);

const T = {
  es: {
    catalogo: 'Catálogo',
    prefiereCorreo: '¿Prefiere el correo?',
    correoEnlace: 'Escríbanos con este producto precargado',
    caracteristicas: 'Características técnicas',
    aplicaciones: 'Aplicaciones',
    presentaciones: 'Presentaciones disponibles',
    presentacionesPie:
      'Cada presentación se cotiza por separado. Indíquenos cuál necesita y la ' +
      'cantidad estimada.',
    unaPresentacion: ' presentación',
    variasPresentaciones: ' presentaciones',
    porWhatsapp: 'Consultar por WhatsApp',
    variasMarcas: 'Disponible de más de un fabricante: ',
    esMarca: 'Marca',
    esUnidad: 'Unidad de venta',
    esCaracteristicas: 'Características',
    esDetalle: 'Detalle',
    ampliar: 'Ampliar la imagen',
    cerrar: 'Cerrar',
    tambienEn: (c: string) => `También en ${c.toLowerCase()}`,
    verLinea: 'Ver la línea completa',
    cta: (n: string) => `¿Necesita cotizar ${n}?`,
    ctaTexto:
      'Indíquenos la cantidad y la institución de destino. Le respondemos con ' +
      'precio, disponibilidad, tiempo de entrega y la documentación técnica que ' +
      'requiera su expediente.',
    asunto: `Cotización — ${p.nombre}`,
    correoCuerpo:
      'Buen día,\n\nSolicito cotización del siguiente producto:\n\n' +
      `Producto: ${p.nombre}\n` +
      (marca ? `Marca: ${marca.nombre}\n` : '') +
      `Ficha: ${enlaceFicha}\n\n` +
      'Cantidad requerida: \nInstitución: \nContacto: \n\nGracias.',
  },
  en: {
    catalogo: 'Catalogue',
    prefiereCorreo: 'Prefer email?',
    correoEnlace: 'Write to us with this product already filled in',
    caracteristicas: 'Technical features',
    aplicaciones: 'Applications',
    presentaciones: 'Available presentations',
    presentacionesPie:
      'Each presentation is quoted separately. Tell us which one you need and ' +
      'the quantity you expect.',
    unaPresentacion: ' presentation',
    variasPresentaciones: ' presentations',
    porWhatsapp: 'Ask on WhatsApp',
    variasMarcas: 'Available from more than one manufacturer: ',
    esMarca: 'Brand',
    esUnidad: 'Sold by',
    esCaracteristicas: 'Features',
    esDetalle: 'Detail',
    ampliar: 'Enlarge the image',
    cerrar: 'Close',
    tambienEn: (c: string) => `More in ${c.toLowerCase()}`,
    verLinea: 'See the whole line',
    cta: (n: string) => `Do you need a quotation for ${n}?`,
    ctaTexto:
      'Tell us the quantity and the receiving institution. We reply with price, ' +
      'availability, lead time and the technical documentation your file ' +
      'requires.',
    asunto: `Quotation — ${p.nombre}`,
    correoCuerpo:
      'Good morning,\n\nI would like a quotation for the following product:\n\n' +
      `Product: ${p.nombre}\n` +
      (marca ? `Brand: ${marca.nombre}\n` : '') +
      `Page: ${enlaceFicha}\n\n` +
      'Quantity required: \nInstitution: \nContact: \n\nThank you.',
  },
}[lang];

const asunto = encodeURIComponent(T.asunto);
const cuerpo = encodeURIComponent(T.correoCuerpo);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: p.nombre,
    description: resumen,
    image: imgs.map((i) => `${site.url}/img/${i}`),
    ...(marca ? { brand: { '@type': 'Brand', name: marca.nombre } } : {}),
    category: cat.nombre,
    url: enlaceFicha,
    // Se publica la presentación, no la referencia del fabricante.
    ...(p.variantes?.length
      ? { model: p.variantes.map((v) => presentacionDe(v).titulo) }
      : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.irInicio, item: site.url + via(lang, 'inicio') },
      { '@type': 'ListItem', position: 2, name: T.catalogo, item: site.url + via(lang, 'catalogo') },
      { '@type': 'ListItem', position: 3, name: cat.nombre, item: site.url + rutaCategoria },
      { '@type': 'ListItem', position: 4, name: p.nombre },
    ],
  },
];
---

<Base
  lang={lang}
  clave="producto"
  slug={origen.slug}
  title={p.nombre}
  description={lang === 'en'
    ? `${resumen} ${marca ? marca.nombre + ' brand.' : ''} Downloadable datasheet and quotations for healthcare institutions in Peru.`
    : `${resumen} ${marca ? 'Marca ' + marca.nombre + '.' : ''} Ficha técnica descargable y cotización para instituciones de salud del Perú.`}
  image={imgs[0] ? `/img/${imgs[0]}` : undefined}
  schema={schema}
>
  <!-- Ruta -->
  <nav aria-label={t.rutaNavegacion} class="migas">
    <div class="caja">
      <ol>
        <li><a href={via(lang, 'inicio')}>{t.irInicio}</a></li>
        <li aria-hidden="true"><Icon name="chevron" size={10} /></li>
        <li><a href={via(lang, 'catalogo')}>{T.catalogo}</a></li>
        <li aria-hidden="true"><Icon name="chevron" size={10} /></li>
        <li><a href={rutaCategoria}>{cat.nombre}</a></li>
        <li aria-hidden="true"><Icon name="chevron" size={10} /></li>
        <li><span>{p.nombre}</span></li>
      </ol>
    </div>
  </nav>

  <!-- ── Apertura de la ficha ────────────────────────────────────────── -->
  <section class="apertura">
    <div class="caja apertura__cuerpo">
      <div class="apertura__galeria min-w-0">
        <!-- El visor amplía: en un contenedor de bioseguridad lo que se
             mira es la etiqueta, y a 900 px no se lee. -->
        <button type="button" id="visor" class="visor" aria-label={T.ampliar}>
          <img
            id="img-principal" src={`/img/${imgs[0]}`} width="900" height="900"
            alt={p.nombre} fetchpriority="high" decoding="async" class="visor__img"
          />
          <span class="visor__lupa" aria-hidden="true"><Icon name="buscar" size={16} /></span>
        </button>

        <dialog id="lupa" class="lupa" aria-label={T.ampliar}>
          <button type="button" class="lupa__cerrar" data-cerrar aria-label={T.cerrar}>
            <Icon name="cerrar" size={20} />
          </button>
          <img id="lupa-img" src={`/img/${imgs[0]}`} alt={p.nombre} class="lupa__img" />
        </dialog>

        {imgs.length > 1 && (
          <ul id="miniaturas" class="no-barra tiras" role="listbox"
            aria-label={lang === 'en' ? 'Product images' : 'Imágenes del producto'}>
            {imgs.map((src, i) => (
              <li>
                <button
                  type="button" class:list={['tira', i === 0 && 'es-activa']}
                  data-src={`/img/${src}`} role="option"
                  aria-selected={i === 0 ? 'true' : 'false'}
                  aria-label={lang === 'en'
                    ? `View image ${i + 1} of ${imgs.length}`
                    : `Ver imagen ${i + 1} de ${imgs.length}`}
                >
                  <img src={`/img/${src.replace('.webp', '-480.webp')}`} width="480" height="480"
                    alt="" loading="lazy" decoding="async" />
                </button>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="apertura__texto min-w-0">
        <p class="credito">
          {/* Sin enlace: la página de marcas ya no tiene fichas por marca
              —la empresa retiró ese directorio en octubre de 2026—, así que
              no hay a dónde llevar. */}
          {marcas.length === 1 && <span class="credito__marca">{marcas[0].nombre}</span>}
          <a href={rutaCategoria} class="credito__cat">
            <Icon name={linea.icono} size={13} />{cat.nombre}
          </a>
        </p>

        <h1 class="display-lg mt-6">{p.nombre}</h1>
        <p class="cuerpo-lg mt-6">{p.descripcion}</p>

        <div class="mt-9 flex flex-wrap gap-3">
          <a href={`${via(lang, 'contacto')}?producto=${origen.slug}#cotizar`} class="pill pill-tinta">
            {t.cotizar}<Icon name="flecha" size={16} />
          </a>
          <!-- La empresa pidio una via directa, sin formulario de por medio. -->
          <a href={waProducto} target="_blank" rel="noopener" class="pill pill-linea">
            <Icon name="whatsapp" size={16} />{T.porWhatsapp}
          </a>
        </div>

        <p class="mt-4 text-[0.8rem] text-[var(--color-tinta-45)]">
          {T.prefiereCorreo}
          <a href={`mailto:${site.correoPrincipal}?subject=${asunto}&body=${cuerpo}`}
            class="underline underline-offset-4">{T.correoEnlace}</a>
        </p>

        {marcas.length > 1 && (
          <p class="mt-6 text-[0.86rem] text-[var(--color-tinta-70)]">
            {T.variasMarcas}<strong>{marcas.map((m) => m.nombre).join(' · ')}</strong>
          </p>
        )}
      </div>
    </div>
  </section>

  <!-- ── Presentaciones y especificaciones ───────────────────────────── -->
  <section class="aire bg-[var(--color-papel-2)]">
    <div class="caja">
      <div class="flex flex-wrap items-end justify-between gap-5">
        <div>
          <h2 class="display-md">{T.presentaciones}</h2>
          <p class="cuerpo mt-3 max-w-xl">{T.presentacionesPie}</p>
        </div>
        <p class="text-[0.82rem] text-[var(--color-tinta-45)]">
          {p.presentaciones.length}
          {p.presentaciones.length === 1 ? T.unaPresentacion : T.variasPresentaciones}
        </p>
      </div>

      <!-- Una lámina por presentación: su foto, lo que la distingue y su
           ficha. Es la forma que pidió la empresa, con el cuadro de
           especificaciones a la vista en vez de escondido en un desplegable. -->
      <ul class="presentaciones" data-anim-grupo="70">
        {p.presentaciones.map((pr, i) => {
          const foto = imagenDePresentacion(origen.slug, i, 480);
          const ficha = fichaDe(pr, {
            marca: T.esMarca, unidad: T.esUnidad, caracteristicas: T.esCaracteristicas, detalle: T.esDetalle,
          });
          return (
            <li class="presentacion" data-anim>
              <div class="presentacion__foto">
                {foto
                  ? <img src={foto} width="480" height="480" loading="lazy" decoding="async"
                      alt={`${p.nombre}${pr.medida ? ' — ' + pr.medida : ''}`} />
                  : <span class="presentacion__sinfoto"><Icon name="reticula" size={22} /></span>}
              </div>

              <div class="presentacion__ficha">
                {ficha.medida && <p class="presentacion__medida">{ficha.medida}</p>}
                <dl class="especificaciones">
                  {ficha.filas.map((f) => (
                    <div><dt>{f.rotulo}</dt><dd>{f.valor}</dd></div>
                  ))}
                </dl>
              </div>
            </li>
          );
        })}
      </ul>
    </div>
  </section>

  <!-- ── Relacionados ────────────────────────────────────────────────── -->
  {relacionados.length > 0 && (
    <section class="aire bg-[var(--color-papel-2)]">
      <div class="caja">
        <div class="flex flex-wrap items-end justify-between gap-5">
          <h2 class="display-md">{T.tambienEn(cat.nombre)}</h2>
          <a href={rutaCategoria} class="enlace">{T.verLinea}<Icon name="flecha" size={15} /></a>
        </div>
        <div class="rejilla-rel mt-10" data-anim-grupo="60">
          {relacionados.map((o) => (
            <div data-anim="sube"><ProductoCard lang={lang} producto={o} mostrarCategoria={false} /></div>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaContacto
    lang={lang}
    titulo={T.cta(p.nombre)}
    texto={T.ctaTexto}
    waMensaje={wa.producto(p.nombre)}
  />
</Base>

<style>
  /* ── Migas ────────────────────────────────────────────────────────── */
  .migas {
    background: var(--color-papel);
    border-bottom: 1px solid var(--color-linea);
    padding-block: 1rem;
  }
  .migas ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.76rem;
    color: var(--color-tinta-45);
  }
  .migas a:hover { color: var(--color-tinta); }
  .migas span { color: var(--color-tinta); }

  /* ── Apertura ─────────────────────────────────────────────────────── */
  .apertura { background: var(--color-papel); padding-block: 3rem 5rem; }
  @media (min-width: 1024px) { .apertura { padding-block: 4rem 7rem; } }
  .apertura__cuerpo { display: grid; gap: 3rem; }
  @media (min-width: 1024px) {
    .apertura__cuerpo { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 5rem; }
  }

  .visor {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--color-linea);
    border-radius: var(--r-lg);
    cursor: zoom-in;
  }
  .visor__img {
    aspect-ratio: 1;
    width: 100%;
    object-fit: contain;
    padding: 10%;
    transition: transform 0.6s var(--ease-salida);
  }
  .visor:hover .visor__img { transform: scale(1.04); }

  .visor__lupa {
    position: absolute;
    right: 0.9rem;
    bottom: 0.9rem;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 999px;
    background: var(--color-papel-2);
    color: var(--color-tinta-70);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s var(--ease-editorial), transform 0.3s var(--ease-salida);
  }
  .visor:is(:hover, :focus-visible) .visor__lupa { opacity: 1; transform: none; }
  /* Donde no hay puntero el aviso se queda a la vista: si no, nada sugiere
     que la imagen se pueda ampliar. */
  @media (hover: none) {
    .visor__lupa { opacity: 1; transform: none; }
  }

  /* ── La imagen ampliada ───────────────────────────────────────────── */
  .lupa {
    /* El <dialog> se centra solo, pero el reinicio de estilos pone
       «margin: 0» en todo y se lo quita. Se le devuelve. */
    margin: auto;
    width: min(94vw, 1100px);
    max-width: none;
    max-height: 92vh;
    padding: 0;
    border: 0;
    border-radius: var(--r-lg);
    background: #fff;
    overflow: hidden;
  }
  .lupa::backdrop { background: rgb(8 12 28 / 0.72); backdrop-filter: blur(2px); }
  .lupa[open] { animation: lupa-entra 0.3s var(--ease-salida); }
  .lupa[open]::backdrop { animation: lupa-vela 0.3s var(--ease-editorial); }
  @keyframes lupa-entra {
    from { opacity: 0; transform: scale(0.97); }
  }
  @keyframes lupa-vela { from { opacity: 0; } }

  .lupa__img {
    display: block;
    width: 100%;
    max-height: 92vh;
    object-fit: contain;
    padding: 2rem;
    cursor: zoom-out;
  }
  .lupa__cerrar {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background: var(--color-papel-2);
    color: var(--color-tinta);
    cursor: pointer;
    transition: background-color 0.25s;
  }
  .lupa__cerrar:hover { background: var(--color-linea); }

  @media (prefers-reduced-motion: reduce) {
    .visor__img, .visor__lupa { transition: none; }
    .visor:hover .visor__img { transform: none; }
    .lupa[open], .lupa[open]::backdrop { animation: none; }
  }

  .tiras { display: flex; gap: 0.7rem; margin-top: 0.9rem; overflow-x: auto; padding-bottom: 0.25rem; }
  .tira {
    display: block;
    width: 4.6rem;
    height: 4.6rem;
    flex: none;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--color-linea);
    border-radius: var(--r-sm);
    transition: border-color 0.25s, box-shadow 0.25s;
  }
  .tira img { width: 100%; height: 100%; object-fit: contain; padding: 0.5rem; }
  .tira:hover { border-color: var(--color-brand-300); }
  .tira.es-activa { border-color: var(--color-brand-700); box-shadow: inset 0 0 0 1px var(--color-brand-700); }

  .credito { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; }
  .credito__marca {
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: var(--color-brand-50);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brand-700);
  }
  .credito__cat {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--color-linea);
    border-radius: 999px;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-tinta-45);
  }
  .credito__cat:hover { border-color: var(--color-brand-300); color: var(--color-brand-700); }

  /* ── Presentaciones ───────────────────────────────────────────────────
     Una lámina por presentación: la foto manda, y debajo el cuadro de
     especificaciones. El cuadro se arma con una lista de definición porque
     eso es lo que es —pares de dato y valor—, y así se lee bien también en
     un lector de pantalla y sin hojas de estilo. */
  .presentaciones {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--medianil);
    margin-top: 2.75rem;
  }
  @media (min-width: 640px) { .presentaciones { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .presentaciones { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .presentacion {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--color-linea);
    border-radius: var(--r-lg);
    transition: border-color 0.35s var(--ease-editorial),
      box-shadow 0.45s var(--ease-editorial);
  }
  .presentacion:hover {
    border-color: var(--color-brand-300);
    box-shadow: 0 24px 46px -30px rgb(8 59 128 / 0.38);
  }

  .presentacion__foto {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    padding: 1.25rem;
    background: var(--color-papel-2);
  }
  .presentacion__foto img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    object-fit: contain;
  }
  .presentacion__sinfoto {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    background: #fff;
    color: var(--color-tinta-45);
  }

  .presentacion__ficha { padding: 1.4rem 1.5rem 1.6rem; }

  .presentacion__medida {
    font-family: var(--font-display);
    font-size: 1.2rem;
    line-height: 1.1;
    letter-spacing: -0.01em;
    font-weight: 800;
    text-transform: uppercase;
  }

  .especificaciones {
    display: grid;
    gap: 0;
    margin-top: 1.1rem;
    border-top: 1px solid var(--color-linea);
    font-size: 0.82rem;
  }
  .especificaciones > div {
    display: grid;
    /* 8.75rem: «CARACTERÍSTICAS», en versales espaciadas, no cabía en 7 y
       se partía en dos renglones. */
    grid-template-columns: minmax(0, 8.75rem) minmax(0, 1fr);
    gap: 0.75rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--color-linea);
  }
  .especificaciones dt {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-tinta-45);
    /* Arriba, no al centro: las características ocupan varios renglones y
       el rótulo centrado quedaba flotando a media altura. */
    align-self: start;
    padding-top: 0.12rem;
  }
  .especificaciones dd {
    margin: 0;
    line-height: 1.45;
    color: var(--color-tinta);
    /* Las características van una por renglón, como las escribió la empresa. */
    white-space: pre-line;
  }

  .presentacion__nota {
    margin-top: 1rem;
    font-size: 0.82rem;
    line-height: 1.6;
    color: var(--color-tinta-70);
  }

  /* En pantallas estrechas el par de dato y valor se apila: con 7rem fijos
     para el rótulo, los valores largos quedaban en una columna de dos letras. */
  @media (max-width: 400px) {
    .especificaciones > div { grid-template-columns: minmax(0, 1fr); gap: 0.15rem; }
  }

  /* ── Técnico ──────────────────────────────────────────────────────── */
  .tecnico { display: grid; gap: 3.5rem; }
  @media (min-width: 1024px) {
    .tecnico { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 5rem; align-items: start; }
  }
  .caracteristicas { display: grid; gap: 0.9rem; margin-top: 2rem; }
  @media (min-width: 640px) { .caracteristicas { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem 2rem; } }
  .caracteristicas li {
    display: flex;
    gap: 0.7rem;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-tinta-70);
  }

  .etiquetas { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .etiquetas li {
    padding: 0.5rem 0.95rem;
    background: #fff;
    border: 1px solid var(--color-linea);
    border-radius: 999px;
    font-size: 0.82rem;
    color: var(--color-tinta-70);
  }

  /* ── Presentaciones ───────────────────────────────────────────────
     Antes era una tabla encabezada por la referencia del fabricante: quien
     compra no elige por «MA1331», elige por «11.4 litros». Ahora manda la
     medida y la referencia no aparece.                                   */
  .presentaciones {
    display: grid;
    border-top: 1px solid var(--color-linea);
  }
  .presentaciones__fila {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    /* Sin enlace de descarga ya no hay tercer elemento: la nota acompaña al
       rótulo en vez de irse al filo opuesto. */
    gap: 0.35rem 0.9rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-linea);
  }
  .presentaciones__titulo {
    font-family: var(--font-display-texto);
    font-size: 1.1rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-tinta);
  }
  .presentaciones__nota {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--color-tinta-70);
  }

  /* ── Fichas ───────────────────────────────────────────────────────── */

  .rejilla-rel { display: grid; grid-template-columns: repeat(1, minmax(0, 1fr)); gap: 2.5rem 1.75rem; }
  @media (min-width: 640px) { .rejilla-rel { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .rejilla-rel { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>

<script>
  const principal = document.getElementById('img-principal') as HTMLImageElement | null;
  const lista = document.getElementById('miniaturas');

  lista?.addEventListener('click', (ev) => {
    const boton = (ev.target as HTMLElement).closest<HTMLButtonElement>('.tira');
    if (!boton || !principal) return;
    principal.src = boton.dataset.src ?? principal.src;
    lista.querySelectorAll('.tira').forEach((b) => {
      const activo = b === boton;
      b.classList.toggle('es-activa', activo);
      b.setAttribute('aria-selected', String(activo));
    });
  });

  /* Ampliar la imagen. Va en un <dialog>, que trae puesto lo que en una
     ventana hecha a mano hay que escribir: el fondo inerte, el foco
     atrapado dentro y la tecla Escape. */
  const visor = document.getElementById('visor');
  const lupa = document.getElementById('lupa') as HTMLDialogElement | null;
  const lupaImg = document.getElementById('lupa-img') as HTMLImageElement | null;

  visor?.addEventListener('click', () => {
    if (!lupa || !lupaImg || !principal) return;
    lupaImg.src = principal.src;
    lupa.showModal();
  });

  lupa?.addEventListener('click', (ev) => {
    // Pulsar fuera de la imagen cierra; el <dialog> ocupa toda la pantalla
    const dentro = (ev.target as HTMLElement).closest('.lupa__img');
    if (!dentro || (ev.target as HTMLElement).closest('[data-cerrar]')) lupa.close();
  });
</script>

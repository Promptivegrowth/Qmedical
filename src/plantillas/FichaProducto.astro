---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ProductoCard from '../components/ProductoCard.astro';
import CtaContacto from '../components/CtaContacto.astro';
import { site, waMensajes } from '../data/site';
import { marcaPorSlug } from '../data/marcas';
import {
  productos,
  categoriaPorSlug,
  imagenesDe,
  fichasDe,
  fichasIndex,
  productosDeCategoria,
  type Producto,
} from '../data/catalogo';

import { ruta as via, type Idioma } from '../i18n/rutas';
import { textos } from '../i18n/textos';
import { categoriaEn, productoEn, waMensajesEn } from '../i18n/contenido';

/**
 * Ficha de producto. La lista de direcciones la declara cada página de
 * entrada; aquí llega el producto en castellano y esta plantilla lo traduce.
 *
 * Las fichas técnicas en PDF son las que emite el fabricante, redactadas en
 * castellano. La versión en inglés lo advierte junto a la descarga en lugar
 * de dar a entender que existe una traducción.
 */
interface Props {
  lang?: Idioma;
  producto: Producto;
}
const { lang = 'es', producto: origen } = Astro.props;

const t = textos(lang);
const wa = lang === 'en' ? waMensajesEn : waMensajes;
const p = productoEn(origen, lang);

const cat = categoriaEn(categoriaPorSlug.get(origen.categoria)!, lang);
const marca = marcaPorSlug.get(origen.marca);
const imgs = imagenesDe(origen.slug);
const fichas = fichasDe(origen.slug);
const relacionados = productosDeCategoria(origen.categoria)
  .filter((o) => o.slug !== origen.slug)
  .slice(0, 4);

const enlaceFicha = site.url + via(lang, 'producto', origen.slug);

const T = {
  es: {
    catalogo: 'Catálogo',
    fichasBoton: (n: number) => (n === 1 ? 'Ficha técnica' : `Fichas técnicas (${n})`),
    prefiereCorreo: '¿Prefiere el correo?',
    correoEnlace: 'Escríbanos con este producto precargado',
    caracteristicas: 'Características técnicas',
    aplicaciones: 'Aplicaciones',
    presentaciones: 'Presentaciones y códigos',
    ficha: 'Ficha',
    descargarFicha: (c: string) => `Descargar ficha técnica ${c}`,
    documentacion: 'Documentación',
    fichasTitulo: 'Fichas técnicas descargables',
    fichasTexto:
      'Documentación oficial del fabricante en PDF, lista para adjuntar a un ' +
      'requerimiento interno o a un expediente de licitación.',
    tambienEn: (c: string) => `También en ${c.toLowerCase()}`,
    verLinea: 'Ver la línea completa',
    cta: (n: string) => `¿Necesita cotizar ${n}?`,
    ctaTexto:
      'Indíquenos la cantidad y la institución de destino. Le respondemos con ' +
      'precio, disponibilidad, tiempo de entrega y la documentación técnica que ' +
      'requiera su expediente.',
    asunto: `Cotización — ${p.nombre}`,
    correoCuerpo:
      'Buen día,\n\nSolicito cotización del siguiente producto:\n\n' +
      `Producto: ${p.nombre}\n` +
      (marca ? `Marca: ${marca.nombre}\n` : '') +
      `Ficha: ${enlaceFicha}\n\n` +
      'Cantidad requerida: \nInstitución: \nContacto: \n\nGracias.',
  },
  en: {
    catalogo: 'Catalogue',
    fichasBoton: (n: number) => (n === 1 ? 'Datasheet' : `Datasheets (${n})`),
    prefiereCorreo: 'Prefer email?',
    correoEnlace: 'Write to us with this product already filled in',
    caracteristicas: 'Technical features',
    aplicaciones: 'Applications',
    presentaciones: 'Presentations and codes',
    ficha: 'Sheet',
    descargarFicha: (c: string) => `Download datasheet ${c}`,
    documentacion: 'Documentation',
    fichasTitulo: 'Downloadable datasheets',
    fichasTexto:
      'Official manufacturer documentation in PDF, ready to attach to an ' +
      'internal requisition or a tender file. These documents are issued by ' +
      'the manufacturer in Spanish.',
    tambienEn: (c: string) => `More in ${c.toLowerCase()}`,
    verLinea: 'See the whole line',
    cta: (n: string) => `Do you need a quotation for ${n}?`,
    ctaTexto:
      'Tell us the quantity and the receiving institution. We reply with price, ' +
      'availability, lead time and the technical documentation your file ' +
      'requires.',
    asunto: `Quotation — ${p.nombre}`,
    correoCuerpo:
      'Good morning,\n\nI would like a quotation for the following product:\n\n' +
      `Product: ${p.nombre}\n` +
      (marca ? `Brand: ${marca.nombre}\n` : '') +
      `Page: ${enlaceFicha}\n\n` +
      'Quantity required: \nInstitution: \nContact: \n\nThank you.',
  },
}[lang];

const asunto = encodeURIComponent(T.asunto);
const cuerpo = encodeURIComponent(T.correoCuerpo);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: p.nombre,
    description: p.resumen,
    image: imgs.map((i) => `${site.url}/img/${i}`),
    brand: { '@type': 'Brand', name: marca?.nombre ?? 'Q-MEDICAL' },
    category: cat.nombre,
    url: enlaceFicha,
    ...(p.variantes?.length ? { model: p.variantes.map((v) => v.codigo) } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t.irInicio, item: site.url + via(lang, 'inicio') },
      { '@type': 'ListItem', position: 2, name: T.catalogo, item: site.url + via(lang, 'catalogo') },
      { '@type': 'ListItem', position: 3, name: cat.corto, item: site.url + via(lang, 'categoria', cat.slug) },
      { '@type': 'ListItem', position: 4, name: p.nombre },
    ],
  },
];
---

<Base
  lang={lang}
  clave="producto"
  slug={origen.slug}
  title={p.nombre}
  description={lang === 'en'
    ? `${p.resumen} ${marca ? marca.nombre + ' brand.' : ''} Downloadable datasheet and quotations for healthcare institutions in Peru.`
    : `${p.resumen} ${marca ? 'Marca ' + marca.nombre + '.' : ''} Ficha técnica descargable y cotización para instituciones de salud del Perú.`}
  image={imgs[0] ? `/img/${imgs[0]}` : undefined}
  schema={schema}
>
  <!-- Ruta -->
  <nav aria-label={t.rutaNavegacion} class="migas">
    <div class="caja">
      <ol>
        <li><a href={via(lang, 'inicio')}>{t.irInicio}</a></li>
        <li aria-hidden="true"><Icon name="chevron" size={10} /></li>
        <li><a href={via(lang, 'catalogo')}>{T.catalogo}</a></li>
        <li aria-hidden="true"><Icon name="chevron" size={10} /></li>
        <li><a href={via(lang, 'categoria', cat.slug)}>{cat.corto}</a></li>
        <li aria-hidden="true"><Icon name="chevron" size={10} /></li>
        <li><span>{p.nombre}</span></li>
      </ol>
    </div>
  </nav>

  <!-- ── Apertura de la ficha ────────────────────────────────────────── -->
  <section class="apertura">
    <div class="caja apertura__cuerpo">
      <div class="apertura__galeria min-w-0">
        <div class="visor">
          <img
            id="img-principal" src={`/img/${imgs[0]}`} width="900" height="900"
            alt={p.nombre} fetchpriority="high" decoding="async" class="visor__img"
          />
        </div>

        {imgs.length > 1 && (
          <ul id="miniaturas" class="no-barra tiras" role="listbox"
            aria-label={lang === 'en' ? 'Product images' : 'Imágenes del producto'}>
            {imgs.map((src, i) => (
              <li>
                <button
                  type="button" class:list={['tira', i === 0 && 'es-activa']}
                  data-src={`/img/${src}`} role="option"
                  aria-selected={i === 0 ? 'true' : 'false'}
                  aria-label={lang === 'en'
                    ? `View image ${i + 1} of ${imgs.length}`
                    : `Ver imagen ${i + 1} de ${imgs.length}`}
                >
                  <img src={`/img/${src.replace('.webp', '-480.webp')}`} width="480" height="480"
                    alt="" loading="lazy" decoding="async" />
                </button>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="apertura__texto min-w-0">
        <p class="credito">
          {marca && <a href={via(lang, 'marcas') + '#' + marca.slug} class="credito__marca">{marca.nombre}</a>}
          <a href={via(lang, 'categoria', cat.slug)} class="credito__cat">
            <Icon name={cat.icono} size={13} />{cat.corto}
          </a>
        </p>

        <h1 class="display-lg mt-6">{p.nombre}</h1>
        <p class="cuerpo-lg mt-6">{p.resumen}</p>

        <div class="mt-9 flex flex-wrap gap-3">
          <a href={`${via(lang, 'contacto')}?producto=${origen.slug}#cotizar`} class="pill pill-tinta">
            {t.cotizar}<Icon name="flecha" size={16} />
          </a>
          {fichas.length > 0 && (
            <a href="#fichas" class="pill pill-linea">
              <Icon name="descarga" size={16} />
              {T.fichasBoton(fichas.length)}
            </a>
          )}
        </div>

        <p class="mt-4 text-[0.8rem] text-[var(--color-tinta-45)]">
          {T.prefiereCorreo}
          <a href={`mailto:${site.correoPrincipal}?subject=${asunto}&body=${cuerpo}`}
            class="underline underline-offset-4">{T.correoEnlace}</a>
        </p>

        <div class="cuerpo mt-10 border-t border-[var(--color-linea)] pt-9">
          {p.descripcion.map((d) => <p>{d}</p>)}
        </div>

        {p.presentacion && (
          <div class="presentacion">
            <p class="ante">{t.producto.presentacion}</p>
            <p class="mt-2 text-[0.92rem] leading-relaxed">{p.presentacion}</p>
          </div>
        )}
      </div>
    </div>
  </section>

  <!-- ── Características y códigos ───────────────────────────────────── -->
  <section class="aire bg-[var(--color-papel-2)]">
    <div class="caja tecnico">
      <div class="min-w-0">
        <h2 class="display-md">{T.caracteristicas}</h2>
        <ul class="caracteristicas" data-anim-grupo="35">
          {p.caracteristicas.map((c) => (
            <li data-anim="sube"><Icon name="visto" size={15} class="mt-[0.35rem] shrink-0 text-[var(--color-brand-700)]" /><span>{c}</span></li>
          ))}
        </ul>

        {p.usos && (
          <div class="mt-12">
            <h2 class="display-md">{T.aplicaciones}</h2>
            <ul class="etiquetas mt-6">
              {p.usos.map((u) => <li>{u}</li>)}
            </ul>
          </div>
        )}
      </div>

      {p.variantes && (
        <div class="min-w-0">
          <h2 class="display-md">{T.presentaciones}</h2>
          <div class="tabla-marco mt-6">
            <table class="tabla">
              <thead>
                <tr>
                  <th scope="col">{t.producto.codigo}</th>
                  <th scope="col">{t.producto.detalle}</th>
                  {fichas.length > 1 && <th scope="col">{T.ficha}</th>}
                </tr>
              </thead>
              <tbody>
                {p.variantes.map((v) => (
                  <tr>
                    <th scope="row">{v.codigo}</th>
                    <td>{v.detalle}</td>
                    {fichas.length > 1 && (
                      <td>
                        {v.ficha && fichasIndex[v.ficha] ? (
                          <a href={fichasIndex[v.ficha].archivo} download class="tabla__pdf"
                            aria-label={T.descargarFicha(v.codigo)}>
                            <Icon name="documento" size={14} />PDF
                          </a>
                        ) : (<span class="opacity-35">—</span>)}
                      </td>
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- ── Fichas técnicas ─────────────────────────────────────────────── -->
  {fichas.length > 0 && (
    <section id="fichas" class="aire scroll-mt-24 bg-[var(--color-papel)]">
      <div class="caja">
        <p class="ante ante-brand">{T.documentacion}</p>
        <h2 class="display-md mt-4 max-w-[20ch]">{T.fichasTitulo}</h2>
        <p class="cuerpo mt-5 max-w-2xl">{T.fichasTexto}</p>

        <ul class="fichas" data-anim-grupo="50">
          {fichas.map((f) => (
            <li data-anim="sube">
              <a href={f.archivo} download class="ficha-item">
                <span class="ficha-item__ic"><Icon name="documento" size={19} /></span>
                <span class="min-w-0 flex-1">
                  <span class="block text-[0.93rem] leading-snug">{f.titulo}</span>
                  <span class="mt-1 block text-[0.75rem] text-[var(--color-tinta-45)]">PDF · {f.peso} KB</span>
                </span>
                <Icon name="descarga" size={17} class="shrink-0 opacity-40" />
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- ── Relacionados ────────────────────────────────────────────────── -->
  {relacionados.length > 0 && (
    <section class="aire bg-[var(--color-papel-2)]">
      <div class="caja">
        <div class="flex flex-wrap items-end justify-between gap-5">
          <h2 class="display-md">{T.tambienEn(cat.corto)}</h2>
          <a href={via(lang, 'categoria', cat.slug)} class="enlace">{T.verLinea}<Icon name="flecha" size={15} /></a>
        </div>
        <div class="rejilla-rel mt-10" data-anim-grupo="60">
          {relacionados.map((o) => (
            <div data-anim="sube"><ProductoCard lang={lang} producto={o} mostrarCategoria={false} /></div>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaContacto
    lang={lang}
    titulo={T.cta(p.nombre)}
    texto={T.ctaTexto}
    waMensaje={wa.producto(p.nombre, p.variantes?.[0]?.codigo)}
  />
</Base>

<style>
  /* ── Migas ────────────────────────────────────────────────────────── */
  .migas {
    background: var(--color-papel);
    border-bottom: 1px solid var(--color-linea);
    padding-block: 1rem;
  }
  .migas ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.76rem;
    color: var(--color-tinta-45);
  }
  .migas a:hover { color: var(--color-tinta); }
  .migas span { color: var(--color-tinta); }

  /* ── Apertura ─────────────────────────────────────────────────────── */
  .apertura { background: var(--color-papel); padding-block: 3rem 5rem; }
  @media (min-width: 1024px) { .apertura { padding-block: 4rem 7rem; } }
  .apertura__cuerpo { display: grid; gap: 3rem; }
  @media (min-width: 1024px) {
    .apertura__cuerpo { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 5rem; }
  }

  .visor {
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--color-linea);
    border-radius: var(--r-lg);
  }
  .visor__img { aspect-ratio: 1; width: 100%; object-fit: contain; padding: 10%; }

  .tiras { display: flex; gap: 0.7rem; margin-top: 0.9rem; overflow-x: auto; padding-bottom: 0.25rem; }
  .tira {
    display: block;
    width: 4.6rem;
    height: 4.6rem;
    flex: none;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--color-linea);
    border-radius: var(--r-sm);
    transition: border-color 0.25s, box-shadow 0.25s;
  }
  .tira img { width: 100%; height: 100%; object-fit: contain; padding: 0.5rem; }
  .tira:hover { border-color: var(--color-brand-300); }
  .tira.es-activa { border-color: var(--color-brand-700); box-shadow: inset 0 0 0 1px var(--color-brand-700); }

  .credito { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem; }
  .credito__marca {
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: var(--color-brand-50);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brand-700);
  }
  .credito__cat {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--color-linea);
    border-radius: 999px;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-tinta-45);
  }
  .credito__cat:hover { border-color: var(--color-brand-300); color: var(--color-brand-700); }

  .presentacion {
    margin-top: 2rem;
    padding: 1.35rem 1.5rem;
    background: var(--color-papel-2);
    border-radius: var(--r-md);
  }

  /* ── Técnico ──────────────────────────────────────────────────────── */
  .tecnico { display: grid; gap: 3.5rem; }
  @media (min-width: 1024px) {
    .tecnico { grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 5rem; align-items: start; }
  }
  .caracteristicas { display: grid; gap: 0.9rem; margin-top: 2rem; }
  @media (min-width: 640px) { .caracteristicas { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.9rem 2rem; } }
  .caracteristicas li {
    display: flex;
    gap: 0.7rem;
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-tinta-70);
  }

  .etiquetas { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .etiquetas li {
    padding: 0.5rem 0.95rem;
    background: #fff;
    border: 1px solid var(--color-linea);
    border-radius: 999px;
    font-size: 0.82rem;
    color: var(--color-tinta-70);
  }

  .tabla-marco {
    overflow-x: auto;
    background: #fff;
    border: 1px solid var(--color-linea);
    border-radius: var(--r-md);
  }
  .tabla { width: 100%; min-width: 19rem; text-align: left; font-size: 0.875rem; }
  .tabla thead tr { border-bottom: 1px solid var(--color-linea); }
  .tabla th[scope='col'] {
    padding: 0.85rem 1.15rem;
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-tinta-45);
  }
  .tabla tbody tr + tr { border-top: 1px solid var(--color-linea); }
  .tabla th[scope='row'] {
    padding: 0.95rem 1.15rem;
    white-space: nowrap;
    font-weight: 500;
    color: var(--color-brand-700);
    vertical-align: top;
  }
  .tabla td { padding: 0.95rem 1.15rem; color: var(--color-tinta-70); vertical-align: top; line-height: 1.5; }
  .tabla__pdf { display: inline-flex; align-items: center; gap: 0.3rem; color: var(--color-brand-700); }
  .tabla__pdf:hover { text-decoration: underline; text-underline-offset: 3px; }

  /* ── Fichas ───────────────────────────────────────────────────────── */
  .fichas { display: grid; gap: 0.7rem; margin-top: 2.5rem; }
  @media (min-width: 768px) { .fichas { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .ficha-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
    padding: 1.1rem 1.25rem;
    background: #fff;
    border: 1px solid var(--color-linea);
    border-radius: var(--r-md);
    transition: border-color 0.3s, transform 0.4s var(--ease-salida);
  }
  .ficha-item:hover { border-color: var(--color-brand-300); transform: translateY(-2px); }
  .ficha-item__ic {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    flex: none;
    border-radius: 999px;
    border: 1px solid var(--color-linea);
    color: var(--color-brand-700);
    transition: background-color 0.3s, color 0.3s, border-color 0.3s;
  }
  .ficha-item:hover .ficha-item__ic {
    background: var(--color-brand-700);
    border-color: var(--color-brand-700);
    color: #fff;
  }

  .rejilla-rel { display: grid; grid-template-columns: repeat(1, minmax(0, 1fr)); gap: 2.5rem 1.75rem; }
  @media (min-width: 640px) { .rejilla-rel { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .rejilla-rel { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>

<script>
  const principal = document.getElementById('img-principal') as HTMLImageElement | null;
  const lista = document.getElementById('miniaturas');

  lista?.addEventListener('click', (ev) => {
    const boton = (ev.target as HTMLElement).closest<HTMLButtonElement>('.tira');
    if (!boton || !principal) return;
    principal.src = boton.dataset.src ?? principal.src;
    lista.querySelectorAll('.tira').forEach((b) => {
      const activo = b === boton;
      b.classList.toggle('es-activa', activo);
      b.setAttribute('aria-selected', String(activo));
    });
  });
</script>

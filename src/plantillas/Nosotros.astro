---
import Base from '../layouts/Base.astro';
import Portada from '../components/Portada.astro';
import Icon from '../components/Icon.astro';
import CtaContacto from '../components/CtaContacto.astro';
import Respaldo from '../components/Respaldo.astro';
import Clientes from '../components/Clientes.astro';
import { site, valores } from '../data/site';
import { marcas } from '../data/marcas';
import { lineas, productos } from '../data/catalogo';
import { ruta as via, type Idioma } from '../i18n/rutas';
import { valoresEn } from '../i18n/contenido';

interface Props {
  lang?: Idioma;
}
const { lang = 'es' } = Astro.props;

const FOTOS = [
  { src: 'almacen-racks-1', ancho: true },
  { src: 'almacen-pasillo-3' },
  { src: 'almacen-venezuela-3-limpia' },
  { src: 'almacen-venezuela-1' },
  { src: 'almacen-venezuela-2' },
];

const T = {
  es: {
    meta: `Nosotros — ${site.anios} años abasteciendo al sector salud del Perú`,
    metaDesc:
      'Q-MEDICAL S.A.C. es una droguería peruana fundada en 2003, certificada en ' +
      'Buenas Prácticas de Almacenamiento por DIGEMID, ISO 37001 e ISO 14001. ' +
      'Conozca nuestra misión, infraestructura y certificaciones.',
    ante: `Desde ${site.fundacion} · ${site.anios} años`,
    titulo: 'Una empresa peruana comprometida con la salud del país',
    bajada:
      'Trabajamos para que las instituciones de salud estatales y privadas ' +
      'dispongan de productos médicos, de bioseguridad y de protección personal ' +
      'de alta calidad, junto a nuestros proveedores alrededor del mundo.',
    miga: 'Nosotros',
    dato: 'años de operación',
    cifras: [
      { v: site.fundacion, e: 'Año de fundación', n: 'Más de dos décadas en el sector', anio: true },
      { v: marcas.length, e: 'Marcas representadas', n: 'Fabricantes de todo el mundo' },
      { v: productos.length, e: 'Productos en catálogo', n: `En ${lineas.length} líneas` },
    ],
    quienesAnte: 'Quiénes somos',
    quienesTitulo: 'Su aliado estratégico en insumos y dispositivos médicos',
    quienesEntrada:
      'Q-MEDICAL S.A.C.: más de 20 años asegurando el abastecimiento del sector ' +
      'salud en el Perú.',
    quienesTexto:
      'Somos una empresa peruana especializada en la comercialización y ' +
      'distribución de dispositivos médicos, insumos hospitalarios, productos de ' +
      `bioseguridad y equipos de protección personal. Desde el año ${site.fundacion}, ` +
      'acompañamos a hospitales, clínicas, laboratorios e instituciones de salud ' +
      'en todo el país.',
    portafolioRotulo: 'Ofrecemos un portafolio integral de soluciones para:',
    portafolio: [
      { i: 'bioseguridad', f: 'bioseguridad', t: 'Bioseguridad y protección personal' },
      { i: 'laparoscopia', f: 'cirugia-laparoscopica', t: 'Cirugía laparoscópica' },
      { i: 'aspiracion', f: 'anestesiologia', t: 'Aspiración y manejo de la vía aérea' },
      { i: 'antisepsia', f: 'antisepsia', t: 'Antisepsia e higiene del paciente' },
      { i: 'nutricion', f: 'nutricion-enteral', t: 'Nutrición enteral y parenteral' },
      { i: 'instrumental', f: 'enfermeria', t: 'Material médico no instrumental' },
    ],
    quienesCierre: [
      'Más que productos, entregamos confianza, respaldo y trazabilidad. Cada ' +
        'solución llega con documentación técnica, soporte especializado y una ' +
        'atención personalizada, para que su institución opere con seguridad, ' +
        'eficiencia y continuidad.',
      'Atendemos compras directas y procesos de licitación pública y privada, ' +
        'con un equipo profesional comprometido en responder con rapidez, ' +
        'precisión y soluciones a la medida del sector salud.',
    ],
    infraAnte: 'Infraestructura',
    infraTitulo: 'Capacidad operativa que responde cuando la salud lo necesita',
    infraTexto:
      'Q-MEDICAL cuenta con tres almacenes estratégicamente ubicados en Lima, ' +
      'que cumplen con las exigencias de DIGEMID para el adecuado almacenamiento ' +
      'y conservación de dispositivos médicos.',
    infraCierre: 'Más capacidad logística, entregas oportunas y confianza para el sector salud.',
    almacenes: [
      { n: 'Almacén 01', d: 'Av. Arica 1442 — Breña' },
      { n: 'Almacén 02', d: 'Jr. Napo 940 — Breña' },
      { n: 'Almacén 03', d: 'Av. Venezuela 1684 — Breña' },
    ],
    controles: [
      { ic: 'documento', t: 'Recepción', d: 'Verificación documental y de integridad de empaque antes de ingresar cualquier lote.' },
      { ic: 'almacen', t: 'Almacenamiento', d: 'Segregado y rotulado por lote y fecha de vencimiento, en racks identificados.' },
      { ic: 'reloj', t: 'Rotación', d: 'Bajo criterio de primero en vencer, primero en salir, sin excepciones.' },
      { ic: 'buscar', t: 'Trazabilidad', d: 'Registro que permite rastrear cualquier unidad desde la recepción hasta el despacho.' },
    ],
    fotos: [
      'Racks del almacén central de Q-MEDICAL, con producto rotulado por lote',
      'Pasillo entre racks, con producto rotulado por lote',
      'Carga paletizada en el almacén de la avenida Venezuela',
      'Zona de acopio con producto paletizado y señalización de piso',
      'Pasillo entre pallets en el almacén de la avenida Venezuela',
    ],
    certifAnte: 'Certificaciones y acreditaciones',
    certifTitulo:
      'Calidad que impulsa la mejora continua en todos los eslabones de la ' +
      'cadena de suministro',
    certifNota:
      'La excelencia no se improvisa: se construye en cada etapa y se respalda ' +
      'con certificaciones y acreditaciones internacionales que garantizan ' +
      'calidad, confianza y compromiso con el sector salud.',
  },
  en: {
    meta: `About us — ${site.anios} years supplying Peru’s health sector`,
    metaDesc:
      'Q-MEDICAL S.A.C. is a Peruvian drugstore founded in 2003, certified in Good ' +
      'Storage Practices (BPA) by DIGEMID, ISO 37001 and ISO 14001. Learn about our ' +
      'mission, facilities and certifications.',
    ante: `Since ${site.fundacion} · ${site.anios} years`,
    titulo: 'A Peruvian company committed to the health of the country',
    bajada:
      'We work so that public and private healthcare institutions have ' +
      'high-quality medical, biosafety and personal protection products, ' +
      'alongside our suppliers around the world.',
    miga: 'About us',
    dato: 'years in operation',
    cifras: [
      { v: site.fundacion, e: 'Year founded', n: 'More than two decades in the sector', anio: true },
      { v: marcas.length, e: 'Brands represented', n: 'Manufacturers worldwide' },
      { v: productos.length, e: 'Products in the catalogue', n: `Across ${lineas.length} lines` },
    ],
    quienesAnte: 'Who we are',
    quienesTitulo: 'Your strategic partner in medical supplies and devices',
    quienesEntrada:
      'Q-MEDICAL S.A.C.: more than 20 years securing supply for Peru’s health sector.',
    quienesTexto:
      'We are a Peruvian company specialising in the supply and distribution of ' +
      'medical devices, hospital consumables, biosafety products and personal ' +
      `protective equipment. Since ${site.fundacion} we have worked alongside ` +
      'hospitals, clinics, laboratories and health institutions across the country.',
    portafolioRotulo: 'A complete portfolio of solutions for:',
    portafolio: [
      { i: 'bioseguridad', f: 'bioseguridad', t: 'Biosafety and personal protection' },
      { i: 'laparoscopia', f: 'cirugia-laparoscopica', t: 'Laparoscopic surgery' },
      { i: 'aspiracion', f: 'anestesiologia', t: 'Suction and airway management' },
      { i: 'antisepsia', f: 'antisepsia', t: 'Antisepsis and patient hygiene' },
      { i: 'nutricion', f: 'nutricion-enteral', t: 'Enteral and parenteral nutrition' },
      { i: 'instrumental', f: 'enfermeria', t: 'Non-instrumental medical supplies' },
    ],
    quienesCierre: [
      'More than products, we deliver trust, backing and traceability. Every ' +
        'solution arrives with its technical documentation, specialist support ' +
        'and personal attention, so your institution runs safely, efficiently ' +
        'and without interruption.',
      'We handle direct purchases as well as public and private tenders, with a ' +
        'professional team committed to responding quickly, precisely and with ' +
        'solutions tailored to the health sector.',
    ],
    infraAnte: 'Facilities',
    infraTitulo: 'Operating capacity that responds when health needs it',
    infraTexto:
      'Q-MEDICAL has three warehouses strategically located in Lima, all meeting ' +
      'DIGEMID requirements for the proper storage and preservation of medical ' +
      'devices.',
    infraCierre: 'More logistics capacity, timely deliveries and confidence for the health sector.',
    almacenes: [
      { n: 'Warehouse 01', d: 'Av. Arica 1442 — Breña' },
      { n: 'Warehouse 02', d: 'Jr. Napo 940 — Breña' },
      { n: 'Warehouse 03', d: 'Av. Venezuela 1684 — Breña' },
    ],
    controles: [
      { ic: 'documento', t: 'Receipt', d: 'Documentary and packaging-integrity checks before any batch is admitted.' },
      { ic: 'almacen', t: 'Storage', d: 'Segregated and labelled by batch and expiry date, on identified racking.' },
      { ic: 'reloj', t: 'Rotation', d: 'First to expire, first out — without exception.' },
      { ic: 'buscar', t: 'Traceability', d: 'Records that trace any unit from receipt through to dispatch.' },
    ],
    fotos: [
      'Racking at the Q-MEDICAL central warehouse, with product labelled by batch',
      'Aisle between racking, with product labelled by batch',
      'Palletised load at the Avenida Venezuela warehouse',
      'Collection area with palletised product and floor markings',
      'Aisle between pallets at the Avenida Venezuela warehouse',
    ],
    certifAnte: 'Certifications and accreditations',
    certifTitulo:
      'Quality that drives continuous improvement across every link of the ' +
      'supply chain',
    certifNota:
      'Excellence is not improvised: it is built at every stage and backed by ' +
      'international certifications and accreditations that guarantee quality, ' +
      'trust and commitment to the health sector.',
  },
}[lang];

// La segunda comparte fila con la ancha, y es la que se estira hasta su
// alto: sin eso la fila quedaba coja por abajo.
const galeria = FOTOS.map((f, i) => ({ ...f, alt: T.fotos[i], acompana: i === 1 }));

// Misión, visión y filosofía comparten el orden en los dos idiomas. La
// traducción se superpone en vez de sustituir: el icono solo está en el
// objeto en español y, reemplazándolo entero, en inglés se perdía.
const principios = valores.map((v, i) => ({
  ...v,
  ...(lang === 'en' ? (valoresEn[i] ?? {}) : {}),
}));

---

<Base
  lang={lang}
  clave="nosotros"
  title={T.meta}
  description={T.metaDesc}
  image="/img/fotos/operario-almacen-1600.webp"
>
  <Portada
    lang={lang}
    ante={T.ante}
    titulo={T.titulo}
    texto={T.bajada}
    migas={[{ nombre: T.miga }]}
    foto="/img/fotos/almacen-pasillo-2-1600.webp"
    cine
    dato={{ valor: String(site.anios), etiqueta: T.dato }}
  />

  <!-- ── Cifras ──────────────────────────────────────────────────────── -->
  <section class="bg-[var(--color-papel)] border-b border-[var(--color-linea)]">
    <div class="caja">
      <dl class="cifras" data-anim-grupo="80">
        {T.cifras.map((c, i) => (
          <div data-anim="sube">
            <dd
              class="cifras__valor cuenta"
              data-conteo={c.v}
              data-duracion={1500 + i * 200}
              {...c.anio ? { 'data-agrupar': 'no', 'data-desde': '1980' } : {}}
            >{c.v}</dd>
            <dt class="cifras__etiqueta">{c.e}</dt>
            <p class="cifras__nota">{c.n}</p>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ── Quiénes somos ───────────────────────────────────────────────
       Antes eran cinco párrafos seguidos en una columna: un muro de texto
       que nadie termina. El portafolio, que era la enumeración más larga,
       sale de la prosa y se vuelve una rejilla de seis piezas con su icono;
       lo que queda de texto son tres bloques cortos con aire entre ellos. -->
  <section class="aire bg-[var(--color-papel)]">
    <div class="caja">
      <div class="quienes" data-anim-grupo="90">
        <div>
          <p class="ante ante-brand" data-anim="sube">{T.quienesAnte}</p>
          <h2 class="display-lg mt-5 max-w-[20ch]" data-anim="sube">{T.quienesTitulo}</h2>
        </div>
        <div data-anim="sube">
          <p class="quienes__entrada">{T.quienesEntrada}</p>
          <p class="cuerpo-lg mt-6">{T.quienesTexto}</p>
        </div>
      </div>

      <p class="portafolio__rotulo" data-anim="sube">{T.portafolioRotulo}</p>
      <ul class="portafolio" data-anim-grupo="110">
        {T.portafolio.map((p) => (
          <li class="area" data-anim="sube">
            <span class="area__foto">
              <img src={`/img/especialidades/${p.f}-480.webp`} width="480" height="480"
                alt="" loading="lazy" decoding="async" />
              <span class="area__velo" aria-hidden="true"></span>
            </span>
            <span class="area__ic"><Icon name={p.i} size={24} stroke={1.15} /></span>
            <span class="area__t">{p.t}</span>
          </li>
        ))}
      </ul>

      <div class="quienes__cierre" data-anim-grupo="80">
        {T.quienesCierre.map((parrafo) => <p data-anim="sube">{parrafo}</p>)}
      </div>
    </div>
  </section>

  <!-- ── Misión, visión, filosofía ───────────────────────────────────── -->
  <section class="aire bg-[var(--color-papel-2)]">
    <div class="caja">
      <ol class="valores" data-anim-grupo="170">
        {principios.map((v) => (
          <li data-anim>
            <article class="valor">
              <span class="valor__filo" aria-hidden="true"></span>
              <span class="valor__sello">
                <span class="valor__halo" aria-hidden="true"></span>
                <Icon name={v.icono} size={30} stroke={1.3} anim />
              </span>
              <h2 class="valor__titulo">{v.titulo}</h2>
              <p class="valor__texto">{v.texto}</p>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── Infraestructura ─────────────────────────────────────────────── -->
  <section id="infraestructura" class="aire scroll-mt-20 bg-[var(--color-papel)]">
    <div class="caja">
      <div class="infra__intro" data-anim-grupo="80">
        <div>
          <p class="ante ante-brand" data-anim="sube">{T.infraAnte}</p>
          <h2 class="display-lg mt-5 max-w-[14ch]" data-anim="sube">{T.infraTitulo}</h2>
        </div>
        <div class="max-w-xl">
          <p class="cuerpo-lg" data-anim="sube">{T.infraTexto}</p>
          <p class="infra__cierre" data-anim="sube">{T.infraCierre}</p>
        </div>
      </div>

      <!-- Los tres almacenes. Son la prueba del párrafo de arriba, así que
           van pegados a él y antes de los controles. -->
      <ul class="almacenes" data-anim-grupo="70">
        {T.almacenes.map((a) => (
          <li class="almacen" data-anim="sube">
            <span class="almacen__rotulo">{a.n}</span>
            <span class="almacen__dir">{a.d}</span>
          </li>
        ))}
      </ul>

      <!-- Los cuatro controles son un proceso, no cuatro datos sueltos: por
           eso van unidos por una línea que se traza de principio a fin
           cuando la sección entra en pantalla, y cada paso enciende su
           pictograma al llegarle el turno. -->
      <ol class="controles" data-anim data-anim-grupo="160">
        {T.controles.map((c, i) => (
          <li class="control" data-anim="sube">
            <span class="control__marca">
              <span class="control__ic"><Icon name={c.ic} size={24} stroke={1.15} anim /></span>
            </span>
            <span class="folio control__folio">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="control__titulo">{c.t}</h3>
            <p class="control__texto">{c.d}</p>
          </li>
        ))}
      </ol>

      <div class="galeria" data-anim-grupo="60">
        {galeria.map((g) => (
          <figure
            class:list={[
              'lamina galeria__pieza',
              g.ancho && 'galeria__pieza--ancha',
              g.acompana && 'galeria__pieza--acompana',
            ]}
            data-anim="cortina"
            data-espera-foto
          >
            <img
              src={`/img/fotos/${g.src}-1000.webp`}
              srcset={`/img/fotos/${g.src}-640.webp 640w, /img/fotos/${g.src}-1000.webp 1000w, /img/fotos/${g.src}-1600.webp 1600w`}
              sizes={g.ancho ? '(min-width: 768px) 62vw, 92vw' : '(min-width: 768px) 30vw, 92vw'}
              width="1000" height="750" alt={g.alt} loading="lazy" decoding="async"
            />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Certificaciones ─────────────────────────────────────────────── -->
  <Respaldo
    lang={lang}
    id="certificaciones"
    ante={T.certifAnte}
    titulo={T.certifTitulo}
    nota={T.certifNota}
    aTexto={null}
  />

  <Clientes lang={lang} claro />

  <CtaContacto lang={lang} />
</Base>

<style>
  /* ── Cifras ───────────────────────────────────────────────────────── */
  .cifras { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 900px) { .cifras { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .cifras > div { padding: 2.5rem 1.5rem 2.5rem 0; border-top: 1px solid var(--color-linea); }
  @media (min-width: 900px) {
    .cifras > div { border-top: 0; }
    .cifras > div + div { border-left: 1px solid var(--color-linea); padding-left: 2.5rem; }
  }
  .cifras__valor {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.4rem, 4.5vw, 3.6rem);
    line-height: 1;
    color: var(--color-brand-700);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .cifras__etiqueta { margin-top: 0.85rem; font-size: 0.9rem; font-weight: 500; }
  .cifras__nota { margin-top: 0.3rem; font-size: 0.8rem; color: var(--color-tinta-45); }

  /* ── Quiénes somos ────────────────────────────────────────────────── */
  /* La entrada va en azul y a cuerpo mayor: es la frase que resume la
     empresa, y en el gris del texto corrido se perdía entre las demás. */
  .quienes__entrada {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.6rem);
    line-height: 1.3;
    color: var(--color-brand-700);
  }

  .portafolio__rotulo {
    margin-top: 4rem;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-tinta-45);
  }
  .portafolio {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.9rem;
    margin-top: 1.5rem;
  }
  @media (min-width: 640px) { .portafolio { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .portafolio { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  /* Fotografía arriba, pictograma montado a caballo sobre su borde y
     nombre debajo. La fotografía dice de qué servicio se trata; el
     pictograma es la marca de la casa y da el punto de orden que seis
     fotografías seguidas, cada una con su luz, no tienen por sí solas.

     La tarjeta entera responde: la imagen se acerca, el disco se viste del
     azul corporativo y el conjunto se levanta. */
  .area {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--r-md);
    background: var(--color-brand-50);
    transition: background-color 0.45s var(--ease-editorial),
      transform 0.5s var(--ease-salida), box-shadow 0.5s var(--ease-editorial);
  }
  .area:hover {
    background: var(--color-brand-100);
    transform: translateY(-5px);
    box-shadow: 0 30px 55px -38px rgba(21, 46, 127, 0.6);
  }

  .area__foto {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-brand-100);
  }
  .area__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s var(--ease-salida);
  }
  .area:hover .area__foto img { transform: scale(1.06); }

  /* El velo asienta la fotografía sobre el papel de la tarjeta y le da al
     disco un fondo donde apoyarse. */
  .area__velo {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 45%,
      color-mix(in srgb, var(--color-brand-900) 22%, transparent) 100%
    );
  }

  .area__ic {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 3.1rem;
    height: 3.1rem;
    margin: -1.55rem 0 0 1.25rem;
    border-radius: 999px;
    background: var(--color-papel);
    color: var(--color-brand-700);
    box-shadow: 0 10px 22px -12px rgba(21, 46, 127, 0.55);
    transition: background-color 0.45s var(--ease-editorial),
      color 0.45s var(--ease-editorial), transform 0.5s var(--ease-salida);
  }
  .area:hover .area__ic {
    background: var(--color-brand-700);
    color: #fff;
    transform: scale(1.06) rotate(-4deg);
  }

  .area__t {
    padding: 0.9rem 1.35rem 1.4rem;
    font-size: 1rem;
    line-height: 1.35;
  }

  @media (prefers-reduced-motion: reduce) {
    .area, .area__foto img, .area__ic { transition: none; }
    .area:hover { transform: none; }
    .area:hover .area__foto img, .area:hover .area__ic { transform: none; }
  }

  .quienes__cierre {
    display: grid;
    gap: 1.5rem;
    margin-top: 3.5rem;
    font-size: 1.02rem;
    line-height: 1.68;
    color: var(--color-tinta-70);
  }
  @media (min-width: 900px) {
    .quienes__cierre { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 3rem; }
  }

  .quienes { display: grid; gap: 2.5rem; }
  @media (min-width: 1024px) {
    .quienes { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 4.5rem; align-items: start; }
  }

  /* ── Valores ──────────────────────────────────────────────────────────

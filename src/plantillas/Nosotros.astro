---
import Base from '../layouts/Base.astro';
import Portada from '../components/Portada.astro';
import Icon from '../components/Icon.astro';
import CtaContacto from '../components/CtaContacto.astro';
import Respaldo from '../components/Respaldo.astro';
import { site, valores } from '../data/site';
import { marcas } from '../data/marcas';
import { categorias, productos } from '../data/catalogo';
import { ruta as via, type Idioma } from '../i18n/rutas';
import { valoresEn } from '../i18n/contenido';

interface Props {
  lang?: Idioma;
}
const { lang = 'es' } = Astro.props;

const FOTOS = [
  { src: 'almacen-racks-1', ancho: true },
  { src: 'almacen-pasillo-3' },
  { src: 'almacen-venezuela-3-limpia' },
  { src: 'almacen-venezuela-1' },
  { src: 'almacen-venezuela-2' },
];

const T = {
  es: {
    meta: `Nosotros — ${site.anios} años abasteciendo al sector salud del Perú`,
    metaDesc:
      'Q-MEDICAL S.A.C. es una droguería peruana fundada en 2003, certificada en ' +
      'Buenas Prácticas de Almacenamiento por DIGEMID, ISO 37001 e ISO 14001. ' +
      'Conozca nuestra misión, infraestructura y certificaciones.',
    ante: `Desde ${site.fundacion} · ${site.anios} años`,
    titulo: 'Una empresa peruana comprometida con la salud del país',
    bajada:
      'Trabajamos para que las instituciones de salud estatales y privadas ' +
      'dispongan de productos médicos, de bioseguridad y de protección personal ' +
      'de alta calidad, junto a nuestros proveedores alrededor del mundo.',
    miga: 'Nosotros',
    dato: 'años de operación',
    cifras: [
      { v: String(site.fundacion), e: 'Año de fundación', n: 'Más de dos décadas en el sector' },
      { v: String(marcas.length), e: 'Marcas representadas', n: 'Fabricantes de todo el mundo' },
      { v: String(productos.length), e: 'Productos en catálogo', n: `En ${categorias.length} líneas` },
      { v: '49', e: 'Fichas técnicas', n: 'Documentación pública en PDF' },
    ],
    quienesAnte: 'Quiénes somos',
    quienesTitulo: 'Una droguería, no un intermediario',
    quienes: [
      `Q-MEDICAL S.A.C. inició actividades en enero de ${site.fundacion} y hoy es ` +
        'una droguería especializada en la comercialización de dispositivos médicos ' +
        'de alta calidad. Contamos con la certificación de Buenas Prácticas de ' +
        'Almacenamiento otorgada por DIGEMID y representamos y distribuimos productos ' +
        'de compañías reconocidas a nivel mundial.',
      'Esa condición cambia lo que podemos ofrecer: no solo colocamos un producto, ' +
        'respondemos por su conservación, su trazabilidad documental y su ficha ' +
        'técnica frente al área usuaria, al comité de compras y a la autoridad ' +
        'sanitaria.',
      'Atendemos a instituciones médicas de todas las regiones del país ' +
        '—hospitales, clínicas, laboratorios, centros geriátricos y retail— tanto ' +
        'en compra directa como en procesos de licitación pública.',
    ],
    infraAnte: 'Infraestructura',
    infraTitulo: 'Un almacén que responde por el producto',
    infraTexto:
      'La certificación BPA no es un sello en la pared: es un régimen de control ' +
      'sobre la recepción, el almacenamiento, la conservación y el despacho de cada lote.',
    controles: [
      { t: 'Recepción', d: 'Verificación documental y de integridad de empaque antes de ingresar cualquier lote.' },
      { t: 'Almacenamiento', d: 'Segregado y rotulado por lote y fecha de vencimiento, en racks identificados.' },
      { t: 'Rotación', d: 'Bajo criterio de primero en vencer, primero en salir, sin excepciones.' },
      { t: 'Trazabilidad', d: 'Registro que permite rastrear cualquier unidad desde la recepción hasta el despacho.' },
    ],
    fotos: [
      'Racks del almacén central de Q-MEDICAL, con producto rotulado por lote',
      'Pasillo entre racks, con producto rotulado por lote',
      'Carga paletizada en el almacén de la avenida Venezuela',
      'Zona de acopio con producto paletizado y señalización de piso',
      'Pasillo entre pallets en el almacén de la avenida Venezuela',
    ],
    certifAnte: 'Certificaciones y acreditaciones',
    certifTitulo:
      'Calidad que impulsa la mejora continua en todos los eslabones de la ' +
      'cadena de suministro',
    verDocs: 'Solicitar la documentación técnica',
  },
  en: {
    meta: `About us — ${site.anios} years supplying Peru’s health sector`,
    metaDesc:
      'Q-MEDICAL S.A.C. is a Peruvian drugstore founded in 2003, certified in Good ' +
      'Storage Practices (BPA) by DIGEMID, ISO 37001 and ISO 14001. Learn about our ' +
      'mission, facilities and certifications.',
    ante: `Since ${site.fundacion} · ${site.anios} years`,
    titulo: 'A Peruvian company committed to the health of the country',
    bajada:
      'We work so that public and private healthcare institutions have ' +
      'high-quality medical, biosafety and personal protection products, ' +
      'alongside our suppliers around the world.',
    miga: 'About us',
    dato: 'years in operation',
    cifras: [
      { v: String(site.fundacion), e: 'Year founded', n: 'More than two decades in the sector' },
      { v: String(marcas.length), e: 'Brands represented', n: 'Manufacturers worldwide' },
      { v: String(productos.length), e: 'Products in the catalogue', n: `Across ${categorias.length} lines` },
      { v: '49', e: 'Datasheets', n: 'Public documentation in PDF' },
    ],
    quienesAnte: 'Who we are',
    quienesTitulo: 'A drugstore, not a middleman',
    quienes: [
      `Q-MEDICAL S.A.C. began trading in January ${site.fundacion} and is today a ` +
        'drugstore specialising in the supply of high-quality medical devices. We ' +
        'hold the Good Storage Practices certification granted by DIGEMID, and we ' +
        'represent and distribute products from companies recognised worldwide.',
      'That status changes what we can offer: we do not merely place a product, we ' +
        'answer for its storage, its documentary traceability and its datasheet ' +
        'before the end user, the purchasing committee and the health authority.',
      'We serve medical institutions in every region of the country —hospitals, ' +
        'clinics, laboratories, geriatric centres and retail chains— both through ' +
        'direct purchase and through public tenders.',
    ],
    infraAnte: 'Facilities',
    infraTitulo: 'A warehouse that answers for the product',
    infraTexto:
      'The BPA certification is not a plaque on the wall: it is a regime of control ' +
      'over the receipt, storage, preservation and dispatch of every batch.',
    controles: [
      { t: 'Receipt', d: 'Documentary and packaging-integrity checks before any batch is admitted.' },
      { t: 'Storage', d: 'Segregated and labelled by batch and expiry date, on identified racking.' },
      { t: 'Rotation', d: 'First to expire, first out — without exception.' },
      { t: 'Traceability', d: 'Records that trace any unit from receipt through to dispatch.' },
    ],
    fotos: [
      'Racking at the Q-MEDICAL central warehouse, with product labelled by batch',
      'Aisle between racking, with product labelled by batch',
      'Palletised load at the Avenida Venezuela warehouse',
      'Collection area with palletised product and floor markings',
      'Aisle between pallets at the Avenida Venezuela warehouse',
    ],
    certifAnte: 'Certifications and accreditations',
    certifTitulo:
      'Quality that drives continuous improvement across every link of the ' +
      'supply chain',
    verDocs: 'Request the technical documentation',
  },
}[lang];

// La segunda comparte fila con la ancha, y es la que se estira hasta su
// alto: sin eso la fila quedaba coja por abajo.
const galeria = FOTOS.map((f, i) => ({ ...f, alt: T.fotos[i], acompana: i === 1 }));

// Misión, visión y filosofía comparten el orden en los dos idiomas. La
// traducción se superpone en vez de sustituir: el icono solo está en el
// objeto en español y, reemplazándolo entero, en inglés se perdía.
const principios = valores.map((v, i) => ({
  ...v,
  ...(lang === 'en' ? (valoresEn[i] ?? {}) : {}),
}));

---

<Base
  lang={lang}
  clave="nosotros"
  title={T.meta}
  description={T.metaDesc}
  image="/img/fotos/operario-almacen-1600.webp"
>
  <Portada
    lang={lang}
    ante={T.ante}
    titulo={T.titulo}
    texto={T.bajada}
    migas={[{ nombre: T.miga }]}
    foto="/img/fotos/almacen-pasillo-2-1600.webp"
    dato={{ valor: String(site.anios), etiqueta: T.dato }}
  />

  <!-- ── Cifras ──────────────────────────────────────────────────────── -->
  <section class="bg-[var(--color-papel)] border-b border-[var(--color-linea)]">
    <div class="caja">
      <dl class="cifras" data-anim-grupo="80">
        {T.cifras.map((c) => (
          <div data-anim="sube">
            <dd class="cifras__valor">{c.v}</dd>
            <dt class="cifras__etiqueta">{c.e}</dt>
            <p class="cifras__nota">{c.n}</p>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ── Quiénes somos ───────────────────────────────────────────────── -->
  <section class="aire bg-[var(--color-papel)]">
    <div class="caja quienes" data-anim-grupo="90">
      <div>
        <p class="ante ante-brand" data-anim="sube">{T.quienesAnte}</p>
        <h2 class="display-lg mt-5 max-w-[13ch]" data-anim="sube">{T.quienesTitulo}</h2>
      </div>
      <div class="cuerpo-lg" data-anim="sube">
        {T.quienes.map((parrafo) => <p>{parrafo}</p>)}
      </div>
    </div>
  </section>

  <!-- ── Misión, visión, filosofía ───────────────────────────────────── -->
  <section class="aire bg-[var(--color-papel-2)]">
    <div class="caja">
      <ol class="valores" data-anim-grupo="170">
        {principios.map((v) => (
          <li data-anim>
            <article class="valor">
              <span class="valor__filo" aria-hidden="true"></span>
              <span class="valor__sello">
                <span class="valor__halo" aria-hidden="true"></span>
                <Icon name={v.icono} size={30} stroke={1.3} anim />
              </span>
              <h2 class="valor__titulo">{v.titulo}</h2>
              <p class="valor__texto">{v.texto}</p>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── Infraestructura ─────────────────────────────────────────────── -->
  <section id="infraestructura" class="aire scroll-mt-20 bg-[var(--color-papel)]">
    <div class="caja">
      <div class="infra__intro" data-anim-grupo="80">
        <div>
          <p class="ante ante-brand" data-anim="sube">{T.infraAnte}</p>
          <h2 class="display-lg mt-5 max-w-[14ch]" data-anim="sube">{T.infraTitulo}</h2>
        </div>
        <p class="cuerpo-lg max-w-xl" data-anim="sube">{T.infraTexto}</p>
      </div>

      <ol class="controles" data-anim-grupo="70">
        {T.controles.map((c, i) => (
          <li class="control" data-anim="sube">
            <span class="folio">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="control__titulo">{c.t}</h3>
            <p class="control__texto">{c.d}</p>
          </li>
        ))}
      </ol>

      <div class="galeria" data-anim-grupo="60">
        {galeria.map((g) => (
          <figure
            class:list={[
              'lamina galeria__pieza',
              g.ancho && 'galeria__pieza--ancha',
              g.acompana && 'galeria__pieza--acompana',
            ]}
            data-anim="cortina"
          >
            <img
              src={`/img/fotos/${g.src}-1000.webp`}
              srcset={`/img/fotos/${g.src}-640.webp 640w, /img/fotos/${g.src}-1000.webp 1000w, /img/fotos/${g.src}-1600.webp 1600w`}
              sizes={g.ancho ? '(min-width: 768px) 62vw, 92vw' : '(min-width: 768px) 30vw, 92vw'}
              width="1000" height="750" alt={g.alt} loading="lazy" decoding="async"
            />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Certificaciones ─────────────────────────────────────────────── -->
  <Respaldo
    lang={lang}
    id="certificaciones"
    ante={T.certifAnte}
    titulo={T.certifTitulo}
    a={via(lang, 'contacto', undefined, 'cotizar')}
    aTexto={T.verDocs}
  />

  <CtaContacto lang={lang} />
</Base>

<style>
  /* ── Cifras ───────────────────────────────────────────────────────── */
  .cifras { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 900px) { .cifras { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .cifras > div { padding: 2.5rem 1.5rem 2.5rem 0; border-top: 1px solid var(--color-linea); }
  @media (min-width: 900px) {
    .cifras > div { border-top: 0; }
    .cifras > div + div { border-left: 1px solid var(--color-linea); padding-left: 2.5rem; }
  }
  .cifras__valor {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.4rem, 4.5vw, 3.6rem);
    line-height: 1;
    color: var(--color-brand-700);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .cifras__etiqueta { margin-top: 0.85rem; font-size: 0.9rem; font-weight: 500; }
  .cifras__nota { margin-top: 0.3rem; font-size: 0.8rem; color: var(--color-tinta-45); }

  /* ── Quiénes somos ────────────────────────────────────────────────── */
  .quienes { display: grid; gap: 2.5rem; }
  @media (min-width: 1024px) {
    .quienes { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr); gap: 5rem; }
  }

  /* ── Valores ──────────────────────────────────────────────────────────
     Antes eran tres columnas separadas por filetes, encabezadas por 01, 02 y
     03. El ordinal no decía nada —no hay un orden que importe entre misión,
     visión y filosofía—, así que cada una lleva ahora su propio signo: la
     brújula del rumbo, el sol sobre el horizonte y el pulso del compromiso.

     Cada principio es una lámina con superficie propia, y sus tres piezas
     —sello, título y texto— entran una detrás de otra, no de golpe. */
  .valores { display: grid; gap: var(--medianil); }
  @media (min-width: 900px) { .valores { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .valores > li { display: flex; }

  .valor {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 2.25rem;
    border: 1px solid var(--color-linea);
    border-radius: var(--r-lg);
    background: #fff;
    transform: translate3d(0, var(--alza, 0px), 0);
    transition: transform 0.7s var(--ease-salida),
      border-color 0.45s var(--ease-editorial),
      box-shadow 0.45s var(--ease-editorial);
  }
  @media (min-width: 1024px) { .valor { padding: 2.75rem; } }

  .valor:hover,
  .valor:focus-within {
    --alza: -6px;
    border-color: var(--color-brand-300);
    box-shadow: 0 28px 55px -30px rgba(27, 47, 122, 0.42);
  }

  /* Filo de luz sobre el canto superior: se traza de dentro hacia fuera al
     pasar el puntero. Arranca y termina pasadas las esquinas redondeadas,
     que si no el borde lo corta en seco. */
  .valor__filo {
    position: absolute;
    top: -1px;
    left: var(--r-lg);
    right: var(--r-lg);
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--color-brand-500), transparent);
    transform: scaleX(0);
    transition: transform 0.85s var(--ease-salida);
  }
  .valor:hover .valor__filo,
  .valor:focus-within .valor__filo { transform: scaleX(1); }

  /* Sello: el signo dentro de su anillo. Crece con el ancho de la lámina y
     el icono ocupa siempre la misma fracción, así que a 360 px se ve igual
     de proporcionado que a 1440. */
  .valor__sello {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(3.2rem, 3.6vw + 1.8rem, 4.4rem);
    aspect-ratio: 1;
    flex: none;
    border: 1px solid var(--color-linea-2);
    border-radius: 999px;
    color: var(--color-brand-700);
    transition: border-color 0.45s var(--ease-editorial),
      background-color 0.45s var(--ease-editorial);
  }
  .valor__sello :global(svg) { position: relative; width: 54%; height: auto; }
  .valor:hover .valor__sello,
  .valor:focus-within .valor__sello {
    border-color: var(--color-brand-300);
    background: var(--color-brand-50);
  }

  .valor__halo {
    position: absolute;
    inset: -1px;
    border: 1px solid var(--color-brand-300);
    border-radius: 999px;
    opacity: 0;
  }
  .valor:hover .valor__halo { animation: valor-halo 1.6s var(--ease-salida) infinite; }
  @keyframes valor-halo {
    0% { opacity: 0.6; transform: scale(1); }
    100% { opacity: 0; transform: scale(1.5); }
  }

  .valor__titulo {
    margin-top: 1.75rem;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.7rem, 2.6vw, 2.2rem);
    letter-spacing: -0.015em;
  }
  .valor__texto { margin-top: 1rem; font-size: 0.95rem; line-height: 1.65; color: var(--color-tinta-70); }

  /* Entrada secuencial. El grupo escalona las tres láminas con --retraso, y
     dentro de cada una las tres piezas se encadenan sobre ese mismo reloj:
     así el ojo recorre la fila en un orden, no la recibe entera de golpe. */
  :global(.js) .valor__sello,
  :global(.js) .valor__titulo,
  :global(.js) .valor__texto {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.7s var(--ease-editorial), transform 0.7s var(--ease-salida);
  }
  :global(.js) .visible .valor__sello,
  :global(.js) .visible .valor__titulo,
  :global(.js) .visible .valor__texto { opacity: 1; transform: none; }
  :global(.js) .visible .valor__sello { transition-delay: calc(var(--retraso, 0ms) + 60ms); }
  :global(.js) .visible .valor__titulo { transition-delay: calc(var(--retraso, 0ms) + 190ms); }
  :global(.js) .visible .valor__texto { transition-delay: calc(var(--retraso, 0ms) + 310ms); }

  @media (prefers-reduced-motion: reduce) {
    .valor { transition: none; }
    .valor:hover { --alza: 0px; }
    .valor:hover .valor__halo { animation: none; }
    :global(.js) .valor__sello,
    :global(.js) .valor__titulo,
    :global(.js) .valor__texto { opacity: 1; transform: none; transition: none; }
  }

  /* ── Infraestructura ──────────────────────────────────────────────── */
  .infra__intro { display: grid; gap: 2.5rem; }
  @media (min-width: 1024px) {
    .infra__intro { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 5rem; align-items: end; }
  }
  .controles {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 0;
    margin-top: 3.5rem;
    border-top: 1px solid var(--color-linea);
  }
  @media (min-width: 640px) { .controles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .controles { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .control { padding: 1.75rem 1.5rem 1.75rem 0; border-bottom: 1px solid var(--color-linea); }
  @media (min-width: 1100px) {
    .control { border-bottom: 0; }
    .control + .control { border-left: 1px solid var(--color-linea); padding-left: 1.75rem; }
  }
  .control__titulo { margin-top: 0.85rem; font-size: 1rem; font-weight: 500; }
  .control__texto { margin-top: 0.5rem; font-size: 0.865rem; line-height: 1.55; color: var(--color-tinta-70); }

  .galeria {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
    margin-top: 3.5rem;
  }
  @media (min-width: 768px) { .galeria { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.1rem; } }
  .galeria__pieza { aspect-ratio: 4 / 3; }
  .galeria__pieza::after { display: none; }
  .galeria__pieza--ancha { grid-column: span 2; aspect-ratio: 16 / 9; }

  /* La ancha va a 16:9 y las demás a 4:3, así que en la primera fila no
     llegaban al mismo alto y quedaba un hueco debajo de la de la derecha.
     Esa suelta su proporción y se estira hasta el alto que marca la ancha;
     la imagen recorta, que para eso lleva object-fit. */
  @media (min-width: 768px) {
    .galeria__pieza--acompana { aspect-ratio: auto; height: 100%; }
  }

</style>

---
import Base from '../layouts/Base.astro';
import Portada from '../components/Portada.astro';
import Icon from '../components/Icon.astro';
import CtaContacto from '../components/CtaContacto.astro';
import Respaldo from '../components/Respaldo.astro';
import Clientes from '../components/Clientes.astro';
import { site, valores } from '../data/site';
import { ruta as via, type Idioma } from '../i18n/rutas';
import { valoresEn } from '../i18n/contenido';
import { fotoEspecialidad } from '../data/especialidades';

interface Props {
  lang?: Idioma;
}
const { lang = 'es' } = Astro.props;

// Las cinco fotografías del almacén central que entregó la empresa en
// octubre de 2026, en lugar de las anteriores.
const FOTOS = [
  { src: 'almacen-central-3', ancho: true },
  { src: 'almacen-central-2' },
  { src: 'almacen-central-1' },
  { src: 'almacen-central-4' },
  { src: 'almacen-central-5' },
];

const T = {
  es: {
    meta: `Nosotros — ${site.anios} años abasteciendo al sector salud del Perú`,
    metaDesc:
      'Q-MEDICAL S.A.C. es una droguería peruana fundada en 2003, certificada en ' +
      'Buenas Prácticas de Almacenamiento por DIGEMID, ISO 37001 e ISO 14001. ' +
      'Conozca nuestra misión, infraestructura y certificaciones.',
    ante: `Desde ${site.fundacion} · ${site.anios} años`,
    titulo: 'Una empresa peruana comprometida con la salud del país',
    bajada:
      'Trabajamos para que las instituciones de salud estatales y privadas ' +
      'dispongan de productos médicos, de bioseguridad y de protección personal ' +
      'de alta calidad, junto a nuestros proveedores alrededor del mundo.',
    miga: 'Nosotros',
    // Las tres cifras de la maqueta que entregó la empresa (octubre de 2026).
    cifras: [
      { v: site.fundacion, e: 'Año de fundación', n: 'Más de dos décadas en el sector salud.', anio: true },
      { v: 500, pre: '+', e: 'Clientes atendidos', n: 'Alcance comercial en el sector público y privado.' },
      { v: 180, e: 'Productos en el portafolio', n: 'Amplitud de soluciones y dispositivos médicos.' },
    ],
    quienesAnte: 'Quiénes somos',
    quienesTitulo: 'Su aliado estratégico en insumos y dispositivos médicos',
    quienesEntrada:
      'Q-MEDICAL: más de 20 años asegurando el abastecimiento del sector ' +
      'salud en el Perú.',
    quienesTexto:
      'Somos una empresa peruana especializada en la comercialización y ' +
      'distribución de dispositivos médicos, insumos hospitalarios, productos de ' +
      `bioseguridad y equipos de protección personal. Desde el año ${site.fundacion}, ` +
      'acompañamos a hospitales, clínicas, laboratorios e instituciones de salud ' +
      'en todo el país.',
    portafolioRotulo: 'Ofrecemos un portafolio integral de soluciones para:',
    portafolio: [
      { i: 'bioseguridad', f: 'bioseguridad', t: 'Bioseguridad y protección personal' },
      { i: 'laparoscopia', f: 'cirugia-laparoscopica', t: 'Cirugía laparoscópica' },
      { i: 'aspiracion', f: 'anestesiologia', t: 'Aspiración y manejo de la vía aérea' },
      { i: 'antisepsia', f: 'antisepsia', t: 'Antisepsia e higiene del paciente' },
      { i: 'nutricion', f: 'nutricion-enteral', t: 'Nutrición enteral y parenteral' },
      { i: 'instrumental', f: 'enfermeria', t: 'Material médico no instrumental' },
    ],
    infraAnte: 'Infraestructura',
    infraTitulo: 'Capacidad operativa que responde cuando la salud lo necesita',
    infraTexto:
      'Q-MEDICAL cuenta con tres almacenes estratégicamente ubicados, que ' +
      'cumplen con las exigencias de DIGEMID para el adecuado almacenamiento y ' +
      'conservación de dispositivos médicos.',
    infraCierre: 'Más capacidad logística, entregas oportunas y confianza para el sector salud.',
    almacenes: [
      { n: 'Almacén 01', d: 'Av. Arica 1442 — Breña' },
      { n: 'Almacén 02', d: 'Jr. Napo 940 — Breña' },
      { n: 'Almacén 03', d: 'Av. Venezuela 1684 — Breña' },
    ],
    // Los cuatro que entregó la empresa en OBSERVACIONES 3.
    controles: [
      { ic: 'almacen', t: 'Infraestructura especializada', d: 'Tres almacenes estratégicamente ubicados para respaldar nuestra operación logística.' },
      { ic: 'escudo', t: 'Conservación garantizada', d: 'Condiciones de almacenamiento orientadas a preservar la integridad y calidad de los dispositivos médicos.' },
      { ic: 'entrega', t: 'Respuesta logística', d: 'Una operación organizada y eficiente para atender los requerimientos de abastecimiento de nuestros clientes.' },
      { ic: 'buscar', t: 'Control y trazabilidad', d: 'Seguimiento de los productos para respaldar el control desde su recepción hasta su despacho.' },
    ],
    fotos: [
      'Pasillo central del almacén de Q-MEDICAL, con racks a ambos lados',
      'Apilador eléctrico y transpaleta entre los racks del almacén',
      'Racks selectivos con producto paletizado',
      'Racks con cajas rotuladas y pallets identificados',
      'Pasillo entre racks, con producto ordenado por niveles',
    ],
    esenciaAnte: 'Nuestra esencia ›',
    esenciaTitulo: ['Nuestra misión,', 'visión y filosofía'] as [string, string],
    esenciaSub: 'Nos guía, nos reta, nos impulsa.',
    esenciaNota:
      'Trabajamos con un propósito claro: llevar soluciones médicas confiables ' +
      'a quienes cuidan la vida, con calidad, responsabilidad y compromiso en ' +
      'cada entrega.',
    esenciaEmisor: 'Q-MEDICAL SAC',
    certifAnte: 'Certificaciones y acreditaciones',
    certifTitulo: [
      'Calidad que impulsa la mejora continua',
      'en todos los eslabones de la cadena de suministro',
    ] as [string, string],
    certifNota:
      'La excelencia no se improvisa: se construye en cada etapa y se respalda ' +
      'con certificaciones y acreditaciones internacionales que garantizan ' +
      'calidad, confianza y compromiso con el sector salud.',
  },
  en: {
    meta: `About us — ${site.anios} years supplying Peru’s health sector`,
    metaDesc:
      'Q-MEDICAL S.A.C. is a Peruvian drugstore founded in 2003, certified in Good ' +
      'Storage Practices (BPA) by DIGEMID, ISO 37001 and ISO 14001. Learn about our ' +
      'mission, facilities and certifications.',
    ante: `Since ${site.fundacion} · ${site.anios} years`,
    titulo: 'A Peruvian company committed to the health of the country',
    bajada:
      'We work so that public and private healthcare institutions have ' +
      'high-quality medical, biosafety and personal protection products, ' +
      'alongside our suppliers around the world.',
    miga: 'About us',
    cifras: [
      { v: site.fundacion, e: 'Year founded', n: 'More than two decades in the health sector.', anio: true },
      { v: 500, pre: '+', e: 'Clients served', n: 'Commercial reach across the public and private sectors.' },
      { v: 180, e: 'Products in the portfolio', n: 'A wide range of solutions and medical devices.' },
    ],
    quienesAnte: 'Who we are',
    quienesTitulo: 'Your strategic partner in medical supplies and devices',
    quienesEntrada:
      'Q-MEDICAL: more than 20 years securing supply for Peru’s health sector.',
    quienesTexto:
      'We are a Peruvian company specialising in the supply and distribution of ' +
      'medical devices, hospital consumables, biosafety products and personal ' +
      `protective equipment. Since ${site.fundacion} we have worked alongside ` +
      'hospitals, clinics, laboratories and health institutions across the country.',
    portafolioRotulo: 'A complete portfolio of solutions for:',
    portafolio: [
      { i: 'bioseguridad', f: 'bioseguridad', t: 'Biosafety and personal protection' },
      { i: 'laparoscopia', f: 'cirugia-laparoscopica', t: 'Laparoscopic surgery' },
      { i: 'aspiracion', f: 'anestesiologia', t: 'Suction and airway management' },
      { i: 'antisepsia', f: 'antisepsia', t: 'Antisepsis and patient hygiene' },
      { i: 'nutricion', f: 'nutricion-enteral', t: 'Enteral and parenteral nutrition' },
      { i: 'instrumental', f: 'enfermeria', t: 'Non-instrumental medical supplies' },
    ],
    infraAnte: 'Facilities',
    infraTitulo: 'Operating capacity that responds when health needs it',
    infraTexto:
      'Q-MEDICAL has three strategically located warehouses, all meeting ' +
      'DIGEMID requirements for the proper storage and preservation of medical ' +
      'devices.',
    infraCierre: 'More logistics capacity, timely deliveries and confidence for the health sector.',
    almacenes: [
      { n: 'Warehouse 01', d: 'Av. Arica 1442 — Breña' },
      { n: 'Warehouse 02', d: 'Jr. Napo 940 — Breña' },
      { n: 'Warehouse 03', d: 'Av. Venezuela 1684 — Breña' },
    ],
    controles: [
      { ic: 'almacen', t: 'Specialised infrastructure', d: 'Three strategically located warehouses backing our logistics operation.' },
      { ic: 'escudo', t: 'Guaranteed preservation', d: 'Storage conditions aimed at preserving the integrity and quality of medical devices.' },
      { ic: 'entrega', t: 'Logistics response', d: 'An organised, efficient operation to meet our clients’ supply requirements.' },
      { ic: 'buscar', t: 'Control and traceability', d: 'Product tracking that supports control from receipt through to dispatch.' },
    ],
    fotos: [
      'Central aisle of the Q-MEDICAL warehouse, with racking on both sides',
      'Electric stacker and pallet truck between the warehouse racks',
      'Selective racking with palletised product',
      'Racking with labelled boxes and identified pallets',
      'Aisle between racks, with product arranged by level',
    ],
    esenciaAnte: 'Our essence ›',
    esenciaTitulo: ['Our mission,', 'vision and philosophy'] as [string, string],
    esenciaSub: 'It guides us, challenges us, drives us.',
    esenciaNota:
      'We work with a clear purpose: to bring reliable medical solutions to ' +
      'those who care for life, with quality, responsibility and commitment in ' +
      'every delivery.',
    esenciaEmisor: 'Q-MEDICAL SAC',
    certifAnte: 'Certifications and accreditations',
    certifTitulo: [
      'Quality that drives continuous improvement',
      'across every link of the supply chain',
    ] as [string, string],
    certifNota:
      'Excellence is not improvised: it is built at every stage and backed by ' +
      'international certifications and accreditations that guarantee quality, ' +
      'trust and commitment to the health sector.',
  },
}[lang];

// La segunda comparte fila con la ancha, y es la que se estira hasta su
// alto: sin eso la fila quedaba coja por abajo.
const galeria = FOTOS.map((f, i) => ({ ...f, alt: T.fotos[i], acompana: i === 1 }));

// Misión, visión y filosofía comparten el orden en los dos idiomas. La
// traducción se superpone en vez de sustituir: el icono solo está en el
// objeto en español y, reemplazándolo entero, en inglés se perdía.
const principios = valores.map((v, i) => ({
  ...v,
  ...(lang === 'en' ? (valoresEn[i] ?? {}) : {}),
}));

---

<Base
  lang={lang}
  clave="nosotros"
  title={T.meta}
  description={T.metaDesc}
  image="/img/fotos/operario-almacen-1600.webp"
>
  <Portada
    lang={lang}
    ante={T.ante}
    titulo={T.titulo}
    texto={T.bajada}
    migas={[{ nombre: T.miga }]}
    foto="/img/fotos/almacen-pasillo-2-1600.webp"
    cine
  />

  <!-- ── Cifras ─────────────────────────────────────────────────────
       Banda marina con tres cifras en celeste, cada una con su raya y su
       rótulo en versales, separadas por filetes: la maqueta de la empresa. -->
  <section class="hitos">
    <div class="caja">
      <div class="hitos__lista" data-anim-grupo="110">
        {T.cifras.map((c, i) => (
          <div class="hito" data-anim="sube">
            <p
              class="hito__valor cuenta"
              data-conteo={c.v}
              data-duracion={1500 + i * 250}
              {...c.pre ? { 'data-prefijo': c.pre } : {}}
              {...c.anio ? { 'data-agrupar': 'no', 'data-desde': '1980' } : {}}
            >{c.pre ?? ''}{c.v}</p>
            <span class="hito__raya" aria-hidden="true"></span>
            <p class="hito__etiqueta">{c.e}</p>
            <p class="hito__nota">{c.n}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Quiénes somos ───────────────────────────────────────────────
       Antes eran cinco párrafos seguidos en una columna: un muro de texto
       que nadie termina. El portafolio, que era la enumeración más larga,
       sale de la prosa y se vuelve una rejilla de seis piezas con su icono;
       lo que queda de texto son tres bloques cortos con aire entre ellos. -->
  <section class="aire bg-[var(--color-papel)]">
    <div class="caja">
      <p class="ante ante-brand" data-anim="sube">{T.quienesAnte}</p>
      <div class="quienes alto-alineado" data-anim-grupo="90">
        <h2 class="display-lg max-w-[20ch]" data-anim="sube">{T.quienesTitulo}</h2>
        <div class="alto-alineado__texto" data-anim="sube">
          <p class="quienes__entrada">{T.quienesEntrada}</p>
          <p class="cuerpo-lg mt-6">{T.quienesTexto}</p>
        </div>
      </div>

      <p class="portafolio__rotulo" data-anim="sube">{T.portafolioRotulo}</p>
      <ul class="portafolio" data-anim-grupo="110">
        {T.portafolio.map((p) => (
          <li class="area" data-anim="sube">
            <span class="area__foto">
              <img src={fotoEspecialidad(p.f, 480)}
                srcset={`${fotoEspecialidad(p.f, 480)} 480w, ${fotoEspecialidad(p.f, 960)} 960w`}
                sizes="(min-width: 1024px) 30vw, (min-width: 640px) 45vw, 92vw"
                width="480" height="480"
                alt="" loading="lazy" decoding="async" />
              <span class="area__velo" aria-hidden="true"></span>
            </span>
            <span class="area__ic"><Icon name={p.i} size={24} stroke={1.15} /></span>
            <span class="area__t">{p.t}</span>
          </li>
        ))}
      </ul>

    </div>
  </section>

  <!-- ── Nuestra esencia: misión, visión y filosofía ─────────────────
       Con el diseño de certificaciones, como en la maqueta que entregó la
       empresa el 20 de octubre de 2026: titular a dos tonos, lema con
       escudo y tres tarjetas. -->
  <Respaldo
    lang={lang}
    id="esencia"
    ante={T.esenciaAnte}
    titulo={T.esenciaTitulo}
    subtitulo={T.esenciaSub}
    texto={null}
    nota={T.esenciaNota}
    franja={false}
    tarjetas={principios.map((v) => ({
      icono: v.icono,
      sigla: v.titulo,
      detalle: v.texto,
      emisor: T.esenciaEmisor,
    }))}
  />

  <!-- ── Infraestructura ─────────────────────────────────────────────── -->
  <section id="infraestructura" class="aire scroll-mt-20 bg-[var(--color-papel)]">
    <div class="caja">
      <p class="ante ante-brand" data-anim="sube">{T.infraAnte}</p>
      <div class="infra__intro alto-alineado" data-anim-grupo="80">
        <h2 class="display-lg max-w-[14ch]" data-anim="sube">{T.infraTitulo}</h2>
        <div class="alto-alineado__texto max-w-xl">
          <p class="cuerpo-lg" data-anim="sube">{T.infraTexto}</p>
          <p class="infra__cierre" data-anim="sube">{T.infraCierre}</p>
        </div>
      </div>

      <!-- Los tres almacenes. Son la prueba del párrafo de arriba, así que
           van pegados a él y antes de los controles. -->
      <ul class="almacenes" data-anim-grupo="70">
        {T.almacenes.map((a) => (
          <li class="almacen" data-anim="sube">
            <span class="almacen__rotulo">{a.n}</span>
            <span class="almacen__dir">{a.d}</span>
          </li>
        ))}
      </ul>

      <!-- Los cuatro controles son un proceso, no cuatro datos sueltos: por
           eso van unidos por una línea que se traza de principio a fin
           cuando la sección entra en pantalla, y cada paso enciende su
           pictograma al llegarle el turno. -->
      <ol class="controles" data-anim data-anim-grupo="160">
        {T.controles.map((c, i) => (
          <li class="control" data-anim="sube">
            <span class="control__marca">
              <span class="control__ic"><Icon name={c.ic} size={24} stroke={1.15} anim /></span>
            </span>
            <span class="folio control__folio">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="control__titulo">{c.t}</h3>
            <p class="control__texto">{c.d}</p>
          </li>
        ))}
      </ol>

      <div class="galeria" data-anim-grupo="60">
        {galeria.map((g) => (
          <figure
            class:list={[
              'lamina galeria__pieza',
              g.ancho && 'galeria__pieza--ancha',
              g.acompana && 'galeria__pieza--acompana',
            ]}
            data-anim="cortina"
            data-espera-foto
          >
            <img
              src={`/img/fotos/${g.src}-1000.webp`}
              srcset={`/img/fotos/${g.src}-640.webp 640w, /img/fotos/${g.src}-1000.webp 1000w, /img/fotos/${g.src}-1600.webp 1600w`}
              sizes={g.ancho ? '(min-width: 768px) 62vw, 92vw' : '(min-width: 768px) 30vw, 92vw'}
              width="1000" height="750" alt={g.alt} loading="lazy" decoding="async"
            />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Certificaciones ─────────────────────────────────────────────── -->
  <Respaldo
    lang={lang}
    id="certificaciones"
    ante={T.certifAnte}
    titulo={T.certifTitulo}
    texto={null}
    nota={T.certifNota}
  />

  <Clientes lang={lang} claro />

  <CtaContacto lang={lang} />
</Base>

<style>
  /* ── Cifras ───────────────────────────────────────────────────────── */
  /* La banda sube por detrás de la cabecera: así las esquinas redondeadas
     de la portada se recortan contra el azul y no dejan picos blancos. */
  .hitos {
    position: relative;
    z-index: 0;
    margin-top: calc(-1 * var(--r-lamina));
    padding-top: calc(4rem + var(--r-lamina));
    padding-bottom: 4rem;
    background-color: var(--color-brand-900);
    background-image: var(--fondo-marino);
    color: #fff;
  }
  @media (min-width: 1024px) { .hitos { padding-top: calc(5.5rem + var(--r-lamina)); padding-bottom: 5.5rem; } }

  .hitos__lista { display: grid; gap: 2.75rem; }
  @media (min-width: 900px) {
    .hitos__lista { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; }
    .hito { padding-inline: 3rem; }
    .hito:first-child { padding-left: 0; }
    .hito + .hito { border-left: 1px solid rgb(34 189 242 / 0.45); }
  }

  .hito__valor {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(3rem, 6vw, 5.4rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-celeste);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .hito__raya {
    display: block;
    width: 3.5rem;
    height: 4px;
    margin-top: 1.4rem;
    border-radius: 4px;
    background: var(--color-celeste);
  }
  .hito__etiqueta {
    margin-top: 1.4rem;
    font-size: clamp(0.9rem, 1.2vw, 1.05rem);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .hito__nota {
    max-width: 26rem;
    margin-top: 0.8rem;
    font-size: clamp(0.95rem, 1.2vw, 1.1rem);
    line-height: 1.55;
    color: rgb(255 255 255 / 0.85);
  }

  /* ── Quiénes somos ────────────────────────────────────────────────── */
  /* La entrada va en azul y a cuerpo mayor: es la frase que resume la
     empresa, y en el gris del texto corrido se perdía entre las demás. */
  .quienes__entrada {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 1.8vw, 1.45rem);
    line-height: 1.3;
    color: var(--color-brand-700);
    font-weight: 600;
  }

  .portafolio__rotulo {
    margin-top: 4rem;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-tinta-45);
  }
  .portafolio {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.9rem;
    margin-top: 1.5rem;
  }
  @media (min-width: 640px) { .portafolio { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .portafolio { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  /* Fotografía arriba, pictograma montado a caballo sobre su borde y
     nombre debajo. La fotografía dice de qué servicio se trata; el
     pictograma es la marca de la casa y da el punto de orden que seis
     fotografías seguidas, cada una con su luz, no tienen por sí solas.

     La tarjeta entera responde: la imagen se acerca, el disco se viste del
     azul corporativo y el conjunto se levanta. */
  .area {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border-radius: var(--r-md);
    background: var(--color-brand-50);
    transition: background-color 0.45s var(--ease-editorial),
      transform 0.5s var(--ease-salida), box-shadow 0.5s var(--ease-editorial);
  }
  .area:hover {
    background: var(--color-brand-100);
    transform: translateY(-5px);
    box-shadow: 0 30px 55px -38px rgb(8 59 128 / 0.6);
  }

  .area__foto {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-brand-100);
  }
  .area__foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.8s var(--ease-salida);
  }
  .area:hover .area__foto img { transform: scale(1.06); }

  /* El velo asienta la fotografía sobre el papel de la tarjeta y le da al
     disco un fondo donde apoyarse. */
  .area__velo {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 45%,
      color-mix(in srgb, var(--color-brand-900) 22%, transparent) 100%
    );
  }

  .area__ic {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 3.1rem;
    height: 3.1rem;
    margin: -1.55rem 0 0 1.25rem;
    border-radius: 999px;
    background: var(--color-papel);
    color: var(--color-brand-700);
    box-shadow: 0 10px 22px -12px rgb(8 59 128 / 0.55);
    transition: background-color 0.45s var(--ease-editorial),

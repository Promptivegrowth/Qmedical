---
import Base from '../layouts/Base.astro';
import Portada from '../components/Portada.astro';
import Icon from '../components/Icon.astro';
import FormularioBase from '../components/FormularioBase.astro';
import { site, contactos, redes, whatsapp, waMensajes } from '../data/site';
import { categorias, productos } from '../data/catalogo';
import { ruta as via, type Idioma } from '../i18n/rutas';
import { textos } from '../i18n/textos';
import { areasEn, categoriaEn, empresaEn, productoEn, waMensajesEn } from '../i18n/contenido';

interface Props {
  lang?: Idioma;
}
const { lang = 'es' } = Astro.props;

const t = textos(lang);
const wa = lang === 'en' ? waMensajesEn : waMensajes;

const mapa =
  'https://www.google.com/maps?q=Av.+Arica+1442,+Bre%C3%B1a,+Lima,+Per%C3%BA&output=embed';

const T = {
  es: {
    meta: 'Contacto y cotizaciones',
    metaDesc:
      'Solicite una cotización de dispositivos médicos y bioseguridad. Oficinas ' +
      'en Av. Arica 1442, Breña, Lima. Teléfono (01) 424-7290 y WhatsApp ' +
      '+51 977 814 006.',
    ante: 'Contacto',
    titulo: 'Cuéntanos qué necesita tu institución y haz de Q-MEDICAL tu aliado estratégico',
    bajada:
      'Abastecemos hospitales, clínicas, centros de salud, retail y ' +
      'distribuidores con un portafolio integral de dispositivos médicos, ' +
      'calidad y respaldo comercial. Encuentra las soluciones que buscas y ' +
      'fortalece tu abastecimiento con un aliado que impulsa el sector salud.',
    remate: '¡Solicita tu cotización hoy y lleva tu abastecimiento al siguiente nivel!',
    telefonos: 'Teléfono',
    cotizaciones: 'Cotizaciones',
    horario: 'Horario',
    formAnte: 'Solicitud de cotización',
    formTitulo: 'Envíenos su requerimiento',
    pasoDatos: 'Sus datos',
    pasoDatosNota: 'Para saber a quién responder.',
    pasoPedido: 'Su requerimiento',
    pasoPedidoNota: 'Cuanto más concreto, más exacta la cotización.',
    respuesta: 'Respuesta dentro del siguiente día hábil',
    formTexto:
      'Complete el formulario y nuestro equipo comercial le responderá con precios, ' +
      'disponibilidad, tiempo de entrega y la documentación técnica que necesite.',
    asunto: 'Solicitud de cotización desde la web',
    lNombre: 'Nombre y apellidos *',
    pNombre: 'Nombre completo',
    lInstitucion: 'Institución o empresa',
    pInstitucion: 'Hospital, clínica, laboratorio…',
    lCorreo: 'Correo electrónico *',
    pCorreo: 'nombre@institucion.pe',
    lTelefono: 'Teléfono *',
    lLinea: 'Línea de producto de interés',
    pLinea: 'Seleccione una línea (opcional)',
    otraLinea: 'Otra o varias líneas',
    lMensaje: 'Detalle de su requerimiento *',
    pMensaje: 'Indique productos, códigos, cantidades y fecha requerida de entrega.',
    consentimiento:
      `Autorizo a ${site.nombre} a utilizar mis datos para atender esta solicitud, ` +
      'conforme a la Ley N.° 29733 de Protección de Datos Personales. *',
    enviar: 'Enviar solicitud',
    obligatorios: 'Los campos con * son obligatorios.',
    oficinas: 'Nuestras oficinas',
    verMapa: 'Ver mapa interactivo',
    abrirMaps: 'Abrir en Google Maps',
    tituloMapa: 'Ubicación de Q-MEDICAL S.A.C. en Av. Arica 1442, Breña, Lima',
    lugarCorto: 'Breña, Lima — Perú',
    correosArea: 'Correos por área',
    siganos: 'Síganos',
    reclamoPregunta: '¿Tiene un reclamo o una queja sobre nuestros productos o servicios?',
    reclamoEnlace: 'Libro de Reclamaciones',
    precarga: (n: string) =>
      'Solicito cotización del producto: ' + n +
      '\n\nCantidad requerida: \nFecha requerida: ',
  },
  en: {
    meta: 'Contact and quotations',
    metaDesc:
      'Request a quotation for medical devices and biosafety products. Offices at ' +
      'Av. Arica 1442, Breña, Lima. Phone (01) 424-7290 and WhatsApp ' +
      '+51 977 814 006.',
    ante: 'Contact',
    titulo: 'Tell us what your institution needs and make Q-MEDICAL your strategic partner',
    bajada:
      'We supply hospitals, clinics, health centres, retail chains and ' +
      'distributors with a complete portfolio of medical devices, quality and ' +
      'commercial backing. Find the solutions you are looking for and ' +
      'strengthen your supply with a partner that drives the health sector.',
    remate: 'Request your quotation today and take your supply to the next level.',
    telefonos: 'Phone',
    cotizaciones: 'Quotations',
    horario: 'Opening hours',
    formAnte: 'Quotation request',
    formTitulo: 'Send us your requirement',
    pasoDatos: 'Your details',
    pasoDatosNota: 'So we know who to reply to.',
    pasoPedido: 'Your requirement',
    pasoPedidoNota: 'The more specific, the more accurate the quotation.',
    respuesta: 'We reply within the next working day',
    formTexto:
      'Fill in the form and our sales team will reply with prices, availability, ' +
      'lead time and whatever technical documentation you need.',
    asunto: 'Quotation request from the website',
    lNombre: 'Full name *',
    pNombre: 'Your full name',
    lInstitucion: 'Institution or company',
    pInstitucion: 'Hospital, clinic, laboratory…',
    lCorreo: 'Email address *',
    pCorreo: 'name@institution.com',
    lTelefono: 'Phone *',
    lLinea: 'Product line of interest',
    pLinea: 'Select a line (optional)',
    otraLinea: 'Another line, or several',
    lMensaje: 'Details of your requirement *',
    pMensaje: 'List products, codes, quantities and the delivery date you need.',
    consentimiento:
      `I authorise ${site.nombre} to use my details to answer this enquiry, in ` +
      'accordance with Peruvian Personal Data Protection Law No. 29733. *',
    enviar: 'Send request',
    obligatorios: 'Fields marked * are required.',
    oficinas: 'Our offices',
    verMapa: 'Load interactive map',
    abrirMaps: 'Open in Google Maps',
    tituloMapa: 'Location of Q-MEDICAL S.A.C. at Av. Arica 1442, Breña, Lima',
    lugarCorto: 'Breña, Lima — Peru',
    correosArea: 'Email by department',
    siganos: 'Follow us',
    reclamoPregunta: 'Do you have a complaint about our products or service?',
    reclamoEnlace: 'Complaints Book',
    precarga: (n: string) =>
      'I would like a quotation for the product: ' + n +
      '\n\nQuantity required: \nDate required: ',
  },
}[lang];

const vias = [
  { ic: 'telefono', t: T.telefonos, l: site.telefonos.map((x) => x.etiqueta), href: site.telefonos[0].href },
  { ic: 'whatsapp', t: 'WhatsApp', l: [site.whatsapp.numero], href: whatsapp(wa.cotizacion), externo: true },
  { ic: 'correo', t: T.cotizaciones, l: [site.correoPrincipal], href: `mailto:${site.correoPrincipal}`, ancha: true },
  { ic: 'reloj', t: T.horario, l: [lang === 'en' ? empresaEn.horario : site.horario] },
];

const lineas = categorias.map((c) => categoriaEn(c, lang));
const directorio = contactos.map((c) => ({
  correo: c.correo,
  area: lang === 'en' ? (areasEn[c.correo] ?? c.area) : c.area,
}));
const pais = lang === 'en' ? empresaEn.pais : site.direccion.pais;

// El nombre del producto que se precarga en el mensaje va en el idioma en que
// se está navegando.
const catalogoJs = productos.map((p) => ({
  slug: p.slug,
  nombre: productoEn(p, lang).nombre,
}));

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contacto — Q-MEDICAL S.A.C.',
  url: site.url + via(lang, 'contacto'),
};
---

<Base lang={lang} clave="contacto" title={T.meta} description={T.metaDesc} schema={schema}>
  <Portada
    lang={lang}
    ante={T.ante}
    titulo={T.titulo}
    texto={T.bajada}
    remate={T.remate}
    migas={[{ nombre: T.ante }]}
    foto="/img/fotos/operario-almacen-1600.webp"
    cine
  />

  <!-- Vías de contacto. Entran escalonadas justo después de la cabecera:
       son lo primero que se busca al llegar a esta página. -->
  <section class="vias__banda bg-[var(--color-papel)] border-b border-[var(--color-linea)]">
    <div class="caja">
      <ul class="vias" data-anim-grupo="140">
        {vias.map((v) => (
          <li class:list={['via', v.ancha && 'via--ancha']} data-anim="sube">
            <p class="via__ic"><Icon name={v.ic} size={22} stroke={1.1} anim /></p>
            <p class="ante mt-4">{v.t}</p>
            <div class="via__valor">
              {v.l.map((x) =>
                v.href ? (
                  <a href={v.href} target={v.externo ? '_blank' : undefined} rel={v.externo ? 'noopener' : undefined}
                    class:list={['block hover:text-[var(--color-brand-700)] transition', v.ancha ? 'via__linea' : 'break-words']}>{x}</a>
                ) : (<span class="block">{x}</span>)
              )}
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Formulario + oficinas -->
  <section id="cotizar" class="aire scroll-mt-20 bg-[var(--color-papel-2)]">
    <div class="caja contacto">
      <div class="min-w-0">
        <p class="ante ante-brand">{T.formAnte}</p>
        <h2 class="display-lg mt-5 max-w-[14ch]">{T.formTitulo}</h2>
        <p class="cuerpo-lg mt-6 max-w-xl">{T.formTexto}</p>

        <!-- Los rótulos se traducen; el atributo name se mantiene en castellano
             a propósito, para que el equipo comercial reciba siempre los correos
             con los mismos campos, venga la consulta en el idioma que venga. -->
        <FormularioBase lang={lang} id="form-cotizacion" asunto={T.asunto} class="formulario">
          <!-- Dos bloques, no una lista de diez campos: primero quién es y
               después qué necesita. Cada uno con su folio y su filete, que es
               lo que convierte un formulario largo en dos pasos cortos. -->
          <fieldset class="bloque">
            <legend class="bloque__rotulo">
              <span class="bloque__folio">01</span>
              <span>
                <span class="bloque__titulo">{T.pasoDatos}</span>
                <span class="bloque__nota">{T.pasoDatosNota}</span>
              </span>
            </legend>

            <div class="rejilla-campos">
              <label>
                <span class="rotulo">{T.lNombre}</span>
                <input id="c-nombre" type="text" name="Nombre" class="campo" required
                  autocomplete="name" placeholder={T.pNombre} />
              </label>
              <label>
                <span class="rotulo">{T.lInstitucion}</span>
                <input id="c-institucion" type="text" name="Institución" class="campo"
                  autocomplete="organization" placeholder={T.pInstitucion} />
              </label>
              <label>
                <span class="rotulo">{T.lCorreo}</span>
                <input id="c-correo" type="email" name="Correo" class="campo" required
                  autocomplete="email" placeholder={T.pCorreo} />
              </label>
              <label>
                <span class="rotulo">{T.lTelefono}</span>
                <input id="c-telefono" type="tel" name="Teléfono" class="campo" required
                  autocomplete="tel" placeholder="+51 9XX XXX XXX" />
              </label>
            </div>
          </fieldset>

          <fieldset class="bloque">
            <legend class="bloque__rotulo">
              <span class="bloque__folio">02</span>
              <span>
                <span class="bloque__titulo">{T.pasoPedido}</span>
                <span class="bloque__nota">{T.pasoPedidoNota}</span>
              </span>
            </legend>

            <div class="rejilla-campos">
              <label class="campo-ancho">
                <span class="rotulo">{T.lLinea}</span>
                <select id="c-linea" name="Línea de interés" class="campo">
                  <option value="">{T.pLinea}</option>
                  {lineas.map((c) => <option value={c.nombre}>{c.nombre}</option>)}
                  <option value="Otra / varias líneas">{T.otraLinea}</option>
                </select>
              </label>
              <label class="campo-ancho">
                <span class="rotulo">{T.lMensaje}</span>
                <textarea id="c-mensaje" name="Mensaje" rows="6" class="campo resize-y" required
                  placeholder={T.pMensaje}></textarea>
              </label>
            </div>
          </fieldset>

          <!-- Pie del formulario: el consentimiento, el envío y lo que pasa
               después, juntos y sobre su propia superficie. -->
          <div class="formulario__pie">
            <label class="consentimiento">
              <input type="checkbox" name="Autoriza el tratamiento de datos" value="Sí" required
                class="mt-1 h-4 w-4 shrink-0 accent-[var(--color-brand-700)]" />
              <span>{T.consentimiento}</span>
            </label>

            <div class="formulario__accion">
              <button type="submit" class="pill pill-brand w-full sm:w-auto">
                {T.enviar}<Icon name="flecha" size={16} />
              </button>
              <p class="formulario__respuesta">
                <Icon name="reloj" size={15} />{T.respuesta}
              </p>
            </div>
            <p class="formulario__nota">{T.obligatorios}</p>
          </div>
        </FormularioBase>
      </div>

      <aside class="min-w-0 space-y-4">
        <div class="tarjeta">
          <h2 class="display-sm">{T.oficinas}</h2>
          <p class="mt-4 flex gap-3 text-[0.93rem] leading-relaxed">
            <Icon name="lugar" size={17} class="mt-0.5 shrink-0 text-[var(--color-brand-700)]" />
            <span data-vivo="direccion">{site.direccion.calle}<br />{site.direccion.distrito} — {site.direccion.ciudad}, {pais}</span>
          </p>

          <!-- El mapa se carga a petición: evita la llamada a Google en cada
               visita y que quede un recuadro en blanco si lo bloquean. -->
          <div id="mapa" class="mapa" data-mapa={mapa} data-titulo={T.tituloMapa}>
            <div class="trama absolute inset-0 opacity-60" aria-hidden="true"></div>
            <div class="relative text-center">
              <Icon name="lugar" size={24} class="mx-auto text-white/50" />
              <p class="mt-3 text-[0.86rem] text-white/85">{T.lugarCorto}</p>
              <button type="button" id="cargar-mapa" class="pill pill-papel mt-4 !min-h-0 !px-4 !py-2 !text-[0.8rem]">
                {T.verMapa}
              </button>
            </div>
          </div>

          <a href="https://www.google.com/maps/search/?api=1&query=Av.+Arica+1442,+Bre%C3%B1a,+Lima,+Per%C3%BA"
            target="_blank" rel="noopener" class="pill pill-linea mt-4 w-full">
            <Icon name="lugar" size={15} />{T.abrirMaps}
          </a>
        </div>

        <div class="tarjeta">
          <h2 class="display-sm">{T.correosArea}</h2>
          <ul class="mt-5 divide-y divide-[var(--color-linea)]" data-vivo-lista="correo">
            <template>
              <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3">
                <span class="text-[0.82rem] text-[var(--color-tinta-45)]" data-campo="etiqueta"></span>
                <a class="break-all text-[0.84rem] text-[var(--color-brand-700)] hover:underline" data-campo="valor"></a>
              </li>
            </template>
            {directorio.map((c) => (
              <li class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 py-3" data-vivo-item>
                <span class="text-[0.82rem] text-[var(--color-tinta-45)]">{c.area}</span>
                <a href={`mailto:${c.correo}`} class="break-all text-[0.84rem] text-[var(--color-brand-700)] hover:underline">
                  {c.correo}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="tarjeta">
          <h2 class="display-sm">{T.siganos}</h2>
          <ul class="mt-5 flex flex-wrap gap-2">
            {[['instagram', 'Instagram'], ['facebook', 'Facebook'], ['linkedin', 'LinkedIn'], ['youtube', 'YouTube'], ['tiktok', 'TikTok'], ['x', 'X']].map(([red, nombre]) => {
              const actual = redes.find((r) => r.icono === red);
              return (
                <li data-red-envoltura hidden={!actual}>
                  <a href={actual?.href ?? '#'} target="_blank" rel="noopener" class="pill pill-linea !min-h-0 !px-4 !py-2 !text-[0.83rem]" data-red={red}>
                    <Icon name={red} size={15} />{nombre}
                  </a>
                </li>
              );
            })}
          </ul>
          <div class="mt-6 border-t border-[var(--color-linea)] pt-5">
            <p class="text-[0.85rem] text-[var(--color-tinta-70)]">{T.reclamoPregunta}</p>
            <a href={via(lang, 'reclamos')} class="enlace mt-3">
              <Icon name="libro" size={16} />{T.reclamoEnlace}
            </a>
          </div>
        </div>
      </aside>
    </div>
  </section>
</Base>

<style>
  .vias { display: grid; grid-template-columns: repeat(1, minmax(0, 1fr)); }
  @media (min-width: 640px) { .vias { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  /* La columna del correo es más ancha: la empresa lo quiere en una sola
     línea, y en un cuarto del ancho se partía en «…qmedicalsac / .com». */
  @media (min-width: 1024px) {
    .vias { grid-template-columns: minmax(0, 0.85fr) minmax(0, 0.75fr) minmax(0, 1.4fr) minmax(0, 1.25fr); }
  }
  /* En dos columnas el correo no cabe en media fila: ocupa la fila entera,
     y el horario lo acompaña para que la rejilla no quede coja. */
  @media (min-width: 640px) and (max-width: 1023px) {
    .via--ancha, .via:last-child { grid-column: span 2; }
  }
  .via__linea {
    white-space: nowrap;
    font-size: clamp(0.8rem, 0.35vw + 0.72rem, 0.93rem);
  }

  /* Cada vía es una teja: el icono dentro de un disco que se viste de azul
     al apuntarla, y la teja entera se levanta un poco. Antes eran cuatro
     columnas separadas por un filete, sin nada que las distinguiera. */
  .via {
    position: relative;
    padding: 2.25rem 1.5rem 2.25rem 0;
    border-top: 1px solid var(--color-linea);
    transition: transform 0.45s var(--ease-salida);
  }
  @media (min-width: 1024px) {
    .via { border-top: 0; padding: 2.75rem 1.5rem; }
    .via + .via { border-left: 1px solid var(--color-linea); }
  }
  .via:hover { transform: translateY(-4px); }

  .via__ic {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    background: var(--color-brand-50);
    color: var(--color-brand-700);
    transition: background-color 0.4s var(--ease-editorial),
      color 0.4s var(--ease-editorial);
  }
  .via:hover .via__ic { background: var(--color-brand-700); color: #fff; }
  .via__valor { margin-top: 0.5rem; font-size: 0.93rem; }

  @media (prefers-reduced-motion: reduce) {
    .via, .via__ic { transition: none; }
    .via:hover { transform: none; }
  }

  .contacto { display: grid; gap: 3rem; }
  @media (min-width: 1024px) {
    .contacto { grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 4rem; align-items: start; }
  }

  /* ── Formulario de cotización ──────────────────────────────────────
     Era una rejilla de campos sueltos dentro de una caja. Ahora es una
     lámina con relieve, dividida en dos bloques numerados, y con un pie
     propio donde viven el permiso, el envío y la promesa de respuesta. */
  /* Va en :global porque el <form> lo pinta FormularioBase: el elemento
     lleva el ámbito de aquel componente, no el de esta página, así que la
     regla con ámbito nunca llegaba a alcanzarlo y la lámina no se veía. Lo
     de dentro sí se escribe aquí, y por eso no necesita :global. */
  :global(.formulario) {
    margin-top: 2.5rem;
    padding: 1.75rem;
    background: var(--color-papel);
    border: 1px solid var(--color-linea);
    border-radius: var(--r-lg);
    box-shadow: 0 36px 70px -56px rgb(8 59 128 / 0.45);
  }
  @media (min-width: 640px) { :global(.formulario) { padding: 2.75rem; } }

  .bloque { border: 0; padding: 0; }
  .bloque + .bloque { margin-top: 2.5rem; padding-top: 2.5rem; border-top: 1px solid var(--color-linea); }

  .bloque__rotulo {
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    padding: 0;
    margin-bottom: 1.6rem;
  }
  .bloque__folio {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    background: var(--color-brand-50);
    color: var(--color-brand-700);
    font-size: 0.82rem;
    font-weight: 500;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .bloque__titulo {
    display: block;
    font-family: var(--font-display-texto);
    font-size: 1.08rem;
    line-height: 1.2;
    font-weight: 700;
  }
  .bloque__nota {
    display: block;
    margin-top: 0.2rem;
    font-size: 0.85rem;
    color: var(--color-tinta-45);
  }

  .rejilla-campos { display: grid; gap: 1.25rem; }
  @media (min-width: 640px) { .rejilla-campos { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  .campo-ancho { grid-column: 1 / -1; }

  .formulario__pie {
    margin-top: 2.5rem;
    padding: 1.6rem;
    border-radius: var(--r-md);
    background: var(--color-papel-2);
  }
  .consentimiento {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.83rem;
    line-height: 1.6;
    color: var(--color-tinta-70);
  }
  .formulario__accion {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 1.4rem;
  }
  .formulario__respuesta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-brand-700);
  }
  .formulario__nota {
    margin-top: 1rem;
    font-size: 0.79rem;
    color: var(--color-tinta-45);
  }

  .tarjeta {
    padding: 1.75rem;
    background: #fff;
    border: 1px solid var(--color-linea);
    border-radius: var(--r-lg);
  }
  @media (min-width: 640px) { .tarjeta { padding: 2rem; } }

  .mapa {
    position: relative;
    display: grid;
    place-items: center;
    height: 15rem;
    margin-top: 1.5rem;
    overflow: hidden;
    border-radius: var(--r-md);
    background: var(--color-brand-950);
  }
</style>

<script is:inline define:vars={{ catalogoJs, plantilla: T.precarga('@') }}>
  // Precarga el producto al llegar desde una ficha: ?producto=slug
  (function () {
    var slug = new URLSearchParams(location.search).get('producto');
    if (!slug) return;
    var prod = catalogoJs.find(function (p) { return p.slug === slug; });
    if (!prod) return;
    var ta = document.getElementById('c-mensaje');
    if (ta && !ta.value) ta.value = plantilla.replace('@', prod.nombre);
  })();
</script>

<script>
  const contenedor = document.getElementById('mapa');
  document.getElementById('cargar-mapa')?.addEventListener('click', () => {
    if (!contenedor) return;
    const marco = document.createElement('iframe');
    marco.src = contenedor.dataset.mapa ?? '';
    marco.title = contenedor.dataset.titulo ?? '';
    marco.width = '100%';
    marco.height = '240';
    marco.style.border = '0';
    marco.loading = 'lazy';
    marco.referrerPolicy = 'no-referrer-when-downgrade';
    contenedor.replaceChildren(marco);
    contenedor.classList.remove('grid', 'place-items-center');
  });
</script>

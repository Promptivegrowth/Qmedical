---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Hero from '../components/Hero.astro';
import MarcasConstelacion from '../components/MarcasConstelacion.astro';
import Clientes from '../components/Clientes.astro';
import Especialidades from '../components/Especialidades.astro';
import Respaldo from '../components/Respaldo.astro';
import { site } from '../data/site';
import { lineas as lineasCat, productosDeLinea, imagenPrincipal } from '../data/catalogo';
import { ruta as via, type Idioma } from '../i18n/rutas';
import { textos } from '../i18n/textos';
import { lineaEn, categoriaEn, productoEn, empresaEn } from '../i18n/contenido';

interface Props {
  lang?: Idioma;
}
const { lang = 'es' } = Astro.props;
const t = textos(lang);


const T = {
  es: {
    meta: 'Q-MEDICAL S.A.C. — Dispositivos médicos y bioseguridad en el Perú',
    metaDesc: site.descripcion,
    lineasAnte: 'Líneas de producto',
    lineasTitulo: 'El catálogo, ordenado en once líneas',
    verCatalogo: 'Ver el catálogo completo',
    lineasCierre: 'Las once líneas, con el buscador y los filtros por categoría.',
    selloBpa: 'Almacén certificado BPA',
    compromisoAnte: 'El compromiso es de nosotros',
    compromisoTitulo: 'Cada entrega sostiene el trabajo de un equipo de salud',
    compromiso: [
      'Más que productos, entregamos confianza, respaldo y trazabilidad: cada ' +
        'solución llega con su documentación técnica, soporte especializado y ' +
        'una atención personalizada.',
      'Así su institución opera con seguridad, eficiencia y continuidad, en ' +
        'beneficio del equipo asistencial y de los pacientes.',
    ],
    conocer: 'Conocer la empresa',
    fotos: [
      'Racks selectivos del almacén central de Q-MEDICAL, con producto paletizado',
      'Apilador eléctrico y transpaleta entre los racks del almacén',
      'Pasillo central del almacén, con racks a ambos lados',
      'Racks con cajas rotuladas y pallets identificados',
    ],
  },
  en: {
    meta: 'Q-MEDICAL S.A.C. — Medical devices and biosafety in Peru',
    metaDesc: empresaEn.descripcion,
    lineasAnte: 'Product lines',
    lineasTitulo: 'The catalogue, ordered into eleven lines',
    verCatalogo: 'See the full catalogue',
    lineasCierre: 'All eleven lines, with the search box and the category filters.',
    selloBpa: 'BPA-certified warehouse',
    compromisoAnte: 'The commitment is ours',
    compromisoTitulo: 'Every delivery sustains the work of a healthcare team',
    compromiso: [
      'More than products, we deliver trust, backing and traceability: every ' +
        'solution arrives with its technical documentation, specialist support ' +
        'and personal attention.',
      'That way your institution runs safely, efficiently and without ' +
        'interruption, for the benefit of the clinical team and of patients.',
    ],
    conocer: 'About the company',
    fotos: [
      'Selective racking at the Q-MEDICAL central warehouse, with palletised product',
      'Electric stacker and pallet truck between the warehouse racks',
      'Central aisle of the warehouse, with racking on both sides',
      'Racking with labelled boxes and identified pallets',
    ],
  },
}[lang];

// Las cuatro fotografias del bloque del compromiso: las del almacén central
// que entregó la empresa en octubre de 2026. El archivo es el mismo en los
// dos idiomas; el pie viene de la tabla de textos.
const ARCHIVOS_FOTOS = [
  'almacen-central-1',
  'almacen-central-2',
  'almacen-central-3',
  'almacen-central-4',
];
const galeria = ARCHIVOS_FOTOS.map((src, i) => ({ src, alt: T.fotos[i] }));

const matriz = lineasCat.map((c, i) => {
  /* Una pieza que represente la línea: la primera suya que tenga foto. Un
     contenedor rojo o un tapete azul dicen más de la línea que un trazo. */
  const muestra = productosDeLinea(c.slug).find((p) => imagenPrincipal(p.slug, 480));
  return {
    ...lineaEn(c, lang),
    corto: lineaEn(c, lang).nombre,
    n: String(i + 1).padStart(2, '0'),
    href: via(lang, 'categoria', c.slug),
    cuenta: t.productosCuenta(productosDeLinea(c.slug).length),
    foto: muestra ? imagenPrincipal(muestra.slug, 480) : '',
    fotoAlt: muestra ? productoEn(muestra, lang).nombre : '',
  };
});

---

<Base
  lang={lang}
  clave="inicio"
  title={T.meta}
  description={T.metaDesc}
  preloader
  cabeceraClara
>
  <Hero lang={lang} />

  <!-- ══════════════════════════════ 01 · Especialidades clínicas -->
  <Especialidades lang={lang} />

  <!-- ══════════════════════════════ 02 · Índice de líneas
       La empresa la encontró «básica, como un formato de Word»: era una
       tabla de filetes finos. Ahora cada línea es una tarjeta con su
       producto sobre un fondo celeste, que se eleva y se viste de marino al
       pasar el puntero, y la duodécima es la llamada al catálogo. -->
  <section id="lineas" class="aire bg-[var(--color-papel-2)]">
    <div class="caja">
      <div class="matriz__intro" data-anim-grupo="80">
        <div>
          <p class="ante ante-brand" data-anim="sube">{T.lineasAnte}</p>
          <h2 class="display-lg mt-5 max-w-[16ch]" data-anim="sube">{T.lineasTitulo}</h2>
        </div>
        <a href={via(lang, 'catalogo')} class="enlace matriz__ir" data-anim="sube">
          {T.verCatalogo}<Icon name="flecha" size={15} />
        </a>
      </div>

      <ol class="matriz" data-anim-grupo="70">
        {matriz.map((c) => (
          <li data-anim="escala">
            <a href={c.href} class="celda">
              <span class="celda__foto">
                <span class="folio celda__folio">{c.n}</span>
                {c.foto
                  ? <img src={c.foto} width="480" height="480" alt={c.fotoAlt} loading="lazy" decoding="async" />
                  : <span class="celda__ic"><Icon name={c.icono} size={40} stroke={1} anim /></span>}
              </span>
              <span class="celda__pie">
                <span class="min-w-0">
                  <span class="celda__nombre">{c.corto}</span>
                  <span class="celda__cuenta">{c.cuenta}</span>
                </span>
                <span class="celda__flecha" aria-hidden="true"><Icon name="flecha" size={16} /></span>
              </span>
            </a>
          </li>
        ))}

        <!-- La duodécima: once líneas no llenan una rejilla, y 2, 3 y 4
             columnas dividen a doce sin resto. -->
        <li data-anim="escala">
          <a href={via(lang, 'catalogo')} class="celda celda--cierre">
            <span class="celda__ic"><Icon name="reticula" size={34} stroke={1.2} anim /></span>
            <span class="celda__pie">
              <span class="min-w-0">
                <span class="celda__nombre">{T.verCatalogo}</span>
                <span class="celda__sintesis">{T.lineasCierre}</span>
              </span>
              <span class="celda__flecha" aria-hidden="true"><Icon name="flecha" size={16} /></span>
            </span>
          </a>
        </li>
      </ol>
    </div>
  </section>

  <!-- ══════════════════════════════ 03 · El compromiso -->
  <section class="aire bg-[var(--color-papel-2)]">
    <div class="caja">
      <!-- Encabezado: el titular manda a la izquierda, la nota acompaña a la
           derecha. Las dos columnas arrancan a la misma altura. -->
      <p class="ante ante-brand" data-anim="sube">{T.compromisoAnte}</p>
      <div class="compromiso__alto alto-alineado" data-anim-grupo="90">
        <h2 class="display-lg" data-anim="sube">{T.compromisoTitulo}</h2>

        <div class="compromiso__nota alto-alineado__texto" data-anim="sube">
          <p class="compromiso__entrada">{T.compromiso[0]}</p>
          <p class="compromiso__apoyo">{T.compromiso[1]}</p>
        </div>
      </div>

      <!-- Retícula de fotografías: dos columnas iguales, mismo alto y mismo
           medianil. Cada una se descubre de abajo arriba al entrar en
           pantalla, y su imagen suelta el acercamiento con el que llega. -->
      <div class="compromiso__fotos" data-anim-grupo="120">
        {galeria.map((f, i) => (
          <figure class="foto" data-anim="cortina" data-espera-foto>
            <span class="foto__lente">
              <span class="foto__plano parallax" data-parallax={0.03 + i * 0.008}>
              <img
                src={`/img/fotos/${f.src}-1000.webp`}
                srcset={`/img/fotos/${f.src}-640.webp 640w, /img/fotos/${f.src}-1000.webp 1000w`}
                sizes="(min-width: 900px) 46vw, 92vw"
                width="1000"
                height="667"
                loading="lazy"
                decoding="async"
                alt={f.alt}
                style={`--cine-retraso: ${i * -6}s`}
              />
              </span>
            </span>
            {i === 0 && (
              <figcaption class="foto__sello">
                <Icon name="certificado" size={15} />
                <span>{T.selloBpa}</span>
              </figcaption>
            )}
          </figure>
        ))}
      </div>

      {/* Cierre: el enlace sobre su filete. La fila de cifras —años, marcas
          y productos— se retiró a pedido de la empresa (OBSERVACIONES 3):
          pidió quitar los totales de marcas y productos de todas las
          páginas, y en su captura tachó la fila entera. */}
      <div class="compromiso__cierre" data-anim="sube">
        <a href={via(lang, 'nosotros')} class="enlace compromiso__enlace">
          {T.conocer}<Icon name="flecha" size={15} />
        </a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ 04 · Respaldo -->
  <Respaldo lang={lang} />

  <!-- ══════════════════════════════ 05 · Clientes -->
  <Clientes lang={lang} />

  <!-- ══════════════════════════════ 06 · Marcas (anillo, intacto) -->
  <MarcasConstelacion lang={lang} />
</Base>

<style>
  /* ── Índice de líneas ─────────────────────────────────────────────── */
  .matriz__intro {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem 3rem;
  }
  .matriz__ir { margin-bottom: 0.4rem; }

  .matriz {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin-top: 3.5rem;
  }
  @media (min-width: 768px) { .matriz { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; } }
  @media (min-width: 1100px) { .matriz { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; } }
  .matriz > li { display: flex; }

  .celda {
    position: relative;
    display: flex;
    flex-direction: column;
    width: 100%;
    padding: 0.6rem;
    border: 1px solid var(--color-linea);
    border-radius: 1.1rem;
    background: var(--color-papel);
    color: var(--color-tinta);
    box-shadow: 0 1px 2px rgb(4 26 66 / 0.04);
    transition: transform 0.5s var(--ease-salida), box-shadow 0.5s var(--ease-editorial),
      border-color 0.4s var(--ease-editorial), background-color 0.45s var(--ease-editorial),
      color 0.45s var(--ease-editorial);
  }
  .celda:hover,
  .celda:focus-visible {
    transform: translateY(-6px);
    border-color: var(--color-brand-900);
    background-color: var(--color-brand-900);
    color: #fff;
    box-shadow: 0 26px 50px -26px rgb(4 26 66 / 0.55);
  }

  /* La foto del producto, sobre un celeste muy claro: recortado sobre
     blanco puro, el producto se perdía contra la tarjeta. */
  .celda__foto {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    border-radius: 0.75rem;
    background:
      radial-gradient(70% 70% at 50% 45%, #fff 0%, rgb(255 255 255 / 0) 75%),
      var(--color-brand-50);
    overflow: hidden;
  }
  .celda__foto img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 11%;
    mix-blend-mode: multiply;
    transition: transform 0.8s var(--ease-salida);
  }
  .celda:hover .celda__foto img { transform: scale(1.07); }
  .celda__folio {
    position: absolute;
    top: 0.7rem;
    left: 0.85rem;
    z-index: 1;
    font-size: 0.78rem;
    color: var(--color-brand-700);
  }

  .celda__ic {
    display: grid;
    place-items: center;
    width: 4.25rem;
    height: 4.25rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.12);
    border: 1px solid rgb(158 219 255 / 0.35);
    color: var(--color-celeste);
  }

  .celda__pie {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: auto;
    padding: 1rem 0.55rem 0.45rem;
  }
  .celda__nombre {
    display: block;
    font-family: var(--font-display-texto);
    font-size: 1.02rem;
    line-height: 1.2;
  }
  .celda__cuenta {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-tinta-45);
    transition: color 0.45s var(--ease-editorial);
  }
  .celda:hover .celda__cuenta { color: var(--color-celeste-suave); }

  /* La flecha en círculo, como los botones de las tarjetas de la referencia. */
  .celda__flecha {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 999px;
    border: 1px solid var(--color-linea);
    color: var(--color-brand-700);
    transition: background-color 0.4s var(--ease-editorial), border-color 0.4s var(--ease-editorial),
      color 0.4s var(--ease-editorial), transform 0.5s var(--ease-salida);
  }
  .celda:hover .celda__flecha {
    background: var(--color-celeste);
    border-color: var(--color-celeste);
    color: var(--color-brand-950);
    transform: translateX(3px);
  }

  /* La llamada al catálogo, ya vestida de marino. */
  .celda--cierre {
    padding: 1.4rem 1rem 0.6rem;
    border-color: transparent;
    background-color: var(--color-brand-900);
    background-image: var(--fondo-marino);
    color: #fff;
  }
  .celda--cierre .celda__flecha { border-color: rgb(158 219 255 / 0.4); color: var(--color-celeste); }
  .celda__sintesis {
    display: block;
    margin-top: 0.45rem;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--color-celeste-suave);
  }
  @media (max-width: 520px) {
    .celda__pie { padding-inline: 0.3rem; }
    .celda__flecha { width: 2rem; height: 2rem; }
    .celda__nombre { font-size: 0.92rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .celda, .celda__foto img, .celda__flecha { transition: none; }
  }

  /* ── El compromiso ────────────────────────────────────────────────
     Todo se apoya en la misma retícula: el titular ocupa siete de doce
     columnas, la nota las cinco restantes, y las fotografías se parten por
     la mitad exacta. Los medianiles verticales de las dos filas de fotos
     coinciden, que es lo que hace que el bloque se lea alineado.          */
  .compromiso__alto { margin-top: 1.25rem; }

  /* La nota arranca a la altura del titular, no del antetítulo: la
     empresa la vio «muy arriba y no a la misma altura que el título
     principal». El primer párrafo sube de cuerpo —era texto corrido gris y
     se leía «muy simple»— y el segundo cuelga de un filete celeste. */
  .compromiso__nota { display: grid; gap: 1.4rem; }
  .compromiso__entrada {
    font-family: var(--font-display-texto);
    font-size: clamp(1.15rem, 1.6vw, 1.38rem);
    line-height: 1.45;
    color: var(--color-brand-900);
  }
  .compromiso__apoyo {
    padding-left: 1.1rem;
    border-left: 2px solid var(--color-celeste);
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--color-tinta-70);
  }

  /* ── Retícula de fotografías ──────────────────────────────────────── */
  .compromiso__fotos {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--medianil);
    margin-top: 3.5rem;
  }
  @media (min-width: 640px) {
    .compromiso__fotos { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) { .compromiso__fotos { margin-top: 4.5rem; } }

  .foto {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    border-radius: var(--r-md);
    background: var(--color-brand-50);
  }
  /* Tres capas, una transformación cada una, y en este orden por un motivo:
     la lente es la que recibe el recorte de la cortina, así que tiene que
     quedarse quieta —si se moviera, su caja de recorte se movería con ella y
     descubriría el fondo por abajo—; el plano lleva el parallax, y la imagen,
     el acercamiento lento. */
  .foto__lente {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
  }
  .foto__plano {
    position: absolute;
    inset: -10% 0 auto 0;
    display: block;
    width: 100%;
    /* Un 10 % de holgura arriba y abajo: más de lo que puede desplazar el
       parallax con los factores de esta sección, así que la lente nunca
       descubre el fondo. */
    height: 120%;
  }
  .foto img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Acercamiento lento y continuo, de ida y vuelta. Cada fotografía entra
       en un punto distinto del ciclo —de ahí el retraso negativo— para que
       las cuatro no respiren a la vez. Solo corre cuando la fotografía ya se
       ha descubierto: hasta entonces no gasta nada. */
    animation: cine 34s ease-in-out infinite alternate var(--cine-retraso, 0s);
    animation-play-state: paused;
  }
  .foto.visible img { animation-play-state: running; }

  @keyframes cine {
    from { transform: scale(1); }
    to { transform: scale(1.12); }
  }
  .foto__sello {
    position: absolute;
    left: 0;
    bottom: 1.25rem;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1rem;
    background: var(--color-brand-700);
    color: #fff;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    white-space: nowrap;
  }
  @media (max-width: 520px) {
    .foto__sello { font-size: 0.62rem; padding: 0.45rem 0.7rem; gap: 0.35rem; }
  }

  /* ── Cierre: el enlace ─────────────────────────────────────────────── */
  .compromiso__cierre {
    display: flex;
    justify-content: flex-end;
    margin-top: 3rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--color-linea);
  }

  @media (prefers-reduced-motion: reduce) {
    .foto img { animation: none; }
  }

  /* ── Cabeceras y rejilla ──────────────────────────────────────────── */
  .cabecera-seccion {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }
</style>

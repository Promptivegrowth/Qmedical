---
import Base from '../layouts/Base.astro';
import MarcasConstelacion from '../components/MarcasConstelacion.astro';
import CtaContacto from '../components/CtaContacto.astro';
import type { Idioma } from '../i18n/rutas';

/**
 * Marcas asociadas.
 *
 * El anillo de logotipos y la llamada a contacto. El directorio de fichas
 * por marca —«Por qué elegimos a estos fabricantes»— se retiró a pedido de
 * la empresa en octubre de 2026 (OBSERVACIONES 3: «quitar toda esta
 * sección»). Las marcas siguen nombradas en cada producto del catálogo.
 */
interface Props {
  lang?: Idioma;
}
const { lang = 'es' } = Astro.props;

const T = {
  es: {
    meta: 'Marcas asociadas',
    metaDesc:
      'Q-MEDICAL S.A.C. representa y distribuye marcas de dispositivos médicos ' +
      'y bioseguridad: Medcaptain, MAXCON, NEX CLOREX, Alleva Medical, GEYI, ' +
      'Comfort Rubber Gloves, Silpak, Xodus y más.',
    ctaTitulo: '¿Busca una marca que no aparece aquí?',
    ctaTexto:
      'Gestionamos requerimientos específicos directamente con los fabricantes ' +
      'que representamos. Cuéntenos qué necesita y le confirmamos disponibilidad ' +
      'y documentación técnica.',
  },
  en: {
    meta: 'Partner brands',
    metaDesc:
      'Q-MEDICAL S.A.C. represents and distributes medical device and biosafety ' +
      'brands: Medcaptain, MAXCON, NEX CLOREX, Alleva Medical, GEYI, Comfort ' +
      'Rubber Gloves, Silpak, Xodus and more.',
    ctaTitulo: 'Looking for a brand that is not listed here?',
    ctaTexto:
      'We handle specific requirements directly with the manufacturers we ' +
      'represent. Tell us what you need and we will confirm availability and ' +
      'technical documentation.',
  },
}[lang];
---

<Base lang={lang} clave="marcas" title={T.meta} description={T.metaDesc} cabeceraClara>
  <MarcasConstelacion lang={lang} />

  <CtaContacto lang={lang} titulo={T.ctaTitulo} texto={T.ctaTexto} />
</Base>

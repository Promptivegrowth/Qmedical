---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site, whatsapp, waMensajes } from '../data/site';
---

<Base
  title="Mensaje recibido"
  description="Hemos recibido su mensaje. El equipo de Q-MEDICAL S.A.C. le responderá a la brevedad."
>
  <section class="grid min-h-[70svh] place-items-center bg-[var(--color-papel)] py-24">
    <div class="caja text-center">
      <p class="disco-visto"><Icon name="visto" size={30} /></p>
      <p class="ante ante-brand mt-8">Solicitud registrada</p>
      <h1 class="display-lg mt-5 mx-auto max-w-[16ch]">Recibimos su mensaje</h1>
      <p class="cuerpo-lg mx-auto mt-6 max-w-xl">
        Gracias por escribirnos. Nuestro equipo revisará su solicitud y le responderá
        dentro del siguiente día hábil al correo que registró.
      </p>
      <p class="mt-6 text-[0.88rem] text-[var(--color-tinta-45)]">
        Si su requerimiento es urgente, escríbanos por WhatsApp al
        <a href={whatsapp(waMensajes.general)} target="_blank" rel="noopener"
          class="text-[var(--color-brand-700)] underline underline-offset-4">{site.whatsapp.numero}</a>
        o llámenos al {site.telefonos[0].etiqueta}.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3">
        <a href="/catalogo" class="pill pill-tinta">Ver catálogo<Icon name="flecha" size={16} /></a>
        <a href="/" class="pill pill-linea">Volver al inicio</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .disco-visto {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    margin-inline: auto;
    border-radius: 999px;
    background: var(--color-brand-50);
    color: var(--color-brand-700);
  }
</style>

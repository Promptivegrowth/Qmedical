---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import Icon from '../components/Icon.astro';
import MarcasCarrusel from '../components/MarcasCarrusel.astro';
import CtaContacto from '../components/CtaContacto.astro';
import { marcas } from '../data/marcas';
import { productoPorSlug, type Producto } from '../data/catalogo';

// Se resuelve en el frontmatter: las plantillas de Astro no admiten predicados de tipo.
const fichasMarcas = marcas.map((m) => ({
  marca: m,
  items: m.productos
    .map((s) => productoPorSlug.get(s))
    .filter(Boolean) as Producto[],
}));
---

<Base
  title="Marcas asociadas"
  description={`Q-MEDICAL S.A.C. representa y distribuye ${marcas.length} marcas de dispositivos médicos y bioseguridad: Medcaptain, Maxcon, Nex Medical, Alleva Medical, Geyi, Comfort Rubber Gloves, Silpak, Xodus y más.`}
>
  <PageHeader
    eyebrow="Alianzas"
    titulo={`${marcas.length} marcas representadas y distribuidas`}
    texto="Seleccionamos a nuestros proveedores por la consistencia de su documentación técnica y la estabilidad de su suministro. Cada marca cubre una necesidad concreta del servicio asistencial."
    migas={[{ nombre: 'Marcas' }]}
  />

  <section class="border-b border-line bg-white py-10">
    <MarcasCarrusel titulo="Marcas asociadas a Q-MEDICAL" />
  </section>

  <section class="bg-surface py-16 lg:py-24">
    <div class="container-q">
      <ul class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
        {
          fichasMarcas.map(({ marca: m, items }, i) => (
              <li id={m.slug} class="scroll-mt-28 reveal" data-delay={(i % 3) * 80}>
                <article class="card flex h-full flex-col p-7">
                  <div class="flex h-16 items-center">
                    <img
                      src={`/img/marcas/${m.slug}.webp`}
                      srcset={`/img/marcas/${m.slug}-1x.webp 1x, /img/marcas/${m.slug}.webp 2x`}
                      height="52"
                      alt={m.nombre}
                      loading="lazy"
                      decoding="async"
                      class="max-h-[3.25rem] w-auto max-w-[11rem] object-contain"
                    />
                  </div>

                  <p class="mt-6 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-brand-700">
                    {m.linea}
                  </p>
                  <h2 class="mt-2 text-[1.05rem] font-semibold">{m.nombre}</h2>
                  <p class="mt-3 flex-1 text-[0.88rem] leading-relaxed text-muted">{m.resumen}</p>

                  {items.length > 0 ? (
                    <ul class="mt-6 space-y-1.5 border-t border-line pt-5">
                      {items.slice(0, 5).map((prod) => (
                        <li>
                          <a
                            href={`/productos/${prod.slug}`}
                            class="group flex items-start gap-2 text-[0.85rem] text-ink/80 transition hover:text-brand-700"
                          >
                            <Icon
                              name="arrow"
                              size={14}
                              class="mt-1 shrink-0 text-brand-300 transition group-hover:translate-x-0.5 group-hover:text-brand-700"
                            />
                            <span>{prod.nombre}</span>
                          </a>
                        </li>
                      ))}
                      {items.length > 5 && (
                        <li class="pt-1 text-[0.8rem] text-muted">
                          y {items.length - 5} producto{items.length - 5 === 1 ? '' : 's'} más
                        </li>
                      )}
                    </ul>
                  ) : (
                    <p class="mt-6 border-t border-line pt-5 text-[0.82rem] text-muted">
                      Disponible bajo consulta.{' '}
                      <a href="/contacto#cotizar" class="text-brand-700 underline underline-offset-4">
                        Solicitar información
                      </a>
                    </p>
                  )}
                </article>
              </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaContacto
    titulo="¿Busca una marca o un producto que no aparece aquí?"
    texto="Gestionamos requerimientos específicos directamente con los fabricantes que representamos. Cuéntenos qué necesita y le confirmamos disponibilidad y documentación técnica."
  />
</Base>

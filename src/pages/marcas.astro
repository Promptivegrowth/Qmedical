---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import MarcasConstelacion from '../components/MarcasConstelacion.astro';
import CtaContacto from '../components/CtaContacto.astro';
import { marcas } from '../data/marcas';
import { productoPorSlug, imagenPrincipal, type Producto } from '../data/catalogo';

const fichas = marcas.map((m, i) => ({
  marca: m,
  n: String(i + 1).padStart(2, '0'),
  items: m.productos.map((s) => productoPorSlug.get(s)).filter(Boolean) as Producto[],
}));
---

<Base
  title="Marcas asociadas"
  description={`Q-MEDICAL S.A.C. representa y distribuye ${marcas.length} marcas de dispositivos médicos y bioseguridad: Medcaptain, Maxcon, Nex Medical, Alleva Medical, Geyi, Comfort Rubber Gloves, Silpak, Xodus y más.`}
  cabeceraClara
>
  <MarcasConstelacion />

  <section class="aire bg-[var(--color-papel)]">
    <div class="caja">
      <div class="intro" data-anim-grupo="80">
        <div>
          <p class="ante ante-brand" data-anim="sube">El criterio</p>
          <h2 class="display-lg mt-5 max-w-[15ch]" data-anim="sube">
            Por qué elegimos a estos fabricantes
          </h2>
        </div>
        <p class="cuerpo-lg max-w-xl" data-anim="sube">
          Seleccionamos a nuestros proveedores por dos condiciones sin las cuales una
          institución de salud no puede planificar: la consistencia de su documentación
          técnica y la estabilidad de su suministro. Un producto sin ficha vigente no
          entra a un expediente; un proveedor que no sostiene la producción rompe una
          programación anual.
        </p>
      </div>

      <!-- Directorio de marcas, en fichas de revista -->
      <ol class="directorio" data-anim-grupo="60">
        {fichas.map(({ marca: m, n, items }) => (
          <li id={m.slug} class="scroll-mt-28" data-anim="sube">
            <article class="marca-ficha">
              <div class="marca-ficha__alto">
                <span class="folio">{n}</span>
                <span class="marca-ficha__linea">{m.linea}</span>
              </div>

              <div class="marca-ficha__logo">
                <img
                  src={`/img/marcas/${m.slug}.webp`}
                  srcset={`/img/marcas/${m.slug}-1x.webp 1x, /img/marcas/${m.slug}.webp 2x`}
                  height="52" alt={m.nombre} loading="lazy" decoding="async"
                />
              </div>

              <h3 class="marca-ficha__nombre">{m.nombre}</h3>
              <p class="marca-ficha__texto">{m.resumen}</p>

              {items.length > 0 ? (
                <ul class="marca-ficha__lista">
                  {items.slice(0, 4).map((prod) => (
                    <li>
                      <a href={`/productos/${prod.slug}`} class="mini">
                        <img src={imagenPrincipal(prod.slug, 480)} width="480" height="480"
                          alt="" loading="lazy" decoding="async" />
                        <span class="min-w-0 truncate">{prod.nombre}</span>
                        <Icon name="flecha" size={13} class="ml-auto shrink-0 opacity-30" />
                      </a>
                    </li>
                  ))}
                  {items.length > 4 && (
                    <li class="marca-ficha__resto">y {items.length - 4} producto{items.length - 4 === 1 ? '' : 's'} más</li>
                  )}
                </ul>
              ) : (
                <p class="marca-ficha__consulta">
                  Disponible bajo consulta.
                  <a href="/contacto#cotizar" class="underline underline-offset-4">Solicitar información</a>
                </p>
              )}
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <CtaContacto
    titulo="¿Busca una marca que no aparece aquí?"
    texto="Gestionamos requerimientos específicos directamente con los fabricantes que representamos. Cuéntenos qué necesita y le confirmamos disponibilidad y documentación técnica."
  />
</Base>

<style>
  .intro { display: grid; gap: 2.5rem; }
  @media (min-width: 1024px) {
    .intro { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 5rem; align-items: end; }
  }

  .directorio {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 4rem;
  }
  @media (min-width: 768px) { .directorio { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1280px) { .directorio { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .marca-ficha {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 1.75rem;
    background: #fff;
    border: 1px solid var(--color-linea);
    border-radius: var(--r-lg);
    transition: border-color 0.35s, transform 0.45s var(--ease-salida);
  }
  .marca-ficha:hover { border-color: var(--color-linea-2); transform: translateY(-3px); }

  .marca-ficha__alto {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-linea);
  }
  .marca-ficha__linea {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-brand-700);
    text-align: right;
  }

  .marca-ficha__logo { display: flex; align-items: center; height: 4.5rem; margin-top: 1.5rem; }
  .marca-ficha__logo img { max-height: 3.25rem; width: auto; max-width: 11rem; object-fit: contain; }

  .marca-ficha__nombre {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.3rem;
    line-height: 1.2;
  }
  .marca-ficha__texto {
    margin-top: 0.75rem;
    font-size: 0.885rem;
    line-height: 1.6;
    color: var(--color-tinta-70);
  }

  .marca-ficha__lista {
    margin-top: auto;
    padding-top: 1.5rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.3rem;
  }
  .marca-ficha__lista > li { min-width: 0; }
  .mini {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.45rem 0.5rem;
    border-radius: var(--r-sm);
    font-size: 0.845rem;
    color: var(--color-tinta-70);
    transition: background-color 0.25s, color 0.25s;
  }
  .mini:hover { background: var(--color-papel-2); color: var(--color-tinta); }
  .mini img {
    width: 2rem;
    height: 2rem;
    flex: none;
    object-fit: contain;
    border-radius: 4px;
    background: var(--color-papel-2);
    padding: 0.15rem;
  }
  .marca-ficha__resto {
    padding: 0.35rem 0.5rem;
    font-size: 0.79rem;
    color: var(--color-tinta-45);
  }
  .marca-ficha__consulta {
    margin-top: auto;
    padding-top: 1.5rem;
    font-size: 0.85rem;
    color: var(--color-tinta-45);
  }
</style>

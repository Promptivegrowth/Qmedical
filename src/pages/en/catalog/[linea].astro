---
// Una línea del catálogo, con sus categorías. In English.
import PaginaLinea from '../../../plantillas/PaginaLinea.astro';
import { lineaPorSlug } from '../../../data/catalogo';

const linea = lineaPorSlug.get(Astro.params.linea!);
if (!linea) return Astro.rewrite('/404');
---

<PaginaLinea lang="en" linea={linea} />

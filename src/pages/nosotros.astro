---
import Base from '../layouts/Base.astro';
import Portada from '../components/Portada.astro';
import Icon from '../components/Icon.astro';
import CtaContacto from '../components/CtaContacto.astro';
import { site, valores, certificaciones } from '../data/site';
import { marcas } from '../data/marcas';
import { categorias, productos } from '../data/catalogo';

const galeria = [
  { src: 'almacen-p1360322', alt: 'Pasillo principal de racks del almacén central de Q-MEDICAL', ancho: true },
  { src: 'almacen-p1360352', alt: 'Racks selectivos con productos identificados y rotulados' },
  { src: 'almacen-p1360349', alt: 'Zona de acopio con productos paletizados y señalización de piso' },
  { src: 'almacen-p1360288', alt: 'Estanterías con cajas de producto terminado ordenadas por lote' },
  { src: 'almacen-p1360328', alt: 'Vista del almacén hacia la zona de despacho' },
];

const controles = [
  { t: 'Recepción', d: 'Verificación documental y de integridad de empaque antes de ingresar cualquier lote.' },
  { t: 'Almacenamiento', d: 'Segregado y rotulado por lote y fecha de vencimiento, en racks identificados.' },
  { t: 'Rotación', d: 'Bajo criterio de primero en vencer, primero en salir, sin excepciones.' },
  { t: 'Trazabilidad', d: 'Registro que permite rastrear cualquier unidad desde la recepción hasta el despacho.' },
];
---

<Base
  title={`Nosotros — ${site.anios} años abasteciendo al sector salud del Perú`}
  description="Q-MEDICAL S.A.C. es una droguería peruana fundada en 2003, certificada en Buenas Prácticas de Almacenamiento por DIGEMID, ISO 37001 e ISO 14001. Conozca nuestra misión, infraestructura y certificaciones."
  image="/img/fotos/equipo-almacen-1600.webp"
>
  <Portada
    ante={`Desde ${site.fundacion} · ${site.anios} años`}
    titulo="Una empresa peruana comprometida con la salud del país"
    texto="Trabajamos para que las instituciones de salud estatales y privadas dispongan de productos médicos, de bioseguridad y de protección personal de alta calidad, junto a nuestros proveedores alrededor del mundo."
    migas={[{ nombre: 'Nosotros' }]}
    foto="/img/fotos/almacen-p1360352-1600.webp"
    dato={{ valor: String(site.anios), etiqueta: 'años de operación' }}
  />

  <!-- ── Cifras ──────────────────────────────────────────────────────── -->
  <section class="bg-[var(--color-papel)] border-b border-[var(--color-linea)]">
    <div class="caja">
      <dl class="cifras" data-anim-grupo="80">
        {[
          { v: String(site.fundacion), e: 'Año de fundación', n: 'Más de dos décadas en el sector' },
          { v: String(marcas.length), e: 'Marcas representadas', n: 'Fabricantes de todo el mundo' },
          { v: String(productos.length), e: 'Productos en catálogo', n: `En ${categorias.length} especialidades` },
          { v: '49', e: 'Fichas técnicas', n: 'Documentación pública en PDF' },
        ].map((c) => (
          <div data-anim="sube">
            <dd class="cifras__valor">{c.v}</dd>
            <dt class="cifras__etiqueta">{c.e}</dt>
            <p class="cifras__nota">{c.n}</p>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ── Quiénes somos ───────────────────────────────────────────────── -->
  <section class="aire bg-[var(--color-papel)]">
    <div class="caja quienes" data-anim-grupo="90">
      <div>
        <p class="ante ante-brand" data-anim="sube">Quiénes somos</p>
        <h2 class="display-lg mt-5 max-w-[13ch]" data-anim="sube">Una droguería, no un intermediario</h2>
      </div>
      <div class="cuerpo-lg" data-anim="sube">
        <p>
          Q-MEDICAL S.A.C. inició actividades en enero de {site.fundacion} y hoy es una
          droguería especializada en la comercialización de dispositivos médicos de alta
          calidad. Contamos con la certificación de Buenas Prácticas de Almacenamiento
          otorgada por DIGEMID y representamos y distribuimos productos de compañías
          reconocidas a nivel mundial.
        </p>
        <p>
          Esa condición cambia lo que podemos ofrecer: no solo colocamos un producto,
          respondemos por su conservación, su trazabilidad documental y su ficha técnica
          frente al área usuaria, al comité de compras y a la autoridad sanitaria.
        </p>
        <p>
          Atendemos a instituciones médicas de todas las regiones del país —hospitales,
          clínicas, laboratorios y centros geriátricos— tanto en compra directa como en
          procesos de licitación pública.
        </p>
      </div>
    </div>
  </section>

  <!-- ── Misión, visión, filosofía ───────────────────────────────────── -->
  <section class="aire bg-[var(--color-papel-2)]">
    <div class="caja">
      <ol class="valores" data-anim-grupo="100">
        {valores.map((v, i) => (
          <li class="valor" data-anim="sube">
            <span class="folio">{String(i + 1).padStart(2, '0')}</span>
            <h2 class="valor__titulo">{v.titulo}</h2>
            <p class="valor__texto">{v.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── Infraestructura ─────────────────────────────────────────────── -->
  <section id="infraestructura" class="aire scroll-mt-20 bg-[var(--color-papel)]">
    <div class="caja">
      <div class="infra__intro" data-anim-grupo="80">
        <div>
          <p class="ante ante-brand" data-anim="sube">Infraestructura</p>
          <h2 class="display-lg mt-5 max-w-[14ch]" data-anim="sube">
            Un almacén que responde por el producto
          </h2>
        </div>
        <p class="cuerpo-lg max-w-xl" data-anim="sube">
          La certificación BPA no es un sello en la pared: es un régimen de control sobre
          la recepción, el almacenamiento, la conservación y el despacho de cada lote.
        </p>
      </div>

      <ol class="controles" data-anim-grupo="70">
        {controles.map((c, i) => (
          <li class="control" data-anim="sube">
            <span class="folio">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="control__titulo">{c.t}</h3>
            <p class="control__texto">{c.d}</p>
          </li>
        ))}
      </ol>

      <div class="galeria" data-anim-grupo="60">
        {galeria.map((g) => (
          <figure class:list={['lamina galeria__pieza', g.ancho && 'galeria__pieza--ancha']} data-anim="cortina">
            <img
              src={`/img/fotos/${g.src}-1000.webp`}
              srcset={`/img/fotos/${g.src}-640.webp 640w, /img/fotos/${g.src}-1000.webp 1000w, /img/fotos/${g.src}-1600.webp 1600w`}
              sizes={g.ancho ? '(min-width: 768px) 62vw, 92vw' : '(min-width: 768px) 30vw, 92vw'}
              width="1000" height="750" alt={g.alt} loading="lazy" decoding="async"
            />
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Certificaciones ─────────────────────────────────────────────── -->
  <section id="certificaciones" class="certif scroll-mt-20">
    <div class="caja">
      <div class="flex flex-wrap items-end justify-between gap-8" data-anim-grupo="80">
        <div>
          <p class="ante ante-claro" data-anim="sube">Certificaciones y acreditaciones</p>
          <h2 class="display-lg mt-5 max-w-[16ch]" data-anim="sube">
            Estándares que se auditan, no que se declaran
          </h2>
        </div>
      </div>

      <ol class="certif__lista" data-anim-grupo="100">
        {certificaciones.map((c, i) => (
          <li class="certif__item" data-anim="sube">
            <span class="folio certif__folio">{String(i + 1).padStart(2, '0')}</span>
            <p class="certif__sigla">{c.sigla}</p>
            <p class="certif__nombre">{c.nombre}</p>
            <p class="certif__detalle">{c.detalle}</p>
            <p class="certif__emisor">{c.emisor}</p>
          </li>
        ))}
      </ol>

      <a href="/fichas-tecnicas" class="pill pill-papel mt-12" data-anim="sube">
        <Icon name="documento" size={16} />Ver la documentación técnica
      </a>
    </div>
  </section>

  <CtaContacto />
</Base>

<style>
  /* ── Cifras ───────────────────────────────────────────────────────── */
  .cifras { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  @media (min-width: 900px) { .cifras { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .cifras > div { padding: 2.5rem 1.5rem 2.5rem 0; border-top: 1px solid var(--color-linea); }
  @media (min-width: 900px) {
    .cifras > div { border-top: 0; }
    .cifras > div + div { border-left: 1px solid var(--color-linea); padding-left: 2.5rem; }
  }
  .cifras__valor {
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.4rem, 4.5vw, 3.6rem);
    line-height: 1;
    color: var(--color-brand-700);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .cifras__etiqueta { margin-top: 0.85rem; font-size: 0.9rem; font-weight: 500; }
  .cifras__nota { margin-top: 0.3rem; font-size: 0.8rem; color: var(--color-tinta-45); }

  /* ── Quiénes somos ────────────────────────────────────────────────── */
  .quienes { display: grid; gap: 2.5rem; }
  @media (min-width: 1024px) {
    .quienes { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr); gap: 5rem; }
  }

  /* ── Valores ──────────────────────────────────────────────────────── */
  .valores { display: grid; border-top: 1px solid var(--color-linea-2); }
  @media (min-width: 900px) { .valores { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .valor { padding: 2.5rem 0; border-bottom: 1px solid var(--color-linea-2); }
  @media (min-width: 900px) {
    .valor { padding: 3rem 2.5rem 3rem 0; border-bottom: 0; }
    .valor + .valor { border-left: 1px solid var(--color-linea-2); padding-left: 2.5rem; }
  }
  .valor__titulo {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.7rem, 2.6vw, 2.2rem);
    letter-spacing: -0.015em;
  }
  .valor__texto { margin-top: 1rem; font-size: 0.95rem; line-height: 1.65; color: var(--color-tinta-70); }

  /* ── Infraestructura ──────────────────────────────────────────────── */
  .infra__intro { display: grid; gap: 2.5rem; }
  @media (min-width: 1024px) {
    .infra__intro { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 5rem; align-items: end; }
  }
  .controles {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 0;
    margin-top: 3.5rem;
    border-top: 1px solid var(--color-linea);
  }
  @media (min-width: 640px) { .controles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .controles { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .control { padding: 1.75rem 1.5rem 1.75rem 0; border-bottom: 1px solid var(--color-linea); }
  @media (min-width: 1100px) {
    .control { border-bottom: 0; }
    .control + .control { border-left: 1px solid var(--color-linea); padding-left: 1.75rem; }
  }
  .control__titulo { margin-top: 0.85rem; font-size: 1rem; font-weight: 500; }
  .control__texto { margin-top: 0.5rem; font-size: 0.865rem; line-height: 1.55; color: var(--color-tinta-70); }

  .galeria {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
    margin-top: 3.5rem;
  }
  @media (min-width: 768px) { .galeria { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.1rem; } }
  .galeria__pieza { aspect-ratio: 4 / 3; }
  .galeria__pieza::after { display: none; }
  .galeria__pieza--ancha { grid-column: span 2; aspect-ratio: 16 / 9; }

  /* ── Certificaciones ──────────────────────────────────────────────── */
  .certif { padding-block: 5rem; background: var(--color-brand-700); color: #fff; }
  @media (min-width: 1024px) { .certif { padding-block: 8rem; } }
  .certif__lista { display: grid; margin-top: 4rem; border-top: 1px solid rgba(255, 255, 255, 0.16); }
  @media (min-width: 900px) { .certif__lista { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .certif__item { padding: 2.25rem 0; border-bottom: 1px solid rgba(255, 255, 255, 0.16); }
  @media (min-width: 900px) {
    .certif__item { padding: 2.5rem 2.5rem 2.5rem 0; border-bottom: 0; }
    .certif__item + .certif__item { border-left: 1px solid rgba(255, 255, 255, 0.16); padding-left: 2.5rem; }
  }
  .certif__folio { color: rgba(255, 255, 255, 0.4); }
  .certif__sigla {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .certif__nombre { margin-top: 0.75rem; font-size: 0.95rem; color: rgba(255, 255, 255, 0.9); }
  .certif__detalle { margin-top: 1rem; font-size: 0.875rem; line-height: 1.6; color: rgba(255, 255, 255, 0.55); }
  .certif__emisor {
    margin-top: 1.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
  }
</style>

---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Hero from '../components/Hero.astro';
import ProductoCard from '../components/ProductoCard.astro';
import MarcasConstelacion from '../components/MarcasConstelacion.astro';
import { site, certificaciones } from '../data/site';
import { marcas, marcaPorSlug } from '../data/marcas';
import {
  categorias,
  productos,
  productosDestacados,
  productosDeCategoria,
  imagenPrincipal,
  conteoProductos,
} from '../data/catalogo';

const destacados = productosDestacados().slice(0, 5);

// Sumario de especialidades: cada línea con su producto insignia
const insignia: Record<string, string> = {
  bioseguridad: 'contenedores-punzocortantes',
  antisepsia: 'aplicador-clorhexidina-2',
  laparoscopia: 'trocares-desechables',
  aspiracion: 'bolsas-aspiracion',
  'nutricion-enteral': 'bomba-nutricion-enteral',
  'via-aerea': 'videolaringoscopio',
  'higiene-paciente': 'pano-bano-facil',
  absorbentes: 'manta-absorbente-xodus',
  instrumental: 'marcador-piel-esteril',
  'proteccion-personal': 'guantes-nitrilo',
};

const sumario = categorias.map((c, i) => ({
  ...c,
  n: String(i + 1).padStart(2, '0'),
  foto: imagenPrincipal(insignia[c.slug] ?? productosDeCategoria(c.slug)[0]?.slug ?? '', 480),
  firmas: [...new Set(productosDeCategoria(c.slug).map((p) => marcaPorSlug.get(p.marca)?.nombre))]
    .filter(Boolean)
    .slice(0, 2)
    .join(' · '),
}));
---

<Base
  title="Q-MEDICAL S.A.C. — Dispositivos médicos y bioseguridad en el Perú"
  description={site.descripcion}
  preloader
  cabeceraClara
>
  <Hero />

  <!-- ══════════════════════════════ 01 · Sumario de especialidades -->
  <section id="lineas" class="aire bg-[var(--color-papel)]">
    <div class="caja">
      <div class="sumario__intro" data-anim-grupo="80">
        <div>
          <p class="ante ante-brand" data-anim="sube">Especialidades</p>
          <h2 class="display-lg mt-5 max-w-[16ch]" data-anim="sube">
            Diez líneas, ordenadas por la realidad del servicio
          </h2>
        </div>
        <div class="sumario__intro-texto" data-anim="sube">
          <p class="cuerpo-lg">
            Lo que necesita sala de operaciones no es lo que necesita el punto de
            acopio de residuos ni la unidad de nutrición. Por eso el catálogo no
            está ordenado por proveedor, sino por el servicio que lo usa.
          </p>
          <a href="/catalogo" class="enlace mt-7">
            Ver el catálogo completo<Icon name="flecha" size={15} />
          </a>
        </div>
      </div>

      <ol class="sumario" data-anim-grupo="55">
        {sumario.map((c) => (
          <li data-anim="lineas">
            <a href={`/catalogo/${c.slug}`} class="renglon">
              <span class="folio renglon__folio">{c.n}</span>

              <span class="renglon__miniatura">
                <img src={c.foto} width="480" height="480" alt="" loading="lazy" decoding="async" />
              </span>

              <span class="renglon__medio">
                <span class="renglon__titulo">{c.corto}</span>
                <span class="renglon__nota">{c.descripcion}</span>
              </span>

              <span class="renglon__meta">
                <span class="renglon__firmas">{c.firmas}</span>
                <span class="renglon__cuenta">{conteoProductos(c.slug)}</span>
              </span>

              <span class="renglon__flecha"><Icon name="flecha" size={17} /></span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ══════════════════════════════ 02 · El compromiso -->
  <section class="aire bg-[var(--color-papel-2)]">
    <div class="caja">
      <div class="compromiso">
        <div class="compromiso__figura">
          <figure class="lamina compromiso__grande" data-anim="cortina">
            <img
              src="/img/fotos/equipo-almacen-1000.webp"
              srcset="/img/fotos/equipo-almacen-640.webp 640w, /img/fotos/equipo-almacen-1000.webp 1000w, /img/fotos/equipo-almacen-1600.webp 1600w"
              sizes="(min-width: 1024px) 46vw, 92vw"
              width="1000" height="563" loading="lazy" decoding="async"
              alt="Personal de Q-MEDICAL verificando existencias en el almacén central"
              class="parallax" data-parallax="0.1"
            />
          </figure>
          <figure class="lamina compromiso__chica" data-anim="escala">
            <img
              src="/img/fotos/almacen-p1360322-640.webp" width="640" height="480"
              loading="lazy" decoding="async" alt="Pasillo de racks del almacén central"
            />
          </figure>
        </div>

        <div class="compromiso__texto" data-anim-grupo="80">
          <p class="ante ante-brand" data-anim="sube">El compromiso es de nosotros</p>
          <h2 class="display-lg mt-5" data-anim="sube">
            Cada entrega sostiene el trabajo de un equipo de salud
          </h2>
          <div class="cuerpo-lg mt-7" data-anim="sube">
            <p>
              Somos una droguería, no un intermediario. Esa condición cambia lo que
              podemos ofrecer: no solo colocamos un producto, respondemos por su
              conservación, su trazabilidad documental y su ficha técnica frente al
              área usuaria, al comité de compras y a la autoridad sanitaria.
            </p>
            <p>
              Trabajamos para que las instituciones de salud estatales y privadas
              dispongan de productos médicos, de bioseguridad y de protección
              personal de alta calidad, en beneficio del equipo asistencial y de
              los pacientes.
            </p>
          </div>

          <dl class="compromiso__datos" data-anim="sube">
            <div>
              <dt class="ante">Fundación</dt>
              <dd class="compromiso__dato">{site.fundacion}</dd>
            </div>
            <div>
              <dt class="ante">Marcas</dt>
              <dd class="compromiso__dato">{marcas.length}</dd>
            </div>
            <div>
              <dt class="ante">Productos</dt>
              <dd class="compromiso__dato">{productos.length}</dd>
            </div>
          </dl>

          <a href="/nosotros" class="enlace mt-9" data-anim="sube">
            Conocer la empresa<Icon name="flecha" size={15} />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ 03 · La cifra -->
  <section class="cifra-band">
    <div class="caja text-center" data-anim-grupo="110">
      <p class="ante ante-brand" data-anim="sube">Respaldo documental</p>
      <p class="cifra mt-8 text-[var(--color-brand-700)]" data-anim="escala">49</p>
      <h2 class="display-md mx-auto mt-6 max-w-[22ch]" data-anim="sube">
        fichas técnicas oficiales, en PDF y listas para su expediente de licitación
      </h2>
      <p class="cuerpo mx-auto mt-6 max-w-xl" data-anim="sube">
        Cada producto del catálogo publica la documentación del fabricante. El área
        usuaria evalúa, el comité de compras adjunta y la dirección técnica verifica,
        sin tener que pedir nada por correo.
      </p>
      <div class="mt-10 flex flex-wrap justify-center gap-3" data-anim="sube">
        <a href="/fichas-tecnicas" class="pill pill-tinta">
          <Icon name="descarga" size={16} />Ver la biblioteca
        </a>
        <a href="/catalogo" class="pill pill-linea">Explorar el catálogo</a>
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ 04 · Catálogo destacado -->
  <section class="aire bg-[var(--color-papel)]">
    <div class="caja">
      <div class="cabecera-seccion" data-anim-grupo="80">
        <div>
          <p class="ante ante-brand" data-anim="sube">Catálogo</p>
          <h2 class="display-lg mt-5 max-w-[14ch]" data-anim="sube">Piezas que definen la línea</h2>
        </div>
        <a href="/catalogo" class="enlace shrink-0" data-anim="sube">
          Los {productos.length} productos<Icon name="flecha" size={15} />
        </a>
      </div>

      <div class="mt-14" data-anim="sube">
        <ProductoCard producto={destacados[0]} formato="ancha" eager />
      </div>

      <hr class="filete my-14" />

      <div class="rejilla-catalogo" data-anim-grupo="70">
        {destacados.slice(1).map((p) => (
          <div data-anim="sube"><ProductoCard producto={p} /></div>
        ))}
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════ 05 · Certificaciones -->
  <section class="certif">
    <div class="caja">
      <div class="cabecera-seccion" data-anim-grupo="80">
        <div>
          <p class="ante ante-claro" data-anim="sube">Respaldo</p>
          <h2 class="display-lg mt-5 max-w-[16ch]" data-anim="sube">
            Estándares que se auditan, no que se declaran
          </h2>
        </div>
        <p class="certif__nota" data-anim="sube">
          Atendemos instituciones médicas de todas las regiones del país, incluyendo
          procesos de licitación pública y compras corporativas.
        </p>
      </div>

      <ol class="certif__lista" data-anim-grupo="100">
        {certificaciones.map((c, i) => (
          <li class="certif__item" data-anim="sube">
            <span class="folio certif__folio">{String(i + 1).padStart(2, '0')}</span>
            <p class="certif__sigla">{c.sigla}</p>
            <p class="certif__nombre">{c.nombre}</p>
            <p class="certif__detalle">{c.detalle}</p>
            <p class="certif__emisor">{c.emisor}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ══════════════════════════════ 06 · Marcas (anillo, intacto) -->
  <MarcasConstelacion />
</Base>

<style>
  /* ── Sumario de especialidades ────────────────────────────────────── */
  .sumario__intro { display: grid; gap: 2.5rem; }
  @media (min-width: 1024px) {
    .sumario__intro { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 5rem; align-items: end; }
  }
  .sumario__intro-texto { max-width: 34rem; }

  .sumario { margin-top: 4rem; border-top: 1px solid var(--color-linea); }
  .sumario > li { border-bottom: 1px solid var(--color-linea); }

  .renglon {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem 1.25rem;
    padding: 1.35rem 0;
    transition: padding-inline 0.5s var(--ease-salida), background-color 0.4s var(--ease-editorial);
  }
  @media (min-width: 900px) {
    .renglon {
      grid-template-columns: 3rem 5.5rem minmax(0, 1fr) 13rem 2.75rem;
      gap: 2rem;
      padding-block: 1.5rem;
    }
    .renglon:hover { padding-inline: 1.25rem; }
  }
  .renglon:hover { background: rgba(20, 22, 28, 0.025); }

  .renglon__folio { display: none; }
  @media (min-width: 900px) { .renglon__folio { display: block; } }

  .renglon__miniatura {
    display: grid;
    place-items: center;
    width: 3.75rem;
    height: 3.75rem;
    flex: none;
    border-radius: var(--r-sm);
    background: #fff;
    border: 1px solid var(--color-linea);
    overflow: hidden;
  }
  @media (min-width: 900px) { .renglon__miniatura { width: 5.5rem; height: 5.5rem; } }
  .renglon__miniatura img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 14%;
    transition: transform 0.6s var(--ease-salida);
  }
  .renglon:hover .renglon__miniatura img { transform: scale(1.08); }

  .renglon__medio { min-width: 0; }
  .renglon__titulo {
    display: block;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.15rem, 2vw, 1.65rem);
    line-height: 1.15;
    letter-spacing: -0.012em;
  }
  .renglon__nota {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 0.4rem;
    font-size: 0.865rem;
    line-height: 1.5;
    color: var(--color-tinta-70);
  }

  .renglon__meta { display: none; text-align: right; }
  @media (min-width: 900px) { .renglon__meta { display: block; } }
  .renglon__firmas {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-tinta-45);
  }
  .renglon__cuenta { display: block; margin-top: 0.4rem; font-size: 0.82rem; color: var(--color-tinta-70); }

  .renglon__flecha {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    flex: none;
    border: 1px solid var(--color-linea);
    border-radius: 999px;
    color: var(--color-tinta);
    transition: background-color 0.35s, color 0.35s, border-color 0.35s, transform 0.45s var(--ease-salida);
  }
  .renglon:hover .renglon__flecha {
    background: var(--color-brand-700);
    border-color: var(--color-brand-700);
    color: #fff;
    transform: translateX(3px);
  }

  /* ── Compromiso ───────────────────────────────────────────────────── */
  .compromiso { display: grid; gap: 3.5rem; }
  @media (min-width: 1024px) {
    .compromiso { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 5rem; align-items: center; }
  }
  .compromiso__figura { position: relative; }
  .compromiso__grande { aspect-ratio: 4 / 3; }
  .compromiso__grande::after { display: none; }
  .compromiso__grande img { height: 118%; }
  .compromiso__chica {
    width: 46%;
    aspect-ratio: 4 / 3;
    margin: -18% -1rem 0 auto;
    border: 6px solid var(--color-papel-2);
    border-radius: calc(var(--r-lg) + 6px);
  }
  .compromiso__chica::after { display: none; }
  @media (min-width: 1024px) { .compromiso__chica { margin-right: -3rem; } }

  .compromiso__datos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-linea);
  }
  .compromiso__dato {
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    line-height: 1;
    color: var(--color-brand-700);
    font-variant-numeric: lining-nums tabular-nums;
  }

  /* ── Cifra ────────────────────────────────────────────────────────── */
  .cifra-band {
    padding-block: 6rem;
    background: var(--color-papel);
    border-block: 1px solid var(--color-linea);
  }
  @media (min-width: 1024px) { .cifra-band { padding-block: 9rem; } }

  /* ── Cabeceras de sección y rejilla ───────────────────────────────── */
  .cabecera-seccion {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
  }
  .rejilla-catalogo {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 2.5rem 1.75rem;
  }
  @media (min-width: 640px) { .rejilla-catalogo { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .rejilla-catalogo { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  /* ── Certificaciones ──────────────────────────────────────────────── */
  .certif {
    padding-block: 5rem;
    background: var(--color-brand-700);
    color: #fff;
  }
  @media (min-width: 1024px) { .certif { padding-block: 8rem; } }
  .certif__nota {
    max-width: 22rem;
    font-size: 0.95rem;
    line-height: 1.65;
    color: rgba(255, 255, 255, 0.6);
  }
  .certif__lista {
    display: grid;
    margin-top: 4rem;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
  }
  @media (min-width: 900px) { .certif__lista { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  .certif__item { padding: 2.25rem 0; border-bottom: 1px solid rgba(255, 255, 255, 0.16); }
  @media (min-width: 900px) {
    .certif__item { padding: 2.5rem 2.5rem 2.5rem 0; border-bottom: 0; }
    .certif__item + .certif__item { border-left: 1px solid rgba(255, 255, 255, 0.16); padding-left: 2.5rem; }
  }
  .certif__folio { color: rgba(255, 255, 255, 0.4); }
  .certif__sigla {
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2rem, 3.4vw, 2.75rem);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .certif__nombre { margin-top: 0.75rem; font-size: 0.95rem; color: rgba(255, 255, 255, 0.9); }
  .certif__detalle {
    margin-top: 1rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.55);
  }
  .certif__emisor {
    margin-top: 1.5rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.35);
  }
</style>

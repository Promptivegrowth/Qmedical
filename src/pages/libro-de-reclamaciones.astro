---
import Base from '../layouts/Base.astro';
import Portada from '../components/Portada.astro';
import Icon from '../components/Icon.astro';
import FormularioBase from '../components/FormularioBase.astro';
import { site } from '../data/site';

// Hoja de reclamación conforme al Código de Protección y Defensa del Consumidor
// (Ley N.° 29571) y su reglamento del Libro de Reclamaciones (D.S. 011-2011-PCM,
// modificado por el D.S. 006-2014-PCM).
const anio = new Date().getFullYear();

const avisos = [
  { ic: 'reloj', t: 'El proveedor debe dar respuesta al reclamo o queja en un plazo no mayor a <strong>quince (15) días hábiles</strong>, prorrogable por un plazo igual previa comunicación al consumidor.' },
  { ic: 'certificado', t: 'La formulación del reclamo no impide acudir a otras vías de solución de controversias ni es requisito previo para interponer una denuncia ante el <strong>INDECOPI</strong>.' },
  { ic: 'libro', t: 'Conforme al Código de Protección y Defensa del Consumidor, Ley N.° 29571, y al Reglamento del Libro de Reclamaciones aprobado por D.S. N.° 011-2011-PCM y su modificatoria D.S. N.° 006-2014-PCM.' },
  { ic: 'correo', t: 'Conservaremos una copia de su reclamación por dos (2) años. Recibirá el cargo de recepción en el correo electrónico que registre.' },
];
---

<Base
  title="Libro de Reclamaciones"
  description="Libro de Reclamaciones virtual de Q-MEDICAL S.A.C. conforme a la Ley N.° 29571, Código de Protección y Defensa del Consumidor. Registre aquí su reclamo o queja."
>
  <Portada
    ante="Atención al consumidor"
    titulo="Libro de Reclamaciones"
    texto="Conforme a lo establecido en el Código de Protección y Defensa del Consumidor, Q-MEDICAL S.A.C. pone a su disposición este Libro de Reclamaciones virtual."
    migas={[{ nombre: 'Libro de Reclamaciones' }]}
  />

  <section class="aire bg-[var(--color-papel-2)]">
    <div class="caja max-w-4xl">
      <!-- Identificación del proveedor -->
      <div class="hoja">
        <div class="flex flex-wrap items-start justify-between gap-5">
          <div>
            <p class="ante ante-brand">Hoja de reclamación</p>
            <h2 class="display-sm mt-2">Identificación del proveedor</h2>
          </div>
          <img src="/img/logo/qmedical-azul.webp" width="120" height="68"
            alt="Q-MEDICAL S.A.C." class="h-9 w-auto" loading="lazy" />
        </div>

        <dl class="mt-7 grid gap-x-8 gap-y-5 text-[0.9rem] sm:grid-cols-2">
          <div><dt class="ante">Razón social</dt><dd class="mt-1">{site.razonSocial}</dd></div>
          <div><dt class="ante">RUC</dt><dd class="mt-1">{site.ruc}</dd></div>
          <div class="sm:col-span-2"><dt class="ante">Domicilio</dt><dd class="mt-1">{site.direccion.completa}</dd></div>
          <div><dt class="ante">Teléfonos</dt><dd class="mt-1">{site.telefonos.map((t) => t.etiqueta).join(' / ')}</dd></div>
          <div><dt class="ante">Fecha</dt><dd class="mt-1"><span id="fecha-hoy">—</span></dd></div>
        </dl>
      </div>

      <!-- Definiciones -->
      <div class="mt-4 grid gap-4 sm:grid-cols-2">
        <div class="definicion">
          <p class="ante ante-brand">Reclamo</p>
          <p class="mt-2 text-[0.88rem] leading-relaxed text-[var(--color-tinta-70)]">
            Disconformidad relacionada con los productos o servicios que le hemos brindado.
          </p>
        </div>
        <div class="definicion">
          <p class="ante ante-brand">Queja</p>
          <p class="mt-2 text-[0.88rem] leading-relaxed text-[var(--color-tinta-70)]">
            Malestar o descontento respecto a la atención al público, no relacionado con
            los productos o servicios.
          </p>
        </div>
      </div>

      <!-- Formulario -->
      <FormularioBase
        id="form-reclamo"
        asunto="Libro de Reclamaciones — nueva hoja de reclamación"
        destino="direccion_tecnica@qmedicalsac.com"
        class="hoja mt-4"
      >
        <input type="hidden" name="Tipo de registro" value="Libro de Reclamaciones" />

        <fieldset>
          <legend class="display-sm">1. Identificación del consumidor reclamante</legend>
          <div class="mt-6 grid gap-5 sm:grid-cols-2">
            <label class="sm:col-span-2">
              <span class="rotulo">Nombres y apellidos *</span>
              <input type="text" name="Nombres y apellidos" class="campo" required autocomplete="name" />
            </label>
            <label>
              <span class="rotulo">Tipo de documento *</span>
              <select name="Tipo de documento" class="campo" required>
                <option value="DNI">DNI</option>
                <option value="Carné de extranjería">Carné de extranjería</option>
                <option value="Pasaporte">Pasaporte</option>
                <option value="RUC">RUC</option>
              </select>
            </label>
            <label>
              <span class="rotulo">Número de documento *</span>
              <input type="text" name="Número de documento" class="campo" required inputmode="numeric" />
            </label>
            <label class="sm:col-span-2">
              <span class="rotulo">Domicilio *</span>
              <input type="text" name="Domicilio" class="campo" required autocomplete="street-address" />
            </label>
            <label>
              <span class="rotulo">Correo electrónico *</span>
              <input type="email" name="Correo electrónico" class="campo" required autocomplete="email" />
            </label>
            <label>
              <span class="rotulo">Teléfono *</span>
              <input type="tel" name="Teléfono" class="campo" required autocomplete="tel" />
            </label>
            <label class="sm:col-span-2">
              <span class="rotulo">Si es menor de edad, nombre del padre, madre o apoderado</span>
              <input type="text" name="Padre, madre o apoderado" class="campo" />
            </label>
          </div>
        </fieldset>

        <fieldset class="mt-11 border-t border-[var(--color-linea)] pt-9">
          <legend class="display-sm">2. Identificación del bien contratado</legend>
          <div class="mt-6 grid gap-5 sm:grid-cols-2">
            <label>
              <span class="rotulo">Tipo *</span>
              <select name="Tipo de bien" class="campo" required>
                <option value="Producto">Producto</option>
                <option value="Servicio">Servicio</option>
              </select>
            </label>
            <label>
              <span class="rotulo">Monto reclamado (S/)</span>
              <input type="text" name="Monto reclamado" class="campo" inputmode="decimal" placeholder="Opcional" />
            </label>
            <label class="sm:col-span-2">
              <span class="rotulo">Descripción del producto o servicio *</span>
              <textarea name="Descripción del bien" rows="3" class="campo resize-y" required
                placeholder="Indique el producto, código, número de guía o factura, y la fecha de la operación."></textarea>
            </label>
          </div>
        </fieldset>

        <fieldset class="mt-11 border-t border-[var(--color-linea)] pt-9">
          <legend class="display-sm">3. Detalle de la reclamación y pedido</legend>
          <div class="mt-6 space-y-5">
            <div>
              <span class="rotulo">Tipo de registro *</span>
              <div class="mt-2 flex flex-wrap gap-3">
                <label class="opcion">
                  <input type="radio" name="Tipo de reclamación" value="Reclamo" required class="h-4 w-4 accent-[#152e7f]" />
                  Reclamo
                </label>
                <label class="opcion">
                  <input type="radio" name="Tipo de reclamación" value="Queja" class="h-4 w-4 accent-[#152e7f]" />
                  Queja
                </label>
              </div>
            </div>

            <label class="block">
              <span class="rotulo">Detalle *</span>
              <textarea name="Detalle de la reclamación" rows="6" class="campo resize-y" required
                placeholder="Describa los hechos con el mayor detalle posible."></textarea>
            </label>

            <label class="block">
              <span class="rotulo">Pedido del consumidor *</span>
              <textarea name="Pedido del consumidor" rows="4" class="campo resize-y" required
                placeholder="Indique qué solución solicita."></textarea>
            </label>

            <label class="flex items-start gap-3">
              <input type="checkbox" name="Declaración de veracidad" value="Sí, declaro que la información es veraz"
                required class="mt-1 h-4 w-4 shrink-0 accent-[#152e7f]" />
              <span class="text-[0.83rem] leading-relaxed text-[var(--color-tinta-70)]">
                Declaro que la información consignada es veraz y autorizo a {site.razonSocial}
                a tratar mis datos personales con la finalidad de atender esta reclamación,
                conforme a la Ley N.° 29733. *
              </span>
            </label>
          </div>
        </fieldset>

        <button type="submit" class="pill pill-tinta mt-9 w-full sm:w-auto">
          <Icon name="libro" size={16} />Registrar reclamación
        </button>
      </FormularioBase>

      <!-- Avisos legales -->
      <ul class="avisos">
        {avisos.map((a) => (
          <li>
            <Icon name={a.ic} size={17} class="mt-0.5 shrink-0 text-[var(--color-brand-700)]" />
            <span set:html={a.t} />
          </li>
        ))}
      </ul>

      <p class="mt-6 text-center text-[0.78rem] text-[var(--color-tinta-45)]">
        © {anio} {site.razonSocial} — RUC {site.ruc}
      </p>
    </div>
  </section>
</Base>

<style>
  .hoja {
    padding: 1.75rem;
    background: #fff;
    border: 1px solid var(--color-linea);
    border-radius: var(--r-lg);
  }
  @media (min-width: 640px) { .hoja { padding: 2.5rem; } }

  .definicion {
    padding: 1.25rem 1.5rem;
    background: #fff;
    border: 1px solid var(--color-linea);
    border-radius: var(--r-md);
  }

  .opcion {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.1rem;
    border: 1px solid var(--color-linea);
    border-radius: var(--r-sm);
    font-size: 0.92rem;
    cursor: pointer;
    transition: border-color 0.25s, background-color 0.25s;
  }
  .opcion:has(:checked) { border-color: var(--color-brand-700); background: var(--color-brand-50); }

  .avisos {
    display: grid;
    gap: 1.1rem;
    margin-top: 1rem;
    padding: 1.75rem;
    background: var(--color-papel);
    border: 1px solid var(--color-linea);
    border-radius: var(--r-lg);
    font-size: 0.87rem;
    line-height: 1.6;
    color: var(--color-tinta-70);
  }
  @media (min-width: 640px) { .avisos { padding: 2.25rem; } }
  .avisos li { display: flex; gap: 0.85rem; }
  .avisos strong { color: var(--color-tinta); font-weight: 600; }
</style>

<script>
  const el = document.getElementById('fecha-hoy');
  if (el) {
    el.textContent = new Intl.DateTimeFormat('es-PE', {
      dateStyle: 'long',
      timeZone: 'America/Lima',
    }).format(new Date());
  }
</script>

---
// Ficha de producto, en castellano.
import FichaProducto from '../../plantillas/FichaProducto.astro';
import { productoPorSlug } from '../../data/catalogo';

const producto = productoPorSlug.get(Astro.params.slug!);
if (!producto) return Astro.rewrite('/404');
---

<FichaProducto lang="es" producto={producto} />

---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ProductoCard from '../../components/ProductoCard.astro';
import CtaContacto from '../../components/CtaContacto.astro';
import { site, waMensajes } from '../../data/site';
import { marcaPorSlug } from '../../data/marcas';
import {
  productos,
  categoriaPorSlug,
  imagenesDe,
  fichasDe,
  fichasIndex,
  productosDeCategoria,
  type Producto,
} from '../../data/catalogo';

export function getStaticPaths() {
  return productos.map((p) => ({ params: { slug: p.slug }, props: { producto: p } }));
}

interface Props {
  producto: Producto;
}
const { producto: p } = Astro.props;

const cat = categoriaPorSlug.get(p.categoria)!;
const marca = marcaPorSlug.get(p.marca);
const imgs = imagenesDe(p.slug);
const fichas = fichasDe(p.slug);
const relacionados = productosDeCategoria(p.categoria)
  .filter((o) => o.slug !== p.slug)
  .slice(0, 4);

const asunto = encodeURIComponent(`Cotización — ${p.nombre}`);
const cuerpo = encodeURIComponent(
  `Buen día,\n\nSolicito cotización del siguiente producto:\n\n` +
    `Producto: ${p.nombre}\n` +
    (marca ? `Marca: ${marca.nombre}\n` : '') +
    `Ficha: ${site.url}/productos/${p.slug}\n\n` +
    `Cantidad requerida: \nInstitución: \nContacto: \n\nGracias.`
);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: p.nombre,
    description: p.resumen,
    image: imgs.map((i) => `${site.url}/img/${i}`),
    brand: { '@type': 'Brand', name: marca?.nombre ?? 'Q-MEDICAL' },
    category: cat.nombre,
    url: `${site.url}/productos/${p.slug}`,
    ...(p.variantes?.length ? { model: p.variantes.map((v) => v.codigo) } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: site.url },
      { '@type': 'ListItem', position: 2, name: 'Catálogo', item: `${site.url}/catalogo` },
      { '@type': 'ListItem', position: 3, name: cat.corto, item: `${site.url}/catalogo/${cat.slug}` },
      { '@type': 'ListItem', position: 4, name: p.nombre },
    ],
  },
];
---

<Base
  title={p.nombre}
  description={`${p.resumen} ${marca ? 'Marca ' + marca.nombre + '.' : ''} Ficha técnica descargable y cotización para instituciones de salud del Perú.`}
  image={imgs[0] ? `/img/${imgs[0]}` : undefined}
  schema={schema}
>
  <!-- Ruta -->
  <nav aria-label="Ruta de navegación" class="border-b border-line bg-white">
    <div class="container-q py-4">
      <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-[0.76rem] text-muted">
        <li><a href="/" class="transition hover:text-brand-700">Inicio</a></li>
        <li aria-hidden="true"><Icon name="chevron" size={11} class="opacity-40" /></li>
        <li><a href="/catalogo" class="transition hover:text-brand-700">Catálogo</a></li>
        <li aria-hidden="true"><Icon name="chevron" size={11} class="opacity-40" /></li>
        <li>
          <a href={`/catalogo/${cat.slug}`} class="transition hover:text-brand-700">{cat.corto}</a>
        </li>
        <li aria-hidden="true"><Icon name="chevron" size={11} class="opacity-40" /></li>
        <li class="text-ink">{p.nombre}</li>
      </ol>
    </div>
  </nav>

  <!-- Ficha del producto -->
  <section class="bg-white pb-16 pt-10 lg:pb-20 lg:pt-14">
    <div class="container-q grid gap-12 lg:grid-cols-2 lg:gap-16">
      <!-- Galería -->
      <div class="min-w-0">
        <div class="overflow-hidden rounded-2xl border border-line bg-white">
          <img
            id="img-principal"
            src={`/img/${imgs[0]}`}
            width="900"
            height="900"
            alt={p.nombre}
            fetchpriority="high"
            decoding="async"
            class="aspect-square w-full object-contain p-8 sm:p-12"
          />
        </div>

        {
          imgs.length > 1 && (
            <ul
              id="miniaturas"
              class="no-scrollbar mt-4 flex gap-3 overflow-x-auto pb-1"
              role="listbox"
              aria-label="Imágenes del producto"
            >
              {imgs.map((src, i) => (
                <li class="shrink-0">
                  <button
                    type="button"
                    class:list={['thumb', i === 0 && 'is-active']}
                    data-src={`/img/${src}`}
                    aria-label={`Ver imagen ${i + 1} de ${imgs.length}`}
                    aria-selected={i === 0 ? 'true' : 'false'}
                    role="option"
                  >
                    <img
                      src={`/img/${src.replace('.webp', '-480.webp')}`}
                      width="480"
                      height="480"
                      alt=""
                      loading="lazy"
                      decoding="async"
                      class="h-full w-full object-contain p-2"
                    />
                  </button>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      <!-- Datos -->
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2.5">
          {
            marca && (
              <a
                href={`/marcas#${marca.slug}`}
                class="inline-flex items-center gap-2 rounded-full bg-brand-50 px-3.5 py-1.5 text-[0.72rem] font-semibold uppercase tracking-wider text-brand-700 transition hover:bg-brand-100"
              >
                {marca.nombre}
              </a>
            )
          }
          <a
            href={`/catalogo/${cat.slug}`}
            class="inline-flex items-center gap-1.5 rounded-full border border-line px-3.5 py-1.5 text-[0.72rem] font-medium text-muted transition hover:border-brand-300 hover:text-brand-700"
          >
            <Icon name={cat.icono} size={13} />
            {cat.corto}
          </a>
        </div>

        <h1 class="title-lg mt-5">{p.nombre}</h1>
        <p class="prose-q mt-5 !text-[1.05rem]">{p.resumen}</p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href={`/contacto?producto=${p.slug}#cotizar`} class="btn btn-primary">
            Solicitar cotización
            <Icon name="arrow" size={16} />
          </a>
          {
            fichas.length > 0 && (
              <a href="#fichas" class="btn btn-outline">
                <Icon name="download" size={16} />
                {fichas.length === 1 ? 'Descargar ficha técnica' : `Fichas técnicas (${fichas.length})`}
              </a>
            )
          }
        </div>

        <p class="mt-4 text-[0.8rem] text-muted">
          ¿Prefiere el correo?
          <a
            href={`mailto:${site.correoPrincipal}?subject=${asunto}&body=${cuerpo}`}
            class="text-brand-700 underline underline-offset-4"
          >
            Escríbanos con este producto precargado
          </a>
        </p>

        <!-- Descripción -->
        <div class="prose-q mt-10 border-t border-line pt-9">
          {p.descripcion.map((d) => <p>{d}</p>)}
        </div>

        {
          p.presentacion && (
            <div class="mt-8 rounded-xl border border-line bg-surface p-5">
              <p class="text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-muted">
                Presentación
              </p>
              <p class="mt-2 text-[0.9rem] leading-relaxed text-ink/85">{p.presentacion}</p>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- Características, variantes y usos -->
  <section class="border-t border-line bg-surface py-16 lg:py-20">
    <div class="container-q grid gap-12 lg:grid-cols-12 lg:gap-14">
      <div class="min-w-0 lg:col-span-7">
        <h2 class="title-md">Características técnicas</h2>
        <ul class="mt-7 grid gap-x-8 gap-y-3.5 sm:grid-cols-2">
          {
            p.caracteristicas.map((c) => (
              <li class="flex gap-3 text-[0.9rem] leading-relaxed">
                <Icon name="check" size={16} class="mt-1 shrink-0 text-brand-700" />
                <span class="text-ink/85">{c}</span>
              </li>
            ))
          }
        </ul>

        {
          p.usos && (
            <div class="mt-11">
              <h2 class="title-md">Aplicaciones</h2>
              <ul class="mt-6 flex flex-wrap gap-2.5">
                {p.usos.map((u) => (
                  <li class="rounded-full border border-line bg-white px-4 py-2 text-[0.84rem] text-ink/80">
                    {u}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
      </div>

      {
        p.variantes && (
          <div class="min-w-0 lg:col-span-5">
            <h2 class="title-md">Presentaciones y códigos</h2>
            <div class="mt-7 overflow-x-auto rounded-xl border border-line bg-white">
              <table class="w-full min-w-[19rem] text-left text-[0.86rem]">
                <thead>
                  <tr class="border-b border-line bg-surface/70 text-[0.68rem] uppercase tracking-[0.12em] text-muted">
                    <th scope="col" class="px-5 py-3 font-semibold">Código</th>
                    <th scope="col" class="px-5 py-3 font-semibold">Detalle</th>
                    {fichas.length > 1 && <th scope="col" class="px-5 py-3 font-semibold">Ficha</th>}
                  </tr>
                </thead>
                <tbody class="divide-y divide-line">
                  {p.variantes.map((v) => (
                    <tr class="align-top">
                      <th scope="row" class="whitespace-nowrap px-5 py-3.5 font-semibold text-brand-700">
                        {v.codigo}
                      </th>
                      <td class="px-5 py-3.5 leading-relaxed text-ink/80">{v.detalle}</td>
                      {fichas.length > 1 && (
                        <td class="px-5 py-3.5">
                          {v.ficha && fichasIndex[v.ficha] ? (
                            <a
                              href={fichasIndex[v.ficha].archivo}
                              download
                              class="inline-flex items-center gap-1 text-brand-700 hover:underline"
                              aria-label={`Descargar ficha técnica ${v.codigo}`}
                            >
                              <Icon name="pdf" size={14} />
                              PDF
                            </a>
                          ) : (
                            <span class="text-muted/60">—</span>
                          )}
                        </td>
                      )}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <!-- Fichas técnicas -->
  {
    fichas.length > 0 && (
      <section id="fichas" class="scroll-mt-24 bg-white py-16 lg:py-20">
        <div class="container-q">
          <div class="flex flex-wrap items-end justify-between gap-5">
            <div>
              <p class="eyebrow">Documentación</p>
              <h2 class="title-md mt-3">Fichas técnicas descargables</h2>
              <p class="prose-q mt-3 max-w-2xl">
                Documentación oficial del producto en PDF, lista para adjuntar a un
                requerimiento interno o a un expediente de licitación.
              </p>
            </div>
          </div>

          <ul class="mt-9 grid gap-3 md:grid-cols-2">
            {fichas.map((f) => (
              <li>
                <a
                  href={f.archivo}
                  download
                  class="card group flex items-center gap-4 p-5"
                >
                  <span class="grid h-11 w-11 shrink-0 place-items-center rounded-lg bg-brand-50 text-brand-700 transition group-hover:bg-brand-700 group-hover:text-white">
                    <Icon name="pdf" size={20} />
                  </span>
                  <span class="min-w-0 flex-1">
                    <span class="block text-[0.9rem] font-medium leading-snug text-ink">
                      {f.titulo}
                    </span>
                    <span class="mt-0.5 block text-[0.76rem] text-muted">PDF · {f.peso} KB</span>
                  </span>
                  <Icon
                    name="download"
                    size={18}
                    class="shrink-0 text-muted transition group-hover:text-brand-700"
                  />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <!-- Relacionados -->
  {
    relacionados.length > 0 && (
      <section class="border-t border-line bg-surface py-16 lg:py-20">
        <div class="container-q">
          <div class="flex flex-wrap items-end justify-between gap-5">
            <h2 class="title-md">También en {cat.corto.toLowerCase()}</h2>
            <a
              href={`/catalogo/${cat.slug}`}
              class="inline-flex items-center gap-2 text-[0.85rem] font-semibold text-brand-700"
            >
              Ver la línea completa
              <Icon name="arrow" size={15} />
            </a>
          </div>
          <div
            class:list={[
              'mt-8 grid gap-5 sm:grid-cols-2',
              relacionados.length >= 4 && 'lg:grid-cols-4',
              relacionados.length === 3 && 'lg:grid-cols-3',
              relacionados.length <= 2 && 'lg:max-w-2xl',
            ]}
          >
            {relacionados.map((o) => (
              <ProductoCard producto={o} mostrarCategoria={false} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaContacto
    titulo={`¿Necesita cotizar ${p.nombre}?`}
    texto="Indíquenos la cantidad y la institución de destino. Le respondemos con precio, disponibilidad, tiempo de entrega y la documentación técnica que requiera su expediente."
    waMensaje={waMensajes.producto(p.nombre, p.variantes?.[0]?.codigo)}
  />
</Base>

<style>
  .thumb {
    display: block;
    width: 4.75rem;
    height: 4.75rem;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--color-line);
    border-radius: 0.6rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .thumb:hover { border-color: var(--color-brand-300); }
  .thumb.is-active {
    border-color: var(--color-brand-700);
    box-shadow: 0 0 0 1px var(--color-brand-700);
  }
</style>

<script>
  const principal = document.getElementById('img-principal') as HTMLImageElement | null;
  const lista = document.getElementById('miniaturas');

  lista?.addEventListener('click', (ev) => {
    const boton = (ev.target as HTMLElement).closest<HTMLButtonElement>('.thumb');
    if (!boton || !principal) return;
    principal.src = boton.dataset.src ?? principal.src;
    lista.querySelectorAll('.thumb').forEach((b) => {
      const activo = b === boton;
      b.classList.toggle('is-active', activo);
      b.setAttribute('aria-selected', String(activo));
    });
  });
</script>

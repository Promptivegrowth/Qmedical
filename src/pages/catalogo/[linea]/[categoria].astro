---
// Una categoría del catálogo, dentro de su línea. En castellano.
import LineaCatalogo from '../../../plantillas/LineaCatalogo.astro';
import { categoriaPorSlug } from '../../../data/catalogo';

/* La direccion lleva la linea y la categoria. Se comprueban las dos: una
   categoria pedida bajo una linea que no es la suya es una direccion que no
   existe, no una pagina valida con una miga de pan equivocada. */
const categoria = categoriaPorSlug.get(Astro.params.categoria!);
if (!categoria || categoria.linea !== Astro.params.linea) return Astro.rewrite('/404');
---

<LineaCatalogo lang="es" categoria={categoria} />

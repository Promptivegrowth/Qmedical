---
import Base from '../../layouts/Base.astro';
import Portada from '../../components/Portada.astro';
import Icon from '../../components/Icon.astro';
import ProductoCard from '../../components/ProductoCard.astro';
import CtaContacto from '../../components/CtaContacto.astro';
import {
  categorias,
  productosDeCategoria,
  conteoProductos,
  imagenPrincipal,
  type Categoria,
} from '../../data/catalogo';
import { marcaPorSlug } from '../../data/marcas';
import { site, waMensajes } from '../../data/site';

export function getStaticPaths() {
  return categorias.map((c) => ({ params: { categoria: c.slug }, props: { categoria: c } }));
}

interface Props {
  categoria: Categoria;
}
const { categoria } = Astro.props;
const items = productosDeCategoria(categoria.slug);
const otras = categorias.filter((c) => c.slug !== categoria.slug);
const firmas = [...new Set(items.map((p) => marcaPorSlug.get(p.marca)?.nombre))].filter(Boolean) as string[];
const nFichas = new Set(items.flatMap((p) => p.fichas)).size;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: site.url },
    { '@type': 'ListItem', position: 2, name: 'Catálogo', item: `${site.url}/catalogo` },
    { '@type': 'ListItem', position: 3, name: categoria.nombre },
  ],
};
---

<Base title={categoria.nombre} description={categoria.descripcion} schema={schema}>
  <Portada
    ante="Línea de producto"
    titulo={categoria.nombre}
    texto={categoria.descripcion}
    migas={[{ nombre: 'Catálogo', href: '/catalogo' }, { nombre: categoria.corto }]}
    foto={imagenPrincipal(items[0]?.slug ?? '', 900)}
    dato={{ valor: String(items.length), etiqueta: items.length === 1 ? 'producto' : 'productos' }}
  />

  <!-- Cintillo de datos de la línea -->
  <section class="bg-[var(--color-papel)] border-b border-[var(--color-linea)]">
    <div class="caja">
      <dl class="datos-linea">
        <div>
          <dt class="ante">Marcas</dt>
          <dd>{firmas.join(' · ')}</dd>
        </div>
        <div>
          <dt class="ante">Fichas técnicas</dt>
          <dd>{nFichas} documento{nFichas === 1 ? '' : 's'} en PDF</dd>
        </div>
        <div>
          <dt class="ante">Cobertura</dt>
          <dd>Todas las regiones del Perú</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="aire bg-[var(--color-papel-2)]">
    <div class="caja">
      <p class="ante ante-brand">{conteoProductos(categoria.slug)} en esta línea</p>

      <div class="rejilla-linea mt-9" data-anim-grupo="60">
        {items.map((p, i) => (
          <div data-anim="sube"><ProductoCard producto={p} eager={i < 4} mostrarCategoria={false} /></div>
        ))}
      </div>
    </div>
  </section>

  <!-- Navegación entre líneas -->
  <section class="aire-sm bg-[var(--color-papel)]">
    <div class="caja">
      <h2 class="display-md">Otras líneas del catálogo</h2>
      <ul class="otras" data-anim-grupo="40">
        {otras.map((c) => (
          <li data-anim="sube">
            <a href={`/catalogo/${c.slug}`} class="otra">
              <Icon name={c.icono} size={18} class="shrink-0 text-[var(--color-brand-700)]" />
              <span class="min-w-0">
                <span class="block truncate">{c.corto}</span>
                <span class="block text-[0.74rem] text-[var(--color-tinta-45)]">{conteoProductos(c.slug)}</span>
              </span>
              <Icon name="flecha" size={15} class="ml-auto shrink-0 opacity-30" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaContacto
    titulo={`¿Necesita cotizar ${categoria.corto.toLowerCase()}?`}
    waMensaje={waMensajes.linea(categoria.corto)}
  />
</Base>

<style>
  .datos-linea {
    display: grid;
    gap: 1.75rem;
    padding-block: 2.25rem;
  }
  @media (min-width: 768px) {
    .datos-linea { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 3rem; }
  }
  .datos-linea dd { margin-top: 0.5rem; font-size: 0.95rem; color: var(--color-tinta); }

  .rejilla-linea {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 2.5rem 1.75rem;
  }
  @media (min-width: 640px) { .rejilla-linea { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .rejilla-linea { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 1400px) { .rejilla-linea { grid-template-columns: repeat(4, minmax(0, 1fr)); } }

  .otras {
    display: grid;
    grid-template-columns: repeat(1, minmax(0, 1fr));
    gap: 0.6rem;
    margin-top: 2rem;
  }
  @media (min-width: 640px) { .otras { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1024px) { .otras { grid-template-columns: repeat(3, minmax(0, 1fr)); } }

  .otra {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.95rem 1.1rem;
    background: #fff;
    border: 1px solid var(--color-linea);
    border-radius: var(--r-sm);
    font-size: 0.92rem;
    transition: border-color 0.3s, transform 0.4s var(--ease-salida);
  }
  .otra:hover { border-color: var(--color-brand-300); transform: translateX(3px); }
</style>
